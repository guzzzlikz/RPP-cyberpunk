<rml>
<head>
    <title>Open//77 freeroam roster</title>
    <link type="text/rcss" href="open77-yellow.rcss"/>
    <link type="text/rcss" href="scoreboard.rcss"/>
</head>
<body>
<div id="root">
<!-- the roster slides in from the left edge, turned toward the centre of the screen -->
<div id="board">
    <div id="edge"></div>
    <div id="head">
        <div class="head-left">
            <span class="kicker">// ИГРОКИ НА СЕРВЕРЕ</span>
            <div class="title-line"><span class="title">ИГРОКИ</span><span id="count" class="count">0</span></div>
        </div>
        <span class="grow"></span>
        <div class="hold"><span class="key">TAB</span><span>УДЕРЖИВАЙТЕ</span></div>
    </div>
    <div id="stats">
        <div class="stat"><span class="stat-dot near"></span><span id="st-near" class="stat-num">0</span><span class="stat-label">РЯДОМ</span></div>
        <div class="stat"><span class="stat-dot streamed"></span><span id="st-streamed" class="stat-num">0</span><span class="stat-label">В ЗОНЕ</span></div>
        <div class="stat"><span class="stat-dot far"></span><span id="st-far" class="stat-num">0</span><span class="stat-label">В ГОРОДЕ</span></div>
    </div>
    <div id="cols">
        <span class="c-rank">#</span>
        <span class="c-name">ИГРОК</span>
        <span class="c-id">ID</span>
        <span class="c-dist">ДИСТАНЦИЯ</span>
    </div>
    <div id="rows"></div>
    <div id="empty"><span id="empty-text">ЖДЁМ СПИСОК ИГРОКОВ ОТ СЕРВЕРА</span></div>
    <div id="foot">
        <span id="more"></span>
        <span class="grow"></span>
        <span class="sorted">ПО РАССТОЯНИЮ</span>
    </div>
</div>
</div>
</body>
</rml>
