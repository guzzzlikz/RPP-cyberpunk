/* Freeroam roster (TAB) on NativeUI: a glass board that slides in from the left edge and
   stays turned toward the centre of the screen. 1 dp = 1 px at 1080p. */

body { pointer-events: none; }
#root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; perspective: 1400dp; perspective-origin: 50% 45%; visibility: hidden; font-family: Rajdhani; font-weight: bold; color: #e9edf1; }
#root.shown { visibility: visible; }
.grow { flex: 1 1 auto; }

/* ---- the board: out to the left and folded when closed, turned 16deg when open ------- */
#board
{
    position: absolute; left: 44dp; top: 150dp; width: 540dp;
    padding: 18dp 0 12dp 0;
    backdrop-filter: blur(18dp) saturate(1.3) brightness(0.85);
    decorator: linear-gradient(160deg, #141a24d0 0%, #0b0f16b8 55%, #090c12c8 100%);
    border-width: 1dp; border-color: #ffffff1c;
    box-shadow: #00000080 0 24dp 60dp 0, #22d8e214 0 0 0 1dp;
    transform-origin: 0% 50%;
    transform: translateX(-620dp) rotateY(58deg);
    opacity: 0;
    transition: transform opacity 0.2s cubic-in;
}
#root.open #board { transform: translateX(0dp) rotateY(16deg); opacity: 1; transition: transform 0.46s back-out, opacity 0.24s cubic-out; }

/* the lit spine on the left edge, and a sheen along the top */
#edge { position: absolute; left: -1dp; top: -1dp; bottom: -1dp; width: 3dp; decorator: linear-gradient(180deg, #22d8e2ff 0%, #22d8e299 45%, #7c5cff66 100%); box-shadow: #22d8e255 0 0 18dp 0; }

/* ---- header ------------------------------------------------------------------------- */
#head { display: flex; flex-direction: row; align-items: flex-end; padding: 0 22dp 0 24dp; }
.head-left { display: block; }
.kicker { display: block; font-family: "Chakra Petch"; font-size: 10dp; letter-spacing: 0.32em; color: #22d8e2; margin-bottom: 2dp; }
.title-line { display: flex; flex-direction: row; align-items: flex-end; }
.title { font-family: "Zen Dots"; font-weight: normal; font-size: 30dp; line-height: 32dp; letter-spacing: 0.04em; color: #f6f8fa; }
.count { font-family: "Roboto Mono"; font-weight: bold; font-size: 15dp; line-height: 18dp; color: #05262a; background-color: #22d8e2; padding: 2dp 8dp; margin-left: 12dp; margin-bottom: 5dp; }
.hold { display: flex; flex-direction: row; align-items: center; font-family: "Chakra Petch"; font-size: 10dp; letter-spacing: 0.24em; color: #7d8794; margin-bottom: 6dp; }
.key { font-family: "Roboto Mono"; font-weight: normal; font-size: 10dp; letter-spacing: 0.08em; color: #22d8e2; border-width: 1dp; border-color: #22d8e266; background-color: #22d8e212; padding: 1dp 6dp; margin-right: 7dp; }

/* ---- the three counts --------------------------------------------------------------- */
#stats { display: flex; flex-direction: row; margin: 14dp 22dp 0 24dp; padding: 9dp 0; border-top-width: 1dp; border-bottom-width: 1dp; border-color: #ffffff12; }
.stat { display: flex; flex-direction: row; align-items: center; margin-right: 22dp; }
.stat-dot { width: 6dp; height: 6dp; border-radius: 3dp; margin-right: 7dp; }
.stat-dot.near { background-color: #2be58b; box-shadow: #2be58b88 0 0 8dp 0; }
.stat-dot.streamed { background-color: #22d8e2; }
.stat-dot.far { background-color: #56606e; }
.stat-num { font-family: "Roboto Mono"; font-size: 14dp; color: #f6f8fa; margin-right: 6dp; }
.stat-label { font-family: "Chakra Petch"; font-size: 9dp; letter-spacing: 0.24em; color: #7d8794; }

/* ---- columns and rows --------------------------------------------------------------- */
#cols { display: flex; flex-direction: row; align-items: center; margin: 10dp 22dp 4dp 24dp; font-family: "Chakra Petch"; font-size: 9dp; letter-spacing: 0.26em; color: #5c6674; }
.c-rank { width: 30dp; }
.c-name { flex: 1 1 auto; padding-left: 44dp; }
.c-id { width: 60dp; text-align: right; }
.c-dist { width: 118dp; text-align: right; }

#rows { display: block; margin: 0 14dp 0 16dp; }
.row
{
    display: flex; flex-direction: row; align-items: center;
    height: 40dp; padding: 0 8dp; margin-bottom: 2dp;
    background-color: #ffffff07;
    border-left-width: 2dp; border-left-color: #ffffff10;
}
.row.enter { opacity: 0; transform: translateX(-34dp); }
#rows.in .row.enter { opacity: 1; transform: translateX(0dp); }

.rank { width: 30dp; font-family: "Roboto Mono"; font-weight: normal; font-size: 11dp; color: #56606e; }
.avatar
{
    width: 30dp; height: 30dp; margin-right: 12dp; flex: 0 0 auto;
    font-family: "Chakra Petch"; font-size: 12dp; line-height: 30dp; text-align: center; letter-spacing: 0.04em;
    border-width: 1dp; background-color: #0a0e14;
}
.who { flex: 1 1 auto; display: block; overflow: hidden; }
.name { display: block; font-size: 17dp; line-height: 19dp; color: #e9edf1; white-space: nowrap; overflow: hidden; }
.crew { font-family: "Chakra Petch"; font-size: 9dp; letter-spacing: 0.18em; color: #7d8794; display: block; line-height: 12dp; }
.pid { width: 60dp; text-align: right; font-family: "Roboto Mono"; font-weight: normal; font-size: 12dp; color: #7d8794; }
.dist { width: 118dp; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; }
.dist-bar { width: 38dp; height: 3dp; margin-right: 9dp; background-color: #ffffff14; }
.dist-fill { height: 3dp; background-color: #22d8e2; }
.dist-text { font-family: "Roboto Mono"; font-weight: normal; font-size: 12dp; color: #c9d1da; min-width: 56dp; text-align: right; }

/* near (25 m), out of range, and the local player */
.row.near { border-left-color: #2be58b; }
.row.near .dist-fill { background-color: #2be58b; }
.row.near .dist-text { color: #2be58b; }
.row.far .name { color: #aab3be; }
.row.far .dist-text { color: #56606e; }
.row.self { background-color: #22d8e21c; border-left-color: #22d8e2; decorator: linear-gradient(90deg, #22d8e22c 0%, #22d8e208 70%, #22d8e200 100%); }
.row.self .name { color: #ffffff; }
.you { font-family: "Chakra Petch"; font-size: 10dp; letter-spacing: 0.22em; color: #05262a; background-color: #22d8e2; padding: 2dp 8dp; }

/* ---- empty and foot ------------------------------------------------------------------ */
#empty { display: none; margin: 18dp 24dp 8dp 24dp; padding: 16dp 0; text-align: center; font-family: "Chakra Petch"; font-size: 11dp; letter-spacing: 0.24em; color: #5c6674; border-width: 1dp; border-color: #ffffff10; }
#root.empty #empty { display: block; }
#foot { display: flex; flex-direction: row; align-items: center; margin: 10dp 22dp 0 24dp; font-family: "Chakra Petch"; font-size: 9dp; letter-spacing: 0.24em; color: #56606e; }
#more { color: #22d8e2; }
