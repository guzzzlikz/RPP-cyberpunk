/* OPEN//77 pause menu on NativeUI: structure and neutral colours. Every rule that uses the
   accent lives in client/ui.lua (ACCENT_RCSS), applied as a live stylesheet so a server's
   Open77.pauseMenu.setAccentColor repaints the menu without a reload. 1 dp = 1 px at 1080p.

   Glass all the way down: the world behind is frosted by the scrim, the panel frosts it
   again; chamfers (top-right / bottom-left), hairlines, tracked uppercase labels. */

body { pointer-events: none; }
#root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; visibility: hidden; font-family: Rajdhani; color: #e9e9e9; }
#root.shown { visibility: visible; pointer-events: auto; }
.grow { flex: 1 1 auto; }
.mark { font-family: "Chakra Petch"; font-weight: bold; margin-right: 8dp; }

/* ---- the world behind ---------------------------------------------------------------- */
#scrim
{
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    backdrop-filter: blur(16dp) saturate(1.25) brightness(0.78);
    decorator: linear-gradient(90deg, #080808d6 0%, #0808089c 34%, #0808084a 70%, #08080826 100%);
    opacity: 0;
}
#aura { position: absolute; left: 0; top: 0; width: 70%; height: 100%; opacity: 0; pointer-events: none; }

/* ---- the panel ------------------------------------------------------------------------ */
#panel
{
    position: absolute; left: 0; top: 0; bottom: 0; width: 620dp;
    padding: 44dp 46dp 30dp 50dp;
    display: flex; flex-direction: column;
    box-shadow: #000000cc 30dp 0 90dp -10dp;
}
#panel-glass
{
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    backdrop-filter: blur(30dp) saturate(1.35) brightness(0.9);
    decorator: linear-gradient(180deg, #1b1b19b3 0%, #131211c2 46%, #0e0e0dd4 100%);
}
#panel-edge { position: absolute; left: 0; top: 0; right: 0; height: 3dp; }
#panel-spine { position: absolute; top: 0; bottom: 0; right: 0; width: 1dp; }
#panel-scan
{
    position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0.35;
    decorator: repeating-linear-gradient(180deg, #ffffff00 0dp, #ffffff00 3dp, #ffffff05 3dp, #ffffff05 4dp);
}
.page { position: relative; display: none; flex-direction: column; flex: 1 1 auto; min-height: 0; }
#root.p-main #page-main, #root.p-confirm #page-confirm { display: flex; }
#root.p-settings #page-settings { display: flex; flex-direction: row; }

/* ---- masthead ------------------------------------------------------------------------- */
#mast { display: flex; flex-direction: row; align-items: center; height: 46dp; margin-bottom: 30dp; }
#wordmark img, #rail-wordmark img { width: 254dp; height: 40dp; }
#brand-sep { display: none; width: 1dp; height: 36dp; margin: 0 18dp; background-color: #97979557; }
#brand { display: none; height: 46dp; max-width: 190dp; }
#brand img { height: 46dp; }
#root.branded #brand-sep, #root.branded #brand { display: block; }
#chip { display: flex; flex-direction: row; align-items: center; padding: 6dp 11dp; font-family: "Chakra Petch"; font-weight: bold; font-size: 10dp; letter-spacing: 0.22em; }
#chip-dot { width: 6dp; height: 6dp; margin-right: 8dp; }
#root.branded #chip { display: none; }

/* ---- session card --------------------------------------------------------------------- */
#session { position: relative; padding: 20dp 22dp 16dp 22dp; margin-bottom: 26dp; background-color: #16151473; }
#session-head { display: flex; flex-direction: row; align-items: flex-start; margin-bottom: 16dp; }
#session-eyebrow { font-family: "Chakra Petch"; font-weight: bold; font-size: 11dp; letter-spacing: 0.22em; color: #bfaf03; margin-bottom: 7dp; text-transform: uppercase; }
#session-name { font-family: "Chakra Petch"; font-weight: bold; font-size: 25dp; line-height: 28dp; letter-spacing: 0.02em; text-transform: uppercase; color: #f7f7f6; white-space: nowrap; overflow: hidden; max-width: 360dp; }
#session.offline #session-name { color: #979795; }
#pill { display: flex; flex-direction: row; align-items: center; height: 26dp; padding: 0 11dp; font-family: "Chakra Petch"; font-weight: bold; font-size: 10dp; letter-spacing: 0.2em; color: #979795; decorator: fx(chamfer 6 1 0.01 0 #97979557); }
#pill-dot { width: 7dp; height: 7dp; margin-right: 8dp; background-color: #464644; }
#pill.live { color: #2be58b; decorator: fx(chamfer 6 1 0.01 0 #2be58b80); }
#pill.live #pill-dot { background-color: #2be58b; box-shadow: #2be58b 0 0 10dp 0; animation: 1.8s sine-in-out infinite live-blink; }
#pill.busy { color: #ff8120; decorator: fx(chamfer 6 1 0.01 0 #ff812080); }
#pill.busy #pill-dot { background-color: #ff8120; box-shadow: #ff8120 0 0 10dp 0; animation: 0.9s sine-in-out infinite live-blink; }
@keyframes live-blink { 0% { opacity: 1; } 50% { opacity: 0.35; } 100% { opacity: 1; } }

#session-grid { display: flex; flex-direction: row; flex-wrap: wrap; background-color: #9797952e; padding: 1dp 0 0 1dp; }
.cell { box-sizing: border-box; width: 50%; padding: 10dp 14dp 11dp 14dp; background-color: #10100fe6; border-right-width: 1dp; border-bottom-width: 1dp; border-color: #9797952e; }
.cell.wide { width: 100%; }
.cell-k { display: block; font-family: "Chakra Petch"; font-weight: bold; font-size: 9dp; letter-spacing: 0.22em; color: #676765; text-transform: uppercase; margin-bottom: 5dp; }
.cell-v { display: block; font-family: "Roboto Mono"; font-size: 14dp; color: #e9e9e9; white-space: nowrap; overflow: hidden; }
.cell-v .u { color: #979795; margin-left: 7dp; }
#session-hint { display: none; margin-top: 12dp; font-size: 15dp; line-height: 21dp; color: #979795; }
#session.offline.idle #session-hint { display: block; }

#privacy { display: flex; flex-direction: row; align-items: center; margin-top: 12dp; padding: 6dp 8dp 6dp 4dp; font-family: "Chakra Petch"; font-weight: bold; font-size: 11dp; letter-spacing: 0.14em; text-transform: uppercase; color: #979795; cursor: pointer; }
#privacy-box { width: 16dp; height: 16dp; margin-right: 10dp; border-width: 1dp; border-color: #97979580; background-color: #080808; display: flex; align-items: center; justify-content: center; }
#privacy-tick { width: 8dp; height: 8dp; background-color: transparent; }
#privacy.focus { color: #e9e9e9; }

/* ---- the actions -------------------------------------------------------------------- */
#pause-error { display: none; margin: 0 0 10dp 0; padding: 10dp 12dp; border-width: 1dp; border-color: #ff8120; color: #ff8120; background-color: #241a08cc; font-size: 15dp; }
#pause-error.on { display: block; }
#items { display: block; flex: 1 1 auto; }
.item
{
    position: relative; display: flex; flex-direction: row; align-items: center;
    height: 60dp; margin-bottom: 4dp; padding: 0 18dp 0 22dp;
    font-family: "Chakra Petch"; font-weight: bold; font-size: 25dp; letter-spacing: 0.05em; text-transform: uppercase; color: #e9e9e9;
    cursor: pointer;
    transition: color padding-left 0.16s cubic-out;
}
.item .hl { position: absolute; left: 0; top: 0; bottom: 0; width: 0dp; opacity: 0; transition: width opacity 0.2s cubic-out; }
.item .bar { position: absolute; left: 0; top: 10dp; bottom: 10dp; width: 3dp; opacity: 0; transition: opacity top bottom 0.18s cubic-out; }
.item path.ic { width: 24dp; height: 24dp; margin-right: 18dp; stroke: #676765; stroke-width: 2dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent; transition: stroke 0.16s cubic-out; }
.item .lbl { flex: 1 1 auto; }
.item .kbd { margin-left: 10dp; }
.item.focus { padding-left: 30dp; }
.item.focus .hl { width: 100%; opacity: 1; }
.item.focus .bar { opacity: 1; top: 0; bottom: 0; }
.item.disabled { opacity: 0.32; cursor: default; }
.item.danger.focus { color: #ff3b4e; }
.item.danger.focus path.ic { stroke: #ff3b4e; }
.item.danger .hl { decorator: linear-gradient(90deg, #ff3b4e24 0%, #ff3b4e0a 60%, #ff3b4e00 100%); }
.item.danger .bar { background-color: #ff3b4e; box-shadow: #ff3b4e 0 0 12dp 0; }
.rule { height: 1dp; margin: 12dp 0 14dp 0; background-color: #9797952e; }
.kbd { display: inline-block; height: 20dp; padding: 0 7dp; font-family: "Roboto Mono"; font-size: 11dp; line-height: 20dp; letter-spacing: 0.04em; color: #979795; decorator: fx(chamfer 5 1 0.01 0 #97979580); }

/* ---- the legend --------------------------------------------------------------------- */
#foot { position: relative; display: flex; flex-direction: row; align-items: center; margin-top: 18dp; padding-top: 16dp; border-top-width: 1dp; border-top-color: #9797952e; font-family: "Chakra Petch"; font-weight: bold; font-size: 10dp; letter-spacing: 0.16em; text-transform: uppercase; color: #979795; }
.leg { display: flex; flex-direction: row; align-items: center; margin-right: 22dp; }
.leg .kbd { margin-right: 8dp; }
.leg path.ic { width: 13dp; height: 13dp; stroke: #979795; stroke-width: 2dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent; }
.leg .kbd.icon { display: flex; flex-direction: row; align-items: center; padding: 0 5dp; }

/* ---- confirmation ------------------------------------------------------------------- */
#page-confirm { padding-top: 70dp; }
#confirm-mast { display: flex; flex-direction: row; align-items: center; margin-bottom: 18dp; }
#confirm-icon path.ic { width: 30dp; height: 30dp; stroke: #ff3b4e; stroke-width: 2dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent; margin-right: 14dp; }
#confirm-kicker { font-family: "Chakra Petch"; font-weight: bold; font-size: 11dp; letter-spacing: 0.24em; color: #ff3b4e; text-transform: uppercase; }
#confirm-title { font-family: "Chakra Petch"; font-weight: bold; font-size: 42dp; line-height: 44dp; text-transform: uppercase; color: #f7f7f6; margin-bottom: 18dp; }
#confirm-body { font-size: 18dp; line-height: 27dp; color: #afafad; max-width: 470dp; margin-bottom: 34dp; }
#confirm-actions { display: flex; flex-direction: row; }
.btn
{
    display: flex; flex-direction: row; align-items: center; justify-content: center;
    height: 48dp; padding: 0 24dp; margin-right: 12dp;
    font-family: "Chakra Petch"; font-weight: bold; font-size: 13dp; letter-spacing: 0.16em; text-transform: uppercase; color: #e9e9e9;
    decorator: fx(chamfer 7 1 0.4 0 #97979580); cursor: pointer;
    transition: color 0.14s cubic-out;
}
.btn .kbd { margin-left: 12dp; }
.btn.danger { color: #1a0409; decorator: fx(chamfer-solid 7 0 0 0 #ff3b4e); }
.btn.danger.focus { decorator: fx(chamfer-solid 7 10 0 0 #ff5c6b); }

/* ---- settings: rail ---------------------------------------------------------------- */
#rail { position: relative; display: flex; flex-direction: column; width: 270dp; padding-right: 26dp; margin-right: 36dp; border-right-width: 1dp; border-right-color: #9797952e; }
#rail-wordmark { margin-bottom: 26dp; }
#back { display: flex; flex-direction: row; align-items: center; height: 42dp; padding: 0 14dp; margin-bottom: 24dp; font-family: "Chakra Petch"; font-weight: bold; font-size: 12dp; letter-spacing: 0.18em; text-transform: uppercase; color: #afafad; decorator: fx(chamfer 7 1 0.3 0 #97979557); cursor: pointer; }
#back path.ic { width: 16dp; height: 16dp; margin-right: 10dp; stroke: #afafad; stroke-width: 2dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent; }
#back .kbd { margin-left: 10dp; }
#rail-label { font-family: "Chakra Petch"; font-weight: bold; font-size: 9dp; letter-spacing: 0.26em; color: #676765; text-transform: uppercase; margin: 0 0 10dp 14dp; }
#tabs { display: block; }
.tab
{
    position: relative; display: flex; flex-direction: row; align-items: center;
    height: 50dp; margin-bottom: 3dp; padding: 0 14dp;
    font-family: "Chakra Petch"; font-weight: bold; font-size: 14dp; letter-spacing: 0.12em; text-transform: uppercase; color: #979795;
    cursor: pointer; transition: color padding-left 0.16s cubic-out;
}
.tab .hl { position: absolute; left: 0; top: 0; bottom: 0; width: 0; opacity: 0; transition: width opacity 0.2s cubic-out; }
.tab .bar { position: absolute; left: 0; top: 14dp; bottom: 14dp; width: 2dp; opacity: 0; transition: opacity top bottom 0.18s cubic-out; }
.tab path.ic { width: 19dp; height: 19dp; margin-right: 13dp; stroke: #676765; stroke-width: 2dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent; }
.tab.focus { color: #e9e9e9; padding-left: 20dp; }
.tab.focus .hl { width: 100%; opacity: 0.6; }
.tab.focus path.ic { stroke: #afafad; }
.tab.active .hl { width: 100%; opacity: 1; }
.tab.active .bar { opacity: 1; top: 0; bottom: 0; }
.tab.disabled { opacity: 0.35; cursor: default; }
#vanilla { display: flex; flex-direction: row; align-items: center; height: 44dp; padding: 0 14dp; font-family: "Chakra Petch"; font-weight: bold; font-size: 11dp; letter-spacing: 0.16em; text-transform: uppercase; color: #afafad; decorator: fx(chamfer 7 1 0.3 0 #97979557); cursor: pointer; }
#vanilla path.ic { width: 16dp; height: 16dp; margin-right: 10dp; stroke: #afafad; stroke-width: 2dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent; }
#vanilla-hint { margin: 10dp 4dp 0 4dp; font-size: 13dp; line-height: 18dp; color: #676765; }

/* ---- settings: content ------------------------------------------------------------- */
#content { position: relative; display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; }
#content-head { display: flex; flex-direction: row; align-items: flex-end; min-height: 66dp; margin-bottom: 18dp; }
#content-kicker { font-family: "Chakra Petch"; font-weight: bold; font-size: 11dp; letter-spacing: 0.24em; color: #bfaf03; text-transform: uppercase; margin-bottom: 6dp; }
#content-title { font-family: "Chakra Petch"; font-weight: bold; font-size: 40dp; line-height: 40dp; text-transform: uppercase; color: #f7f7f6; }
#note { font-family: "Roboto Mono"; font-size: 12dp; color: #979795; text-align: right; max-width: 460dp; }
#note.ok { color: #2be58b; }
#note.error { color: #ff3b4e; }

#filter-wrap { position: relative; display: flex; flex-direction: row; align-items: center; height: 44dp; padding: 0 8dp 0 14dp; margin-bottom: 14dp; background-color: #080808b3; border-width: 1dp; border-color: #97979557; cursor: text; }
#filter-icon path.ic { width: 17dp; height: 17dp; margin-right: 10dp; stroke: #676765; stroke-width: 2dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent; }
input.range, #filter { tab-index: none; }
#filter { flex: 1 1 auto; height: 22dp; font-family: Rajdhani; font-weight: bold; font-size: 17dp; color: #f7f7f6; background-color: transparent; border-width: 0; padding: 0; }
#filter-placeholder { position: absolute; left: 41dp; top: 13dp; font-family: "Chakra Petch"; font-weight: bold; font-size: 12dp; letter-spacing: 0.2em; color: #676765; pointer-events: none; }
#filter-wrap.typed #filter-placeholder { display: none; }
#filter-clear { display: none; width: 30dp; height: 30dp; align-items: center; justify-content: center; cursor: pointer; }
#filter-wrap.typed #filter-clear { display: flex; }
#filter-clear path.ic { width: 15dp; height: 15dp; stroke: #979795; stroke-width: 2dp; stroke-linecap: round; fill: transparent; }

#list-wrap { position: relative; flex: 1 1 auto; min-height: 0; }
#list { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow-y: auto; padding-right: 10dp; }
#list-fade { position: absolute; left: 0; right: 10dp; bottom: 0; height: 28dp; decorator: linear-gradient(180deg, #0e0e0d00 0%, #0e0e0de6 100%); pointer-events: none; }

.section { display: block; margin-bottom: 26dp; }
.section-title { display: flex; flex-direction: row; align-items: center; padding-bottom: 9dp; margin-bottom: 4dp; border-bottom-width: 1dp; border-bottom-color: #97979557; font-family: "Chakra Petch"; font-weight: bold; font-size: 15dp; letter-spacing: 0.12em; text-transform: uppercase; color: #e9e9e9; }
.section-title .count { margin-left: 10dp; font-family: "Roboto Mono"; font-size: 11dp; color: #676765; letter-spacing: 0; }
.empty { display: block; margin: 40dp 0; text-align: center; font-family: "Roboto Mono"; font-size: 13dp; color: #676765; }

/* a row's height follows its content: the highlight is the row's own background and edge
   (an absolute layer inside a min-height flex row has no height to stretch to) */
.srow { position: relative; display: flex; flex-direction: row; align-items: center; min-height: 56dp; padding: 8dp 12dp 8dp 12dp; border-left-width: 2dp; border-left-color: transparent; border-bottom-width: 1dp; border-bottom-color: #9797951c; }
.srow.sub { padding-left: 34dp; }
.srow.locked { opacity: 0.45; }
.srow .lbl { position: relative; display: block; flex: 1 1 auto; min-width: 0; padding-right: 20dp; }
.srow .name { display: block; font-size: 17dp; font-weight: bold; line-height: 21dp; color: #e9e9e9; }
.srow.sub .name { color: #d2d2d1; }
.srow .tags { display: flex; flex-direction: row; margin-top: 4dp; }
.tag { margin-right: 6dp; padding: 2dp 7dp; font-family: "Chakra Petch"; font-weight: bold; font-size: 9dp; letter-spacing: 0.14em; color: #979795; decorator: fx(chamfer 4 1 0.01 0 #97979557); }
.tag.warn { color: #ff8120; decorator: fx(chamfer 4 1 0.01 0 #ff812080); }
.srow .ctl { position: relative; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; width: 400dp; flex: 0 0 auto; }

/* slider: a well with the fill, a native range on top for the thumb and the drag */
.slider { position: relative; width: 304dp; height: 30dp; }
.slider .well { position: absolute; left: 0; right: 0; top: 13dp; height: 4dp; background-color: #080808; border-width: 1dp; border-color: #9797952e; }
.slider .fill { position: absolute; left: 0; top: 13dp; height: 4dp; }
.slider input.range { position: absolute; left: 0; top: 0; width: 304dp; height: 30dp; cursor: pointer; }
.slider input.range slidertrack { height: 30dp; margin-top: 0; background-color: transparent; }
.slider input.range sliderbar { width: 10dp; height: 22dp; margin-top: 4dp; }
.slider input.range sliderarrowdec, .slider input.range sliderarrowinc { width: 0; height: 0; }
.readout { width: 82dp; text-align: right; font-family: "Roboto Mono"; font-size: 14dp; font-weight: bold; }

/* switch */
.tgl { display: flex; flex-direction: row; align-items: center; cursor: pointer; font-family: "Chakra Petch"; font-weight: bold; font-size: 11dp; letter-spacing: 0.16em; color: #979795; }
.tgl .word { width: 40dp; text-align: right; margin-right: 12dp; }
.tgl .well { position: relative; width: 48dp; height: 24dp; background-color: #080808; decorator: fx(chamfer 5 1 0.6 0 #97979580); }
.tgl .knob { position: absolute; left: 4dp; top: 4dp; width: 16dp; height: 16dp; background-color: #676765; transition: left background-color 0.2s back-out; }
.tgl.on .knob { left: 28dp; }

/* list: step, value (opens the sheet), step */
.lst { display: flex; flex-direction: row; align-items: center; }
.lst .step { display: flex; align-items: center; justify-content: center; width: 40dp; height: 40dp; decorator: fx(chamfer 6 1 0.5 0 #97979557); cursor: pointer; }
.lst .step path.ic { width: 16dp; height: 16dp; stroke: #afafad; stroke-width: 2.2dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent; }
.lst .step.off { opacity: 0.25; cursor: default; }
.lst .val { display: flex; flex-direction: row; align-items: center; width: 296dp; height: 40dp; margin: 0 6dp; padding: 0 12dp 0 14dp; font-family: "Chakra Petch"; font-weight: bold; font-size: 13dp; letter-spacing: 0.08em; color: #e9e9e9; decorator: fx(chamfer 6 1 0.6 0 #97979557); cursor: pointer; }
.lst .val .txt { flex: 1 1 auto; white-space: nowrap; overflow: hidden; }
.lst .val path.ic { width: 14dp; height: 14dp; stroke-width: 2.2dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent; }
.lst .val.off { opacity: 0.5; cursor: default; }

/* keybind */
.kb { display: flex; flex-direction: row; align-items: center; }
.kb .reset { display: flex; align-items: center; justify-content: center; width: 40dp; height: 40dp; margin-right: 6dp; decorator: fx(chamfer 6 1 0.5 0 #97979557); cursor: pointer; }
.kb .reset path.ic { width: 16dp; height: 16dp; stroke: #afafad; stroke-width: 2dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent; }
.kb .reset.off { opacity: 0.25; cursor: default; }
.kb .key { min-width: 150dp; height: 40dp; padding: 0 16dp; font-family: "Roboto Mono"; font-weight: bold; font-size: 14dp; line-height: 40dp; text-align: center; letter-spacing: 0.04em; text-transform: uppercase; color: #e9e9e9; decorator: fx(chamfer 6 1 0.6 0 #97979580); cursor: pointer; }
.kb .key.capture { animation: 1s sine-in-out infinite capture-pulse; }
@keyframes capture-pulse { 0% { opacity: 1; } 50% { opacity: 0.55; } 100% { opacity: 1; } }

/* meter and info */
.mtr { position: relative; width: 304dp; height: 6dp; background-color: #080808; border-width: 1dp; border-color: #9797952e; margin-right: 0; }
.mtr .fill { position: absolute; left: 0; top: 0; bottom: 0; transition: width 0.06s linear-in-out; }
.mtr .thr { position: absolute; top: -5dp; bottom: -5dp; width: 2dp; background-color: #ff8120; }
.srow.active .mtr .fill { background-color: #2be58b; box-shadow: #2be58b 0 0 10dp 0; }
.info { font-family: "Roboto Mono"; font-size: 13dp; color: #e9e9e9; text-align: right; white-space: nowrap; overflow: hidden; max-width: 400dp; }

scrollbarvertical { width: 4dp; margin-left: 0; }
scrollbarvertical slidertrack { background-color: #97979514; }
scrollbarvertical sliderbar { background-color: #97979566; border-radius: 0; }

/* ---- the option sheet --------------------------------------------------------------- */
#sheet-veil { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #0808088c; }
#sheet
{
    display: none; position: absolute; top: 150dp; width: 500dp; max-height: 760dp;
    flex-direction: column; padding: 20dp 20dp 16dp 20dp;
    backdrop-filter: blur(22dp) saturate(1.3);
    decorator: linear-gradient(180deg, #1d1d1bf2 0%, #151413f7 100%);
    box-shadow: #000000e6 0 40dp 90dp -20dp;
}
#root.sheet #sheet-veil { display: block; }
#root.sheet #sheet { display: flex; }
#sheet-head { display: flex; flex-direction: row; align-items: flex-end; margin-bottom: 12dp; }
#sheet-kicker { font-family: "Chakra Petch"; font-weight: bold; font-size: 10dp; letter-spacing: 0.24em; color: #bfaf03; text-transform: uppercase; margin-bottom: 4dp; }
#sheet-title { font-family: "Chakra Petch"; font-weight: bold; font-size: 20dp; color: #f7f7f6; }
#sheet-count { font-family: "Roboto Mono"; font-size: 11dp; color: #676765; }
#sheet-find { display: block; height: 0; overflow: hidden; font-family: "Roboto Mono"; font-size: 12dp; color: #979795; transition: height 0.15s cubic-out; }
#sheet.finding #sheet-find { height: 24dp; }
#sheet-list { display: block; max-height: 600dp; overflow-y: auto; }
.opt { position: relative; display: flex; flex-direction: row; align-items: center; height: 40dp; padding: 0 14dp; font-family: "Chakra Petch"; font-weight: bold; font-size: 13dp; letter-spacing: 0.08em; color: #d2d2d1; cursor: pointer; }
.opt .hl { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; opacity: 0; transition: opacity 0.12s cubic-out; }
.opt .bar { position: absolute; left: 0; top: 0; bottom: 0; width: 2dp; opacity: 0; }
.opt .txt { flex: 1 1 auto; white-space: nowrap; overflow: hidden; }
.opt path.ic { width: 15dp; height: 15dp; stroke-width: 2.4dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent; opacity: 0; }
.opt.focus .hl, .opt.focus .bar { opacity: 1; }
.opt.current path.ic { opacity: 1; }
.opt.hide { display: none; }
