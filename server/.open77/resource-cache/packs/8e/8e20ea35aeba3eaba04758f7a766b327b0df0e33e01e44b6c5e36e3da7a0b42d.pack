            { key = "deleon",      label = "Villefort Deleon",     category = "Sport",   record = "Vehicle.v_sport2_villefort_deleon_player" },
            { key = "semimaru",    label = "Yaiba Semimaru",       category = "Bikes",   record = "Vehicle.v_sport1_yaiba_semimaru_player" },
            { key = "kusanagi",    label = "Yaiba Kusanagi",       category = "Bikes",   record = "Vehicle.v_sportbike1_yaiba_kusanagi_player" },
            { key = "muramasa",    label = "Yaiba Muramasa",       category = "Bikes",   record = "Vehicle.v_sportbike1_yaiba_muramasa_player" },
            { key = "arch",        label = "ARCH Nazaré",          category = "Bikes",   record = "Vehicle.v_sportbike2_arch_player" },
            { key = "jackie",      label = "Jackie's ARCH",        category = "Bikes",   record = "Vehicle.v_sportbike2_arch_jackie_player" },
            { key = "apollo",      label = "Brennan Apollo",       category = "Bikes",   record = "Vehicle.v_sportbike3_brennan_apollo_player" },
            { key = "manticore",   label = "Militech Manticore",   category = "AV",     record = "Vehicle.av_militech_manticore" },
            { key = "excalibur",   label = "Rayfield Excalibur",   category = "AV",     record = "Vehicle.av_rayfield_excalibur" },
            -- Third-party vehicles shipped as world packages (resources/assets/vehicles).
            -- The records only exist on a client that installed those packages, so
            -- list them only on worlds that require them (the freeroam servers do).
            { key = "aventador",   label = "Lamborghini Aventador SVJ", category = "Custom", record = "Vehicle.aventador_svj_01" },
            { key = "demon",       label = "Dodge Challenger SRT Demon", category = "Custom", record = "Vehicle.challenger_srt_demon_01" },
            { key = "m4csl",       label = "BMW M4 CSL",                 category = "Custom", record = "Vehicle.bmw_m4_csl" },
        },
        shortcuts = {},
    },

    weapons = {
        enabled = true,
        defaultReserve = 500,
        maximumReserve = 5000,
        catalog = {
            { key = "lexington", label = "M-10AF Lexington", category = "Handguns", record = "Items.Preset_Lexington_Default" },
            { key = "unity",     label = "Unity",            category = "Handguns", record = "Items.Preset_Unity_Default" },
            { key = "nue",       label = "Nue",              category = "Handguns", record = "Items.Preset_Nue_Default" },
            { key = "overture",  label = "Overture",         category = "Handguns", record = "Items.Preset_Overture_Default" },
            { key = "quasar",    label = "DR-12 Quasar",     category = "Handguns", record = "Items.Preset_Quasar_Default" },
            { key = "malorian",  label = "Malorian 3516",    category = "Handguns", record = "Items.Preset_Silverhand_3516" },
            { key = "king_burya",label = "King's Burya",      category = "Handguns", record = "Items.Preset_Burya_King" },
            { key = "saratoga",  label = "M221 Saratoga",    category = "SMG",      record = "Items.Preset_Saratoga_Default" },
            { key = "fenrir",    label = "Fenrir",           category = "SMG",      record = "Items.Preset_Saratoga_Maelstrom" },
            { key = "ajax",      label = "M251s Ajax",       category = "Rifles",   record = "Items.Preset_Ajax_Default" },
            { key = "copperhead",label = "D5 Copperhead",    category = "Rifles",   record = "Items.Preset_Copperhead_Default" },
            { key = "masamune",  label = "HJSH-18 Masamune", category = "Rifles",   record = "Items.Preset_Masamune_Default" },
            { key = "achilles",  label = "M-179e Achilles",  category = "Rifles",   record = "Items.Preset_Achilles_Default" },
            { key = "sor22",     label = "SOR-22",           category = "Rifles",   record = "Items.Preset_Sor22_Default" },
            { key = "grad",      label = "SPT32 Grad",       category = "Snipers",  record = "Items.Preset_Grad_Default" },
            { key = "nekomata",  label = "Nekomata",         category = "Snipers",  record = "Items.Preset_Nekomata_Default" },
            { key = "ashura",    label = "Ashura",           category = "Snipers",  record = "Items.Preset_Ashura_Default" },
            { key = "carnage",   label = "Carnage",          category = "Shotguns", record = "Items.Preset_Carnage_Default" },
            { key = "satara",    label = "DB-2 Satara",      category = "Shotguns", record = "Items.Preset_Satara_Default" },
            { key = "zhuo",      label = "L-69 Zhuo",        category = "Shotguns", record = "Items.Preset_Zhuo_Default" },
            { key = "defender",  label = "M2067 Defender",   category = "Heavy",   record = "Items.Preset_Defender_Default" },
            { key = "katana",    label = "Katana",           category = "Melee",   record = "Items.Preset_Katana_Default", melee = true },
            { key = "knife",     label = "Knife",            category = "Melee",   record = "Items.Preset_Knife_Default", melee = true },
            { key = "machete",   label = "Machete",          category = "Melee",   record = "Items.Preset_Machete_Default", melee = true },
            { key = "hammer",    label = "Hammer",           category = "Melee",   record = "Items.Preset_Hammer_Default", melee = true },
        },
    },

    player = {
        allowRestore = true,
        allowGodMode = true,
        armorOnRestore = 100,
    },

    -- Player-versus-player damage. The platform default is friendly fire OFF;
    -- freeroam opts in and shields the spawn areas.
    combat = {
        pvpEnabled = true,
        -- No damage inside this radius around any spawn point (metres).
        safeZoneRadius = 30.0,
        -- Multipliers applied by the server ledger on top of the vanilla
        -- damage computed on the attacker's game.
        damageMultiplier = 1.0,
        headshotMultiplier = 2.0,
        -- Per-attack-kind multipliers on top of the global one.
        rangedMultiplier = 1.0,
        meleeMultiplier = 1.0,
        explosionMultiplier = 1.0,
        -- Grenades, vehicle missiles and car explosions knock nearby players down
        -- on every screen (open77_weapons blast relay; cars and NPCs are always
        -- relayed). Street only (bucket 0), never inside a spawn safe zone, and
        -- only while pvpEnabled. false keeps the vanilla picture: damage only.
        blastKnockdown = true,
        -- Passive regeneration in health points per second (0 disables).
        regenPerSecond = 0.0,
        killfeed = {
            enabled = true,
            -- Entries visible at once and per-entry lifetime.
            maxEntries = 5,
            entryTtlMs = 6000,
        },
    },

    -- true: player commands (/car, /dv, /goto, /tpc, /spawn, /suicide,
    -- /revive) require the command.<name> ACL. The freeroam.* admin commands
    -- are always restricted.
    restrictPlayerCommands = false,

    blips = {
        enabled = true,
        locationSprite = "fast_travel",
        showSpawns = true,
        spawnSprite = "objective",
    },

    -- The 3D city map (op77_map3d), when the server runs it: freeroam's blue
    -- theme instead of the map's default black and yellow, and the blips above
    -- (same blips.enabled / blips.showSpawns switches) on the map and minimap.
    -- The map is optional: without it nothing here runs. Every colour is a token
    -- of web/design-system.css (the freeroam HUD), named beside it.
    map3d = {
        enabled = true,
        title = "NIGHT CITY",
        subtitle = "FREEROAM",
        theme = {
            background = "#0b0e14",               -- --o-ink-900 (--surface-app)
            terrain = "#12161f",                  -- --o-ink-700
            terrainGrid = "#22d8e2",              -- --o-cyan-500
            water = "#05070b",                    -- --o-black (--surface-inset)
            waterLine = "#3d7f85",                -- --o-teal-muted
            road = "#2a313e",                     -- --o-ink-400
            roadEdge = "#22d8e2",                 -- --o-cyan-500
            metro = "#0b7f87",                    -- --o-cyan-700
            building = "#3a4250",                 -- --o-ink-300
            buildingTop = "#5a6472",              -- --o-ink-200
            buildingEdge = "#22d8e2",             -- --o-cyan-500
            landmark = "#4ee6ee",                 -- --o-cyan-400
            accent = "#22d8e2",                   -- --o-cyan-500 (--text-accent)
            accentSoft = "rgba(34, 216, 226, 0.35)", -- --glow-accent-soft
            text = "#e6eaec",                     -- --text-primary
            textDim = "#8a94a2",                  -- --text-secondary
            panel = "rgba(11, 14, 20, 0.82)",     -- --surface-hud
            danger = "#ff3b4e",                   -- --o-red-500
        },
        -- The legend (replaces the map's own list).
        categories = {
            { id = "destination", label = "Destinations", icon = "flag", color = "#22d8e2" },
            { id = "spawn", label = "Spawn points", icon = "star", color = "#2be58b" },
            { id = "player", label = "Players", icon = "user", color = "#4ee6ee" },
            { id = "default", label = "Other", icon = "pin" },
        },
        -- Category of each mirrored blip (its icon and colour come from the row).
        locationCategory = "destination",
        spawnCategory = "spawn",
    },
}

for _, vehicle in ipairs(FreeroamConfig.vehicles.catalog) do
    FreeroamConfig.vehicles.shortcuts[vehicle.key] = vehicle.record
end
-- The browser assembles the paged global scoreboard; Lua relays bounded pages.
FreeroamRoster = { pageSize = 128, maximumPlayers = 4096 }
/* Open//77 freeroam HUD on NativeUI: glass panels turned toward the centre of the
   screen (3D transforms), the design-system tokens of web/design-system.css.
   1 dp = 1 px of the 1080p reference. */

body { pointer-events: none; font-family: "Chakra Petch"; font-weight: bold; color: #e6eaec; }
/* hidden = visibility, not only opacity: a backdrop-filter (the glass) is still drawn at opacity 0 */
/* one eye for every panel, at the centre of the screen: the panels are projected toward it */
#hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0; visibility: hidden; transition: opacity 0.3s cubic-out;
       perspective: 1500dp; perspective-origin: 50% 88%; }
#hud.ready { opacity: 1; visibility: visible; }
#hud.hidden, #hud.hidden #vehicle, #hud.ready.vehicle.hidden #vehicle { opacity: 0; visibility: hidden; }
.grow { flex: 1 1 auto; }
.dim { color: #8a94a2; }
.label { font-size: 10dp; letter-spacing: 0.22em; color: #8a94a2; }

/* ---- glass ---------------------------------------------------------------------- */
.glass-panel
{
    position: relative;
    background-color: #0b0e14a8;
    decorator: linear-gradient(90deg, #05070bd0 0%, #0b0e1480 100%);
    backdrop-filter: blur(10dp) saturate(1.3);
    border-width: 1dp;
    border-color: #e6eaec22;
}
.panel-edge
{
    position: absolute; left: -1dp; top: -1dp; width: 3dp; bottom: -1dp;
    background-color: #22d8e2;
    filter: glow(6dp #22d8e2 1.2);
}

/* ---- the wings, turned toward the centre ------------------------------------------ */
.wing { position: absolute; bottom: 30dp; }
/* they swing in from edge-on when the HUD becomes ready, then hold their angle */
.wing-left
{
    left: 34dp; width: 420dp;
    transform: rotateY(70deg);
    transform-origin: 0% 100%;
    transition: transform 0.7s back-out;
}
.wing-right
{
    right: 34dp; width: 300dp; bottom: 96dp; /* the bottom 96 dp belong to open-voice */
    transform: rotateY(-70deg);
    transform-origin: 100% 100%;
    transition: transform 0.7s back-out;
    display: flex; flex-direction: column; align-items: flex-end;
}
#hud.ready .wing-left { transform: rotateY(20deg); }
#hud.ready .wing-right { transform: rotateY(-20deg); }

/* ---- vitals: a floating bar, no panel ---------------------------------------------- */
#vitals { display: flex; flex-direction: row; align-items: center; height: 44dp; }
.vb-badge
{
    display: flex; flex-direction: row; align-items: center;
    height: 26dp; padding: 0 9dp 0 7dp; margin-right: 6dp;
    background-color: #e8263b;
    transform: skewX(-14deg);
    filter: glow(8dp #ff3b4e 0.9);
}
.vb-cross { width: 11dp; height: 11dp; fill: #ffffff; margin-right: 6dp; }
.vb-hp { font-family: "Chakra Petch"; font-weight: bold; font-size: 19dp; line-height: 26dp; color: #ffffff; min-width: 30dp; }
.vb-bars { flex: 1 1 auto; }
.vb-armor { height: 3dp; margin: 0 4dp 3dp 6dp; transform: skewX(-24deg); background-color: #22d8e214; visibility: hidden; }
.vb-armor.on { visibility: visible; }
.vb-armor-fill { height: 3dp; background-color: #4ee6ee; filter: glow(4dp #22d8e2 1); transition: width 0.3s cubic-out; }
.vb-health
{
    position: relative; height: 15dp;
    transform: skewX(-24deg);
    decorator: linear-gradient(90deg, #22d8e255 0%, #22d8e230 60%, #22d8e210 100%);
    border-bottom-width: 1dp; border-bottom-color: #4ee6ee66;
}
.vb-ghost { position: absolute; left: 0; top: 0; bottom: 0; background-color: #ffd0d6; opacity: 0.5; transition: width 0.9s cubic-in-out; }
.vb-fill
{
    position: absolute; left: 0; top: 0; bottom: 0;
    decorator: linear-gradient(90deg, #a3121f 0%, #e8263b 55%, #ff5568 100%);
    filter: glow(7dp #ff3b4e 0.8);
    transition: width 0.18s cubic-out;
}
.vb-tip { position: absolute; right: 0; top: 0; bottom: 0; width: 3dp; background-color: #ffe3e7; }
.vb-stamina { height: 3dp; margin: 3dp 14dp 0 0; transform: skewX(-24deg); background-color: #ffb02014; }
.vb-sta-fill { height: 3dp; background-color: #ffb020; filter: glow(4dp #ffb020 0.8); transition: width 0.25s cubic-out; }
.vb-sta-fill.low { background-color: #ff6a20; }
.vb-armor-value { margin-left: 8dp; font-family: "Roboto Mono"; font-size: 11dp; color: #4ee6ee; }
#vitals.critical .vb-badge { animation: 0.9s sine-in-out infinite hud-pulse; }
@keyframes hud-pulse { 0% { opacity: 1; } 50% { opacity: 0.55; } 100% { opacity: 1; } }
#vitals.hurt .vb-health { animation: 0.35s cubic-out hud-hurt; }
@keyframes hud-hurt { 0% { background-color: #ff3b4e88; } 100% { background-color: #00000000; } }

/* ---- weapons: floating rows right above the vitals bar, the same language -------- */
#weapons { margin-bottom: 6dp; padding-left: 4dp; }
.wb { margin-bottom: 7dp; opacity: 0.7; transition: opacity 0.2s cubic-out; }
.wb.drawn { opacity: 1; }
.wb-head { display: flex; flex-direction: row; align-items: center; height: 22dp; }
.wb-badge { height: 18dp; padding: 0 7dp; margin-right: 8dp; background-color: #22d8e2; transform: skewX(-14deg); filter: glow(6dp #22d8e2 0.8); }
.wb-slot { font-family: "Roboto Mono"; font-size: 12dp; line-height: 18dp; color: #05262a; }
.wb-name { font-family: "Chakra Petch"; font-weight: bold; font-size: 14dp; letter-spacing: 0.06em; text-transform: uppercase; color: #f7f9fb; white-space: nowrap; font-effect: shadow(0dp 1dp #000000); }
.wb-type { margin-left: 8dp; font-size: 9dp; letter-spacing: 0.18em; text-transform: uppercase; color: #8a94a2; white-space: nowrap; }
.wb-ammo { white-space: nowrap; margin-right: 14dp; }
.wb-mag { font-family: "Chakra Petch"; font-weight: bold; font-size: 22dp; color: #f7f9fb; font-effect: shadow(0dp 1dp #000000); }
.wb.low .wb-mag { color: #ff3b4e; animation: 0.8s sine-in-out infinite hud-blink; }
@keyframes hud-blink { 0% { opacity: 1; } 50% { opacity: 0.45; } 100% { opacity: 1; } }
.wb-res { margin-left: 4dp; font-family: "Roboto Mono"; font-size: 11dp; color: #8a94a2; }
.wb-state { margin-right: 14dp; font-size: 9dp; letter-spacing: 0.2em; color: #8a94a2; }
.wb.drawn .wb-state { color: #2be58b; }
.wb-strip { display: flex; flex-direction: row; height: 6dp; margin: 3dp 18dp 0 0; transform: skewX(-24deg); }
.wb-strip span { display: block; flex: 1 1 0; margin-right: 2dp; background-color: #22d8e222; }
.wb-strip span.live { background-color: #4ee6ee; }
.wb.low .wb-strip span.live { background-color: #ff3b4e; }
.wb-line { height: 2dp; margin: 3dp 18dp 0 0; transform: skewX(-24deg); background-color: #22d8e255; }
.wb-reload { display: none; position: relative; height: 3dp; margin: 2dp 18dp 0 0; transform: skewX(-24deg); background-color: #ffb02022; }
.wb.reloading .wb-reload { display: block; }
.wb.reloading .wb-mag { color: #ffb020; }
.wb-reload-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 30%; background-color: #ffb020; filter: glow(5dp #ffb020 1); animation: 0.9s linear-in-out infinite hud-reload; }
@keyframes hud-reload { from { left: 0%; } to { left: 70%; } }

/* ---- hints: a discreet list, no panel ---------------------------------------------- */
#hints { width: 200dp; opacity: 0.62; }
.hint { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; height: 16dp; }
.hint-text { font-family: Rajdhani; font-weight: bold; font-size: 12dp; color: #c2cad3; margin-right: 8dp; font-effect: shadow(0dp 1dp #000000); }
.hint-cmd { font-family: "Roboto Mono"; font-weight: normal; font-size: 11dp; color: #4ee6ee; width: 72dp; text-align: right; font-effect: shadow(0dp 1dp #000000); }

/* ---- vehicle: a head-up readout floating beside the car ---------------------------- */
#vehicle
{
    position: absolute; left: 61%; bottom: 25%; width: 260dp;
    transform: rotateY(-22deg) rotateX(12deg) translateY(24dp) scale(0.67);
    transform-origin: 0% 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity transform 0.4s cubic-out;
}
#hud.ready.vehicle #vehicle { visibility: visible; opacity: 1; transform: rotateY(-22deg) rotateX(12deg) translateY(0dp) scale(0.67); }
#hud.vehicle #left { opacity: 0.85; }
#speedo { animation: 3.2s sine-in-out infinite alternate hud-float; }
@keyframes hud-float { from { transform: translateY(-2dp); } to { transform: translateY(2dp); } }
.hud-row { display: flex; flex-direction: row; align-items: center; }
.speed { font-family: "Chakra Petch"; font-weight: bold; font-size: 92dp; line-height: 84dp; letter-spacing: 0.04em; white-space: nowrap; }
.speed-lead { color: #f7f9fb30; }
.speed-num { color: #f7f9fb; font-effect: glow(3dp 0dp 0dp 0dp #9ff6ff99); }
.tells { display: flex; flex-direction: column; margin-left: 14dp; }
.tell { font-family: "Chakra Petch"; font-size: 15dp; line-height: 22dp; letter-spacing: 0.06em; color: #e6eaec38; }
.tell.on { color: #ffb020; font-effect: glow(2dp 0dp 0dp 0dp #ffb02088); }
.tell.warn { color: #ff3b4e; font-effect: glow(2dp 0dp 0dp 0dp #ff3b4e88); }
.sub { margin-top: 2dp; padding-right: 50dp; }
.gear { font-family: "Chakra Petch"; font-size: 17dp; letter-spacing: 0.06em; color: #2be58b; font-effect: glow(2dp 0dp 0dp 0dp #2be58b88); }
.gear.rev { color: #ff3b4e; }
.unit { font-family: "Chakra Petch"; font-size: 17dp; letter-spacing: 0.08em; color: #e6eaec; }
.rpm-line { position: relative; height: 4dp; margin-top: 6dp; margin-right: 30dp; background-color: #e6eaec26; }
.rpm-fill { height: 4dp; background-color: #f7f9fb; filter: glow(6dp #9ff6ff 1.4); transition: width 0.1s linear-in-out; }
.rpm-fill.red { background-color: #ff3cac; filter: glow(6dp #ff3cac 1.4); }
<rml>
<head>
    <title>Open//77 Freeroam HUD</title>
    <link type="text/rcss" href="nui://open77/open77.rcss"/>
    <link type="text/rcss" href="hud.rcss"/>
</head>
<body data-model="hud">
<div id="hud" data-class-ready="ready" data-class-hidden="hidden" data-class-vehicle="inVehicle">

    <!-- left: vitals, turned toward the centre of the screen -->
    <div id="left" class="wing wing-left">
        <div id="weapons" data-if="weaponCount > 0 &amp;&amp; !inVehicle">
            <div class="wb" data-for="w : weapons" data-class-low="w.low" data-class-reloading="w.reloading"
                 data-class-melee="w.melee" data-class-drawn="w.drawn">
                <div class="wb-head">
                    <div class="wb-badge"><span class="wb-slot">{{w.slot}}</span></div>
                    <span class="wb-name">{{w.label}}</span>
                    <span class="wb-type">{{w.hand}} · {{w.category}}</span>
                    <span class="grow"></span>
                    <span class="wb-ammo" data-if="w.ammoKnown"><span class="wb-mag">{{w.magazine}}</span><span class="wb-res">/ {{w.reserve}}</span></span>
                    <span class="wb-state" data-if="!w.ammoKnown">{{w.state}}</span>
                </div>
                <div class="wb-strip" data-if="w.ammoKnown"><span data-for="s : w.segs" data-class-live="s"></span></div>
                <div class="wb-line" data-if="!w.ammoKnown"></div>
                <div class="wb-reload"><div class="wb-reload-bar"></div></div>
            </div>
        </div>
        <div id="vitals" data-class-critical="critical" data-class-hurt="hurt">
            <div class="vb-badge">
                <path class="vb-cross" view-box="0 0 10 10" d="M3.6 0.8H6.4V3.6H9.2V6.4H6.4V9.2H3.6V6.4H0.8V3.6H3.6Z"/>
                <span class="vb-hp">{{hp}}</span>
            </div>
            <div class="vb-bars">
                <div class="vb-armor" data-class-on="armor > 0"><div class="vb-armor-fill" data-style-width="armorPct + '%'"></div></div>
                <div class="vb-health">
                    <div class="vb-ghost" data-style-width="hpGhost + '%'"></div>
                    <div class="vb-fill" data-style-width="hpPct + '%'"><div class="vb-tip"></div></div>
                </div>
                <div class="vb-stamina"><div class="vb-sta-fill" data-style-width="staPct + '%'" data-class-low="25 > staPct"></div></div>
            </div>
            <span class="vb-armor-value" data-if="armor > 0">{{armor}}</span>
        </div>
    </div>

    <!-- right: weapons and the command hints, turned toward the centre -->
    <div id="right" class="wing wing-right">
        <div id="hints" data-if="hintsVisible">
            <div class="hint"><span class="hint-text">Menu &amp; tools</span><span class="hint-cmd">/freeroam</span></div>
            <div class="hint"><span class="hint-text">Street racing</span><span class="hint-cmd">/race</span></div>
            <div class="hint"><span class="hint-text">Combat arenas</span><span class="hint-cmd">/pvp</span></div>
            <div class="hint"><span class="hint-text">Animations</span><span class="hint-cmd">/anim</span></div>
        </div>
    </div>

</div>
</body>
</rml>
/* Freeroam roster (TAB) on NativeUI: a glass board that slides in from the left edge and
   stays turned toward the centre of the screen. 1 dp = 1 px at 1080p. */

body { pointer-events: none; }
#root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; perspective: 1400dp; perspective-origin: 50% 45%; visibility: hidden; font-family: Rajdhani; font-weight: bold; color: #e9edf1; }
#root.shown { visibility: visible; }
.grow { flex: 1 1 auto; }

/* ---- the board: out to the left and folded when closed, turned 16deg when open ------- */
#board
{
    position: absolute; left: 44dp; top: 150dp; width: 540dp;
    padding: 18dp 0 12dp 0;
    backdrop-filter: blur(18dp) saturate(1.3) brightness(0.85);
    decorator: linear-gradient(160deg, #141a24d0 0%, #0b0f16b8 55%, #090c12c8 100%);
    border-width: 1dp; border-color: #ffffff1c;
    box-shadow: #00000080 0 24dp 60dp 0, #22d8e214 0 0 0 1dp;
    transform-origin: 0% 50%;
    transform: translateX(-620dp) rotateY(58deg);
    opacity: 0;
    transition: transform opacity 0.2s cubic-in;
}
#root.open #board { transform: translateX(0dp) rotateY(16deg); opacity: 1; transition: transform 0.46s back-out, opacity 0.24s cubic-out; }

/* the lit spine on the left edge, and a sheen along the top */
#edge { position: absolute; left: -1dp; top: -1dp; bottom: -1dp; width: 3dp; decorator: linear-gradient(180deg, #22d8e2ff 0%, #22d8e299 45%, #7c5cff66 100%); box-shadow: #22d8e255 0 0 18dp 0; }

/* ---- header ------------------------------------------------------------------------- */
#head { display: flex; flex-direction: row; align-items: flex-end; padding: 0 22dp 0 24dp; }
.head-left { display: block; }
.kicker { display: block; font-family: "Chakra Petch"; font-size: 10dp; letter-spacing: 0.32em; color: #22d8e2; margin-bottom: 2dp; }
.title-line { display: flex; flex-direction: row; align-items: flex-end; }
.title { font-family: "Zen Dots"; font-weight: normal; font-size: 30dp; line-height: 32dp; letter-spacing: 0.04em; color: #f6f8fa; }
.count { font-family: "Roboto Mono"; font-weight: bold; font-size: 15dp; line-height: 18dp; color: #05262a; background-color: #22d8e2; padding: 2dp 8dp; margin-left: 12dp; margin-bottom: 5dp; }
.hold { display: flex; flex-direction: row; align-items: center; font-family: "Chakra Petch"; font-size: 10dp; letter-spacing: 0.24em; color: #7d8794; margin-bottom: 6dp; }
.key { font-family: "Roboto Mono"; font-weight: normal; font-size: 10dp; letter-spacing: 0.08em; color: #22d8e2; border-width: 1dp; border-color: #22d8e266; background-color: #22d8e212; padding: 1dp 6dp; margin-right: 7dp; }

/* ---- the three counts --------------------------------------------------------------- */
#stats { display: flex; flex-direction: row; margin: 14dp 22dp 0 24dp; padding: 9dp 0; border-top-width: 1dp; border-bottom-width: 1dp; border-color: #ffffff12; }
.stat { display: flex; flex-direction: row; align-items: center; margin-right: 22dp; }
.stat-dot { width: 6dp; height: 6dp; border-radius: 3dp; margin-right: 7dp; }
.stat-dot.near { background-color: #2be58b; box-shadow: #2be58b88 0 0 8dp 0; }
.stat-dot.streamed { background-color: #22d8e2; }
.stat-dot.far { background-color: #56606e; }
.stat-num { font-family: "Roboto Mono"; font-size: 14dp; color: #f6f8fa; margin-right: 6dp; }
.stat-label { font-family: "Chakra Petch"; font-size: 9dp; letter-spacing: 0.24em; color: #7d8794; }

/* ---- columns and rows --------------------------------------------------------------- */
#cols { display: flex; flex-direction: row; align-items: center; margin: 10dp 22dp 4dp 24dp; font-family: "Chakra Petch"; font-size: 9dp; letter-spacing: 0.26em; color: #5c6674; }
.c-rank { width: 30dp; }
.c-name { flex: 1 1 auto; padding-left: 44dp; }
.c-id { width: 60dp; text-align: right; }
.c-dist { width: 118dp; text-align: right; }

#rows { display: block; margin: 0 14dp 0 16dp; }
.row
{
    display: flex; flex-direction: row; align-items: center;
    height: 40dp; padding: 0 8dp; margin-bottom: 2dp;
    background-color: #ffffff07;
    border-left-width: 2dp; border-left-color: #ffffff10;
}
.row.enter { opacity: 0; transform: translateX(-34dp); }
#rows.in .row.enter { opacity: 1; transform: translateX(0dp); }

.rank { width: 30dp; font-family: "Roboto Mono"; font-weight: normal; font-size: 11dp; color: #56606e; }
.avatar
{
    width: 30dp; height: 30dp; margin-right: 12dp; flex: 0 0 auto;
    font-family: "Chakra Petch"; font-size: 12dp; line-height: 30dp; text-align: center; letter-spacing: 0.04em;
    border-width: 1dp; background-color: #0a0e14;
}
.who { flex: 1 1 auto; display: block; overflow: hidden; }
.name { display: block; font-size: 17dp; line-height: 19dp; color: #e9edf1; white-space: nowrap; overflow: hidden; }
.crew { font-family: "Chakra Petch"; font-size: 9dp; letter-spacing: 0.18em; color: #7d8794; display: block; line-height: 12dp; }
.pid { width: 60dp; text-align: right; font-family: "Roboto Mono"; font-weight: normal; font-size: 12dp; color: #7d8794; }
.dist { width: 118dp; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; }
.dist-bar { width: 38dp; height: 3dp; margin-right: 9dp; background-color: #ffffff14; }
.dist-fill { height: 3dp; background-color: #22d8e2; }
.dist-text { font-family: "Roboto Mono"; font-weight: normal; font-size: 12dp; color: #c9d1da; min-width: 56dp; text-align: right; }

/* near (25 m), out of range, and the local player */
.row.near { border-left-color: #2be58b; }
.row.near .dist-fill { background-color: #2be58b; }
.row.near .dist-text { color: #2be58b; }
.row.far .name { color: #aab3be; }
.row.far .dist-text { color: #56606e; }
.row.self { background-color: #22d8e21c; border-left-color: #22d8e2; decorator: linear-gradient(90deg, #22d8e22c 0%, #22d8e208 70%, #22d8e200 100%); }
.row.self .name { color: #ffffff; }
.you { font-family: "Chakra Petch"; font-size: 10dp; letter-spacing: 0.22em; color: #05262a; background-color: #22d8e2; padding: 2dp 8dp; }

/* ---- empty and foot ------------------------------------------------------------------ */
#empty { display: none; margin: 18dp 24dp 8dp 24dp; padding: 16dp 0; text-align: center; font-family: "Chakra Petch"; font-size: 11dp; letter-spacing: 0.24em; color: #5c6674; border-width: 1dp; border-color: #ffffff10; }
#root.empty #empty { display: block; }
#foot { display: flex; flex-direction: row; align-items: center; margin: 10dp 22dp 0 24dp; font-family: "Chakra Petch"; font-size: 9dp; letter-spacing: 0.24em; color: #56606e; }
#more { color: #22d8e2; }
<rml>
<head>
    <title>Open//77 freeroam roster</title>
    <link type="text/rcss" href="nui://open77/open77.rcss"/>
    <link type="text/rcss" href="scoreboard.rcss"/>
</head>
<body>
<div id="root">
<!-- the roster slides in from the left edge, turned toward the centre of the screen -->
<div id="board">
    <div id="edge"></div>
    <div id="head">
        <div class="head-left">
            <span class="kicker">// SESSION ROSTER</span>
            <div class="title-line"><span class="title">PLAYERS</span><span id="count" class="count">0</span></div>
        </div>
        <span class="grow"></span>
        <div class="hold"><span class="key">TAB</span><span>HOLD</span></div>
    </div>
    <div id="stats">
        <div class="stat"><span class="stat-dot near"></span><span id="st-near" class="stat-num">0</span><span class="stat-label">NEARBY</span></div>
        <div class="stat"><span class="stat-dot streamed"></span><span id="st-streamed" class="stat-num">0</span><span class="stat-label">IN RANGE</span></div>
        <div class="stat"><span class="stat-dot far"></span><span id="st-far" class="stat-num">0</span><span class="stat-label">IN THE CITY</span></div>
    </div>
    <div id="cols">
        <span class="c-rank">#</span>
        <span class="c-name">PLAYER</span>
        <span class="c-id">ID</span>
        <span class="c-dist">DISTANCE</span>
    </div>
    <div id="rows"></div>
    <div id="empty"><span id="empty-text">WAITING FOR THE SERVER ROSTER</span></div>
    <div id="foot">
        <span id="more"></span>
        <span class="grow"></span>
        <span class="sorted">SORTED BY DISTANCE</span>
    </div>
</div>
</div>
</body>
</rml>
<rml>
<head>
    <title>Open//77 Freeroam speedometer</title>
    <link type="text/rcss" href="nui://open77/open77.rcss"/>
    <link type="text/rcss" href="hud.rcss"/>
</head>
<body data-model="hud">
<!-- its own document: it floats on its own, apart from the vitals and the weapons -->
<div id="hud" data-class-ready="ready" data-class-hidden="hidden" data-class-vehicle="inVehicle">
    <!-- the speedometer: a head-up readout floating beside the car, no panel, turned toward the centre -->
    <div id="vehicle">
        <div id="speedo">
            <div class="hud-row">
                <div class="speed"><span class="speed-lead">{{speedLead}}</span><span class="speed-num">{{speedNum}}</span></div>
                <div class="tells">
                    <span class="tell" data-class-on="airborne">AIR</span>
                    <span class="tell" data-class-on="gear == 'R'">REV</span>
                    <span class="tell" data-class-warn="35 > integrity">DMG</span>
                </div>
            </div>
            <div class="hud-row sub">
                <span class="gear" data-class-rev="gear == 'R'">GEAR {{gear}}</span>
                <span class="grow"></span>
                <span class="unit">KM/H</span>
            </div>
            <div class="rpm-line"><div class="rpm-fill" data-style-width="rpmPct + '%'" data-class-red="rpmPct > 88"></div></div>
        </div>
    </div>
</div>
</body>
</rml>
(() => {
  'use strict';
  const $ = id => document.getElementById('anim-' + id);
  const body = document.getElementById('freeroam-menu');
  const model = FreeroamAnimationCatalog, pageSize = 60;
  const storageKey = 'open77.freeroam.animationFavorites.v1', recentKey = 'open77.freeroam.animationRecents.v1';
  function read(key, max) {
    try { const saved = JSON.parse(localStorage.getItem(key) || '[]');
      return Array.isArray(saved) ? [...new Set(saved.filter(x => typeof x === 'string' && x.length < 256))].slice(0, max) : [];
    } catch (_) { return []; }
  }
  function save(key, value) { try { localStorage.setItem(key, JSON.stringify(value)); } catch (_) {} }
  let items = [], selected = '', category = 'all', busy = false, loaded = false, current = null, signature = '', page = 0;
  let favorites = new Set(read(storageKey, 100)), recents = read(recentKey, 24), lastPlayback = '';
  let catalogBatch = null, catalogRevision = -1;
  const emit = (action, data = {}) => Open77.emit('animations:action', { action, ...data });
  // Decorative category symbols, not fictitious previews of game clips.
  const paths = {
    all: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',
    onthemove: 'M13 4a2 2 0 1 0 4 0 2 2 0 1 0-4 0M8 21l3-8 3 2v6M11 13l-1-5 5-1 3 4 3-1M10 8l-4 3 1 4',
    favorites: 'm12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z',
    recent: 'M3 11a9 9 0 1 1 2 7M3 4v7h7M12 7v5l3 2',
    postures: 'M9 4a3 3 0 1 0 6 0 3 3 0 1 0-6 0M8 22v-8l-3-3 4-3h6l4 3-3 3v8M8 12l8 2M12 15v7',
    gestures: 'M8 21 3 12l3-1 3 4V4h3v7-9h3v9-7h3v10-6h3v8l-4 5Z',
    social: 'M3 4h18v12H9l-6 5ZM7 8h10M7 12h6',
    dance: 'M10 4a2 2 0 1 0 4 0 2 2 0 1 0-4 0M12 7l-2 7 5 3 3 5M10 14l-5 7M4 6l5 3h7l4-5',
    emotions: 'M3 12a9 9 0 1 0 18 0 9 9 0 1 0-18 0M8 9h1M15 9h1M7 14q5 7 10 0',
    relaxation: 'M10 4a2 2 0 1 0 4 0 2 2 0 1 0-4 0M12 7v7M5 9l7 3 7-3M12 14l-9 5h18Z',
    seated: 'M6 3v12h13V9M4 15h17M6 15v7M19 15v7',
    consumables: 'M4 5h12v9a6 6 0 0 1-12 0ZM16 7h3a3 3 0 0 1 0 6h-3M3 22h15',
    work: 'M14 4a6 6 0 0 0-7 8L2 18l4 4 6-6a6 6 0 0 0 8-7l-4 4-5-5Z',
    music: 'M9 18V5l11-3v14M9 8l11-3M3 19a3 2 0 1 0 6 0 3 2 0 1 0-6 0M14 17a3 2 0 1 0 6 0 3 2 0 1 0-6 0',
    interactions: 'M2 10 7 5l5 2 5-2 5 5-5 9-5-3-4 3ZM7 5l-3-2M17 5l3-2M7 12l5-5 5 5-3 3',
  };
  function icon(name) {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 24 24'); svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor'); svg.setAttribute('stroke-width', '1.6');
    svg.setAttribute('stroke-linecap', 'round'); svg.setAttribute('stroke-linejoin', 'round');
    svg.setAttribute('aria-hidden', 'true');
    const path = document.createElementNS(svg.namespaceURI, 'path'); path.setAttribute('d', paths[name] || paths.all); svg.append(path); return svg;
  }
  function select(key) {
    selected = key;
    for (const button of $('grid').querySelectorAll('[data-animation]')) {
      button.setAttribute('aria-pressed', String(button.dataset.animation === key ||
        (button.dataset.group && button.dataset.group === items.find(x => x.key === key)?.profile)));
    }
    renderSelection();
  }
  function renderSelection() {
    const item = items.find(x => x.key === selected), siblings = item ? items.filter(x => x.profile === item.profile) : [];
    $('selected').textContent = item ? item.label + ' · ' + item.variant : 'Choose an animation';
    $('selected').title = $('selected').textContent;
    $('detail').textContent = model.describe(item);
    $('tested').textContent = item?.tested ? 'Default cigarette: local male check recorded' : 'Asset-verified · Runtime coverage experimental';
    $('clip').textContent = item?.clip || '';
    $('play').disabled = !item || busy; $('play').textContent = busy ? 'Starting…' : '▶ Play';
    $('favorite').disabled = !item;
    $('favorite').textContent = favorites.has(selected) ? '★' : '☆';
    $('favorite').setAttribute('aria-pressed', String(favorites.has(selected)));
    $('variant-count').textContent = siblings.length ? (siblings.findIndex(x => x.key === selected) + 1) + '/' + siblings.length : '—';
    $('variant-prev').disabled = $('variant-next').disabled = siblings.length < 2 || busy;
  }
  function renderFilters() {
    const fragment = document.createDocumentFragment();
    const definitions = { all: 'All animations', favorites: 'Favourites', recent: 'Recent', ...model.categories };
    if (items.some(x => x.category === 'other')) definitions.other = 'Other';
    for (const [key, label] of Object.entries(definitions)) {
      const subset = model.filter(items, key, '', favorites, recents);
      if (!['all', 'favorites', 'recent'].includes(key) && !subset.length) continue;
      const button = document.createElement('button'); button.type = 'button';
      button.setAttribute('aria-label', label); button.title = label; button.dataset.category = key;
      const title = document.createElement('span'); title.textContent = label;
      const count = document.createElement('small'); count.textContent = ['favorites', 'recent'].includes(key) ? subset.length : new Set(subset.map(x => x.profile)).size;
      button.append(icon(key), title, count); button.setAttribute('aria-pressed', String(key === category));
      button.addEventListener('click', () => { category = key; page = 0; renderFilters(); renderCards(true); });
      fragment.append(button);
    }
    $('filters').replaceChildren(fragment);
  }
  function renderCards(resetScroll = false) {
    let visible = model.filter(items, category, $('search').value, favorites, recents);
    const grouped = !$('variants').checked && !$('search').value.trim() && !['favorites', 'recent'].includes(category);
    if (category === 'recent') visible.sort((a,b) => recents.indexOf(a.key) - recents.indexOf(b.key));
    if (grouped) visible = model.families(visible);
    if (category !== 'recent') model.order(visible, category);
    const pages = Math.max(1, Math.ceil(visible.length / pageSize));
    page = Math.min(page, pages - 1);
    $('pagination').hidden = pages < 2;
    $('page').textContent = (page + 1) + ' / ' + pages;
    $('prev').disabled = page === 0; $('next').disabled = page + 1 === pages;
    $('total').textContent = loaded ? items.length : '—';
    $('count').textContent = loaded ? visible.length + (grouped ? ' animations' : ' variants') : 'Loading collection…';
    $('loading').hidden = loaded;
    $('empty').hidden = visible.length > 0 || !loaded; $('grid').hidden = !visible.length;
    $('empty-title').textContent = category === 'favorites' ? 'YOUR FAVOURITES' : category === 'recent' ? 'RECENT ANIMATIONS' : 'NO MATCHES';
    $('empty-text').textContent = category === 'favorites' ? 'Star a variant to find it here.' : category === 'recent' ? 'Successfully started animations appear here.' : 'Try another name or reset the filters.';
    const fragment = document.createDocumentFragment();
    const pageItems = visible.slice(page * pageSize, (page + 1) * pageSize);
    const selectedProfile = items.find(x => x.key === selected)?.profile;
    if (!pageItems.some(x => x.key === selected || (grouped && x.profile === selectedProfile)))
      selected = pageItems[0]?.key || '';
    for (const item of pageItems) {
      const card = document.createElement('article'); card.className = 'anim-card';
      const button = document.createElement('button'); button.type = 'button'; button.className = 'anim-card-select';
      button.dataset.animation = item.key; if (grouped) button.dataset.group = item.profile;
      button.title = item.label + ' · ' + item.variant;
      const title = document.createElement('strong'); title.textContent = item.label;
      const subtitle = document.createElement('small'); subtitle.textContent = grouped ? item.variants + (item.variants === 1 ? ' variant' : ' variants') : item.variant;
      button.append(icon(item.category), title, subtitle);
      button.addEventListener('click', () => select(item.key));
      button.addEventListener('dblclick', () => { select(item.key); play(); });
      const star = document.createElement('button'); star.type = 'button'; star.className = 'anim-star'; star.append(icon('favorites'));
      star.setAttribute('aria-label', 'Favourite ' + item.label + ', ' + item.variant);
      star.setAttribute('aria-pressed', String(favorites.has(item.key)));
      star.addEventListener('click', () => {
        if (favorites.has(item.key)) favorites.delete(item.key);
        else { if (favorites.size >= 100) favorites.delete(favorites.values().next().value); favorites.add(item.key); }
        save(storageKey, [...favorites]); renderFilters();
        if (category === 'favorites') { renderCards(); $('search').focus(); }
        else star.setAttribute('aria-pressed', String(favorites.has(item.key)));
      });
      card.append(button, star); fragment.append(card);
    }
    $('grid').replaceChildren(fragment);
    if (resetScroll) $('grid').scrollTop = 0;
    if (!items.some(x => x.key === selected)) selected = visible[0]?.key || '';
    select(selected);
  }
  function renderCurrent() {
    const step = (Array.isArray(current?.steps) ? current.steps : [])[Number(current?.step) || 0];
    const action = items.find(x => x.profile === step?.profile && x.clip === step?.clip);
    $('status').textContent = busy ? 'STARTING' : current?.active ? 'PLAYING' : 'READY';
    $('current').textContent = current?.active ? action?.label || step?.profile || 'Role-play action' : 'No active animation';
    $('stop').disabled = !busy && !current?.active;
    $('current').closest('.anim-current').classList.toggle('active', busy || !!current?.active);
    // History records authoritative acceptance, never a failed click.
    const playback = current?.active && action ? current.playbackId + ':' + action.key : '';
    if (playback && playback !== lastPlayback) {
      lastPlayback = playback; recents = [action.key, ...recents.filter(x => x !== action.key)].slice(0,24);
      save(recentKey, recents); renderFilters(); if (category === 'recent') renderCards();
    }
    renderSelection();
  }
  function play() {
    const item = items.find(x => x.key === selected); if (!item || busy) return;
    busy = true; renderCurrent();
    emit('play', { profile:item.profile, clip:item.clip, loop:$('loop').checked, durationMs:Number($('duration').value) });
  }
  function open() {
    body.dispatchEvent(new CustomEvent('freeroam:navigate', { detail: 'animations' }));
    $('search').focus({ preventScroll:true });
  }
  $('search').addEventListener('input', () => { page = 0; renderCards(true); });
  $('variants').addEventListener('change', () => { page = 0; renderCards(true); });
  $('reset').addEventListener('click', () => { category='all'; page=0; $('search').value=''; renderFilters(); renderCards(true); $('search').focus(); });
  $('retry').addEventListener('click', () => emit('refresh'));
  $('favorite').addEventListener('click', () => {
    if (!items.some(x => x.key === selected)) return;
    if (favorites.has(selected)) favorites.delete(selected);
    else { if (favorites.size >= 100) favorites.delete(favorites.values().next().value); favorites.add(selected); }
    save(storageKey, [...favorites]); renderFilters(); renderCards();
  });
  $('prev').addEventListener('click', () => { page--; renderCards(true); });
  $('next').addEventListener('click', () => { page++; renderCards(true); });
  for (const [id, direction] of [['variant-prev',-1],['variant-next',1]]) $(id).addEventListener('click', () => {
    const item=items.find(x=>x.key===selected), siblings=items.filter(x=>x.profile===item?.profile);
    if (siblings.length && !busy) select(siblings[(siblings.findIndex(x=>x.key===selected)+direction+siblings.length)%siblings.length].key);
  });
  $('loop').addEventListener('change', () => { $('duration-wrap').hidden=$('loop').checked; });
  for (const button of $('duration-wrap').querySelectorAll('[data-duration]')) button.addEventListener('click', () => {
    $('duration').value=button.dataset.duration;
    for (const option of $('duration-wrap').querySelectorAll('[data-duration]')) option.setAttribute('aria-pressed',String(option===button));
  });
  $('close').addEventListener('click', () => Open77.emit('freeroam:close',{}));
  $('back').addEventListener('click', () => body.querySelector('.tab[data-tab=vehicles]').click());
  $('stop').addEventListener('click', () => emit('stop')); $('play').addEventListener('click', play);
  document.addEventListener('keydown', event => {
    if (!body.classList.contains('open') || !body.classList.contains('animation-mode') || !document.getElementById('idle-panel').hidden) return;
    if (event.key==='/' && !['INPUT','TEXTAREA'].includes(document.activeElement?.tagName)) { event.preventDefault(); $('search').focus(); }
  });
  Open77.on('animations:open', open);
  Open77.on('animations:catalog', message => {
    if (!message || !Number.isSafeInteger(message.revision) || message.revision <= catalogRevision ||
        !Number.isInteger(message.total) || message.total < 1 || message.total > 256 ||
        !Number.isInteger(message.batch) || message.batch < 1 || message.batch > message.total ||
        !Array.isArray(message.profiles) || message.profiles.length > 4) return;
    if (catalogBatch && message.revision < catalogBatch.revision) return;
    if (!catalogBatch || catalogBatch.revision !== message.revision)
      catalogBatch = { revision:message.revision, total:message.total, pages:new Map() };
    if (catalogBatch.total !== message.total) return;
    catalogBatch.pages.set(message.batch, message.profiles);
    if (catalogBatch.pages.size !== catalogBatch.total) return;
    const catalog=[];
    for (let i=1;i<=catalogBatch.total;i++) catalog.push(...catalogBatch.pages.get(i));
    catalogRevision=message.revision; catalogBatch=null; updateCatalog(catalog); loaded=true;
    renderFilters(); renderCards(); renderCurrent();
  });
  function updateCatalog(catalog) {
    signature=JSON.stringify(catalog); items=model.entries(catalog);
    if (!items.some(x=>x.key===selected)) selected=(items.find(x=>x.profile==='armscrossed'&&x.isDefault)||items[0])?.key||'';
  }
  Open77.on('animations:state', state => {
    if (!state || typeof state!=='object') return;
