.idle-tabs{display:flex;gap:8px;padding:10px 20px;border-bottom:1px solid #ffffff10;flex-shrink:0}.idle-tabs button{border:0;background:transparent;color:#8495a8;padding:9px 12px;border-radius:5px;font-size:12px!important}.idle-tabs button[aria-pressed=true]{color:#40e1dc;background:#27ddd112}.idle-tabs span{font:8px var(--font-mono);margin-left:8px;opacity:.7}
#idle-panel{display:flex;flex-direction:column;flex:1;min-height:0;overflow:auto}#idle-panel input{min-width:0;color:#dce9f2;background:#050b1266;border:1px solid #ffffff18;border-radius:5px;padding:9px;font-size:11px}#idle-panel button{color:#c2d3df;background:#ffffff05;border:1px solid #ffffff15;border-radius:5px;padding:8px;font-size:11px}#idle-panel button:hover{border-color:#2bd7cf88;background:#2bd7cf0c}#idle-panel label{color:#8da1b2;font-size:10px}#idle-panel kbd{padding:2px 4px;border:1px solid #ffffff24;border-radius:3px}
.idle-intro{padding:16px 20px 12px;flex-shrink:0}.idle-intro h3{font-size:22px;color:#eaf6ff;margin:5px 0}.idle-intro p{font-size:11px;line-height:1.65;color:#8b9eaf;margin:0;max-width:600px}.idle-browser{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);flex:1;min-height:155px;gap:16px;padding:8px 20px}.idle-banks,.idle-clips{display:flex;flex-direction:column;min-width:0;gap:9px;min-height:0}.idle-banks>label,.idle-clips>label{font:9px var(--font-mono);letter-spacing:.08em;color:#44d8d2!important}.idle-path{display:flex;gap:6px}.idle-path input{flex:1;width:100%}
#idle-bank-list,#idle-clip-list{display:flex;flex-direction:column;gap:4px;overflow:auto;flex:1;min-height:65px;scrollbar-width:thin}#idle-bank-list button,#idle-clip-list button{text-align:left;flex-shrink:0;overflow-wrap:anywhere}#idle-bank-list strong{display:block;font-size:10px;font-weight:500}#idle-bank-list small{display:block;font-size:8px;color:#778b9f;margin-top:4px}#idle-panel button[aria-pressed=true]{border-color:#2bd7cf99;background:#2bd7cf15;color:#5fe9df}#idle-clip-list button{display:flex;justify-content:space-between;gap:10px}#idle-clip-list small{white-space:nowrap;color:#718b9e}#idle-clip-list p{font-size:11px;color:#728a9e;line-height:1.6;padding:12px}.idle-pagination{display:flex;align-items:center;justify-content:space-between;color:#7890a2;font-size:9px}.idle-pagination button{padding:4px 10px!important}
.idle-footer{border-top:1px solid #ffffff10;padding:12px 20px;flex-shrink:0}.idle-footer>label{display:flex;align-items:center;gap:12px}.idle-footer>label input{flex:1}.idle-controls{display:flex;gap:10px;align-items:center;margin-top:10px}.idle-controls label{display:flex;gap:7px;align-items:center}.idle-controls input[type=number]{width:72px;padding:6px!important}#idle-reset{margin-left:auto}#idle-apply{color:#07151a!important;background:#35d8ce!important;border-color:#35d8ce!important;font-weight:700!important}#idle-status{font-size:11px;color:#53d9d2;margin:10px 0 4px;overflow-wrap:anywhere}#idle-status[data-error=true]{color:#ffb07b}.idle-note{color:#6c8294;font-size:9px;line-height:1.5;margin:0}
@media(max-height:780px){.idle-intro{padding-top:8px;padding-bottom:4px}.idle-intro h3{font-size:18px}.idle-intro p{font-size:10px}.idle-footer{padding-top:8px}.idle-note{display:none}}
@media(max-width:1100px){.idle-controls{flex-wrap:wrap;gap:6px}.idle-controls label{font-size:9px!important}.idle-intro p{max-width:90%}.idle-browser{gap:8px;padding:8px 12px}.idle-tabs{padding:6px 12px}.idle-footer{padding:10px 12px}}
(() => {
  'use strict';
  const $ = name => document.getElementById('idle-' + name), root = document.getElementById('page-animations');
  const banks = (window.FreeroamAnimationBanks || []).map(path => ({path, search:path.toLowerCase(), name:path.split('\\').pop().replace(/\.anims$/, '')}));
  let bankPage=0, clipPage=0, request=0, total=0, busy=false, loadedBank='', debounce;
  const size=30, emit=(action,data={})=>Open77.emit('idle:action',{action,...data});
  function status(message,error=false) { $('status').textContent=message; $('status').dataset.error=String(error); }
  function tab(idle) {
    $('panel').hidden=!idle; root.querySelector('.anim-library').hidden=idle; root.querySelector('.anim-player').hidden=idle;
    $('tab-emotes').setAttribute('aria-pressed',String(!idle)); $('tab-poses').setAttribute('aria-pressed',String(idle));
    if (idle) { renderBanks(); emit('state'); }
  }
  function renderBanks() {
    const words=$('search').value.toLowerCase().trim().split(/\s+/), filtered=banks.filter(b=>words.every(w=>b.search.includes(w)));
    bankPage=Math.min(bankPage,Math.max(0,Math.ceil(filtered.length/size)-1)); $('bank-list').replaceChildren();
    for (const bank of filtered.slice(bankPage*size,(bankPage+1)*size)) {
      const button=document.createElement('button'), name=document.createElement('strong'), path=document.createElement('small');
      button.type='button'; button.title=bank.path; button.setAttribute('aria-pressed',String(bank.path===$('bank').value));
      name.textContent=bank.name.replaceAll('_',' '); path.textContent=bank.path.split('\\').slice(-3,-1).join(' / ');
      button.append(name,path); button.addEventListener('click',()=>{ $('bank').value=bank.path; $('clip').value=''; $('clip-search').value=''; clipPage=0; renderBanks(); load(); }); $('bank-list').append(button);
    }
    $('bank-count').textContent=`${filtered.length.toLocaleString()} banks · ${bankPage+1}/${Math.max(1,Math.ceil(filtered.length/size))}`;
    $('bank-prev').disabled=bankPage===0; $('bank-next').disabled=(bankPage+1)*size>=filtered.length;
  }
  function load() {
    const bank=$('bank').value.trim(); if (!bank) { status('Choose a bank or paste its depot path.',true); return; }
    request++; loadedBank=bank; $('clip-list').replaceChildren(); const p=document.createElement('p'); p.textContent='Reading clips from the game…'; $('clip-list').append(p);
    $('clip-prev').disabled=$('clip-next').disabled=true;
    emit('clips',{request,bank,query:$('clip-search').value,offset:clipPage*size});
  }
  function buttons() { $('apply').disabled=busy; $('reset').disabled=busy; }
  $('tab-emotes').addEventListener('click',()=>tab(false)); $('tab-poses').addEventListener('click',()=>tab(true));
  $('search').addEventListener('input',()=>{bankPage=0;renderBanks();});
  $('bank-prev').addEventListener('click',()=>{bankPage--;renderBanks();}); $('bank-next').addEventListener('click',()=>{bankPage++;renderBanks();});
  $('load').addEventListener('click',()=>{clipPage=0;load();}); $('bank').addEventListener('keydown',e=>{if(e.key==='Enter'){clipPage=0;load();}});
  $('clip-search').addEventListener('input',()=>{clearTimeout(debounce);debounce=setTimeout(()=>{clipPage=0;load();},250);});
  $('clip-prev').addEventListener('click',()=>{clipPage--;load();}); $('clip-next').addEventListener('click',()=>{clipPage++;load();});
  $('apply').addEventListener('click',()=>{
    const animset=$('bank').value.trim(), clip=$('clip').value.trim();
    if (!animset || !clip) {status('Enter a bank path and a clip name first.',true);return;}
    if (!$('blend').reportValidity() || !$('delay').reportValidity()) return;
    busy=true;buttons();status('Applying idle…');emit('apply',{animset,clip,blendMs:Number($('blend').value),delayMs:Number($('delay').value)});
  });
  $('reset').addEventListener('click',()=>{busy=true;buttons();status('Restoring default idle…');emit('reset');});
  Open77.on('idle:clips',r=>{
    if (!r || r.request!==request || r.bank!==loadedBank) return;
    $('clip-list').replaceChildren(); total=r.total||0;
    if (r.error) {const p=document.createElement('p');p.textContent=r.error;$('clip-list').append(p);status(r.error,true);}
    else for (const clip of r.clips||[]) {
      const button=document.createElement('button'), name=document.createElement('span'), duration=document.createElement('small');button.type='button';
      name.textContent=clip.name;duration.textContent=Number(clip.duration).toFixed(2)+' s';button.append(name,duration);button.setAttribute('aria-pressed',String($('clip').value===clip.name));
      button.addEventListener('click',()=>{ $('clip').value=clip.name; for(const b of $('clip-list').children)b.setAttribute('aria-pressed',String(b===button)); });$('clip-list').append(button);
    }
    if (!r.error && !total) {const p=document.createElement('p');p.textContent='No clips match this search.';$('clip-list').append(p);}
    $('clip-count').textContent=`${total} clips · ${clipPage+1}/${Math.max(1,Math.ceil(total/size))}`;
    $('clip-prev').disabled=clipPage===0; $('clip-next').disabled=(clipPage+1)*size>=total;
  });
  Open77.on('idle:state',r=>{
    if (!r) return; busy=false;buttons(); if(r.error){status(r.error,true);return;}
    const s=r.state; status(s?`${s.options.clip} · ${s.status||'selected'}`:'Default idle · No custom pose selected');
  });
  // Poll only while this panel is visible; a selected pose keeps working with the UI closed.
  setInterval(()=>{if (!$('panel').hidden && document.getElementById('freeroam-menu').classList.contains('open'))emit('state');},1500);
  renderBanks();
})();
/* Compact offline RP library; shared Freeroam is unchanged outside animation-mode. */
#page-animations [hidden]{display:none!important}
.freeroam-menu.animation-mode .scrim{background:linear-gradient(90deg,#060b1280,transparent 75%);backdrop-filter:none}
.freeroam-menu.animation-mode .drawer{inset:7vh auto 7vh 24px;width:min(880px,68vw);border:1px solid #ffffff16;border-radius:12px;clip-path:none;background:#0b111bef;box-shadow:0 20px 70px #0008}
.freeroam-menu.animation-mode .drawer::after,.freeroam-menu.animation-mode .drawer-edge,.freeroam-menu.animation-mode .head,.freeroam-menu.animation-mode .tabs{display:none}
.freeroam-menu.animation-mode .pages{padding:0;overflow:hidden}
.freeroam-menu.animation-mode .foot{display:none}
#page-animations{height:100%;min-height:0;gap:0;color:var(--text-primary);font-family:var(--font-body)}
#page-animations button,#page-animations input{font:inherit}
#page-animations button{cursor:pointer}
#page-animations button:disabled{opacity:.35;cursor:not-allowed}
#page-animations :focus-visible{outline:2px solid var(--o-cyan-500);outline-offset:-2px}
.anim-header{display:flex;align-items:center;gap:14px;padding:20px;border-bottom:1px solid #ffffff0d;flex-shrink:0}
.anim-header>div{flex:1}
.anim-eyebrow{font:500 9px var(--font-mono);color:#7b8a9c;letter-spacing:.13em}
.freeroam-menu .anim-header h2{font:800 27px/1.3 var(--font-display);margin-top:3px}
.freeroam-menu .anim-header h2::before{content:none}
.anim-header h2 span{color:var(--o-cyan-500)}
.anim-total{font-size:11px;color:#8391a2;white-space:nowrap}.anim-total strong{color:#d5dfe8}
.anim-icon-button{width:30px;height:30px;border:1px solid #ffffff12;border-radius:6px;background:#ffffff04;color:#92a1b2}
.anim-icon-button:hover{color:white;background:#ffffff12}
.anim-library{display:grid;grid-template-columns:150px minmax(0,1fr);flex:1;min-height:0}
.anim-filters{display:flex;flex-direction:column;gap:4px;padding:14px 8px;border-right:1px solid #ffffff0d;overflow-y:auto;scrollbar-width:thin}
.anim-filters button{display:flex;align-items:center;gap:9px;flex-shrink:0;min-height:38px;padding:8px;background:none;border:1px solid transparent;border-radius:6px;color:#8e9bad;text-align:left;font-size:11px!important}
.anim-filters button svg{width:16px;height:16px;flex-shrink:0}
.anim-filters button small{margin-left:auto;color:#68798a;font:9px var(--font-mono)}
.anim-filters button:hover{background:#ffffff06;color:#eef5ff}
.anim-filters button[aria-pressed=true]{background:#22d8e211;border-color:#22d8e225;color:var(--o-cyan-500)}
.anim-content{display:flex;flex-direction:column;min-height:0;min-width:0;padding:16px;gap:12px}
.anim-searchbar{display:flex;align-items:center;flex-shrink:0;gap:10px;padding:0 11px;min-height:38px;border:1px solid #ffffff14;border-radius:6px;background:#0003;color:#8391a2}
.anim-searchbar:focus-within{border-color:#22d8e280}
#anim-search{width:100%;min-width:0;background:none;border:0;color:#ecf5ff;font-size:12px!important;outline:none!important;box-shadow:none!important}
.anim-searchbar kbd{font:10px var(--font-mono);opacity:.5}
.anim-list-head{display:flex;justify-content:space-between;align-items:center;gap:8px;color:#8190a2;font-size:10px}
.anim-list-head label{white-space:nowrap;display:flex;align-items:center;gap:5px;cursor:pointer}
#page-animations input[type=checkbox]{accent-color:var(--o-cyan-500);width:13px;height:13px}
.anim-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;align-content:start;flex:1;min-height:0;overflow-y:auto;padding:2px;scrollbar-width:thin;scrollbar-color:#31505d transparent}
.anim-card{position:relative;min-width:0;height:92px}
.anim-card-select{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:5px;width:100%;height:100%;padding:12px!important;text-align:left;border:1px solid #ffffff0b;border-radius:7px;background:#ffffff04;color:#dce5ef;transition:border-color .13s,background .13s,transform .13s}
.anim-card-select>svg{width:18px;height:18px;color:#71879a}
.anim-card-select strong{width:100%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:11px;font-weight:600;padding-right:7px}
.anim-card-select small{color:#7a8b9e;font-size:10px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.anim-card-select:hover{background:#ffffff0a;border-color:#22d8e260;transform:translateY(-1px)}
.anim-card-select[aria-pressed=true]{background:#22d8e210;border-color:#22d8e270}
.anim-card-select[aria-pressed=true]>svg{color:var(--o-cyan-500)}
.anim-star{position:absolute;top:5px;right:5px;width:26px;height:26px;color:#607082;background:transparent;border:0;border-radius:4px}
.anim-star:hover,.anim-star[aria-pressed=true]{color:#f0c572;background:#ffffff08}
.anim-star svg{width:14px;height:14px}.anim-star[aria-pressed=true] svg{fill:currentColor}
.anim-pagination{display:flex;align-items:center;justify-content:center;gap:12px;flex-shrink:0;color:#8794a5;font:10px var(--font-mono)}
.anim-pagination button,.anim-variant-stepper button{width:27px;height:26px;border:1px solid #ffffff16;background:#ffffff04;color:#bed0df;border-radius:4px}
.anim-player{position:relative;flex-shrink:0;padding:0 18px 13px;border-top:1px solid #ffffff10;background:#0a1019}
.anim-current{display:flex;align-items:center;gap:8px;min-height:36px;border-bottom:1px solid #ffffff09;font-size:10px;color:#788a9d}
.anim-current strong{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:400}
.anim-signal{height:5px;width:5px;border-radius:50%;background:#596977;flex-shrink:0}
.anim-current.active .anim-signal{background:var(--o-cyan-500);box-shadow:0 0 8px #22d8e250}
#anim-status{font:8px var(--font-mono);color:#97a7b8}
#anim-stop{padding:4px 9px;border:1px solid #ff718430;border-radius:4px;color:#ff96a5;background:#ff718408;font-size:10px!important}
#anim-stop:hover:enabled{background:#ff71841a}
.anim-selection{display:flex;align-items:center;gap:12px;padding:12px 0 10px}
.anim-selection-copy{flex:1;min-width:0}
#anim-selected{display:block;font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#anim-detail{margin-top:4px;font-size:10px;line-height:1.4;color:#8e9eaf}
.anim-variant-stepper{display:flex;align-items:center;gap:7px}
#anim-variant-count{font:10px var(--font-mono);color:#8e9eaf;white-space:nowrap}
#anim-play{padding:10px 19px;border:1px solid #22d8e260;background:var(--o-cyan-500);color:#072127;border-radius:5px;font-size:11px!important;font-weight:700!important;min-width:88px;transition:filter .13s}
#anim-play:hover:enabled{filter:brightness(1.17)}
.anim-options{display:flex;align-items:center;gap:12px;font-size:10px;color:#8495a8}
.anim-options label{display:flex;align-items:center;gap:6px;cursor:pointer}
.anim-help{flex:1;text-align:right;font-size:9px}
.anim-duration-buttons{display:flex;gap:3px}
.anim-duration-buttons button{font-size:9px!important;padding:3px 6px;border:1px solid #ffffff12;color:#98a8b8;background:none;border-radius:3px}
.anim-duration-buttons button[aria-pressed=true]{color:var(--o-cyan-500);border-color:#22d8e260}
#anim-details summary{cursor:pointer}
#anim-details>div{position:absolute;left:12px;right:12px;bottom:40px;padding:15px;border:1px solid #33495e;background:#101b29;border-radius:7px;box-shadow:0 -10px 40px #0009;line-height:1.6;z-index:5}
#anim-clip{display:block;overflow-wrap:anywhere;color:#b8d1e4;margin:7px 0;user-select:text}
#anim-tested{color:#e9bf73}
.anim-empty{flex:1;text-align:center;padding:30px 10px;color:#8293a5;font-size:12px}
.anim-empty strong{color:#dbe7f3;font-size:14px}.anim-empty p{margin:10px 0 15px;line-height:1.6}
#anim-reset,#anim-retry{padding:7px 12px;border:1px solid #ffffff20;background:#ffffff05;color:#bbcbdc;border-radius:4px;font-size:11px!important}
.anim-message{padding:8px 10px!important;background:#edbe6710;color:#ecc888;border-left:2px solid #edbe67;border-radius:3px;font-size:11px}
.anim-loading{display:flex;align-items:center;flex-wrap:wrap;gap:10px;padding:20px 5px;font-size:12px;color:#98a9bb}
.anim-spinner{width:15px;height:15px;border:2px solid #22d8e225;border-top-color:var(--o-cyan-500);border-radius:50%;animation:anim-spin .8s linear infinite}
@keyframes anim-spin{to{transform:rotate(360deg)}}
@media(max-width:1100px){.freeroam-menu.animation-mode .drawer{width:min(800px,88vw)}}
@media(max-width:650px){.freeroam-menu.animation-mode .drawer{inset:12px;width:auto}.anim-library{grid-template-columns:48px minmax(0,1fr)}.anim-filters{padding:10px 4px}.anim-filters button{padding:10px;justify-content:center}.anim-filters button span,.anim-filters button small{display:none}.anim-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.anim-content{padding:10px}.anim-header{padding:13px}.anim-help{display:none}#anim-details{margin-left:auto}.anim-total{display:none}.anim-player{padding:0 10px 10px}.anim-selection{gap:6px}#anim-play{padding:9px;min-width:62px}}
@media(max-height:620px){.freeroam-menu.animation-mode .drawer{top:10px;bottom:10px}.anim-header{padding:10px 14px}.anim-card{height:78px}.anim-current{min-height:29px}.anim-header h2{font-size:22px!important}}
@media(prefers-reduced-motion:reduce){#page-animations *{animation:none!important;transition:none!important}}
/* Freeroam workspace. Activity overlays own their layout; no wrapping tab bar. */
.freeroam-menu * { margin: 0; padding: 0; }
.freeroam-menu { display: none; user-select: none; --menu-muted: #97a7b6; }
.freeroam-menu.open { display: block; }
.freeroam-menu [hidden] { display: none !important; }
.freeroam-menu .scrim { position: fixed; inset: 0; background: #0309109c; backdrop-filter: blur(7px); animation: ds-fade .2s ease-out; }
.freeroam-menu .drawer { position: absolute; display: flex; flex-direction: column; overflow: hidden; background: #0b1118f5; border: 1px solid #739aaa30; border-radius: 14px; box-shadow: 0 32px 100px #0008; }
.freeroam-menu:not(.animation-mode) .drawer { inset: max(24px, 6vh) max(28px, calc((100vw - 1260px) / 2)); display: grid; grid-template: "head head" 90px "nav pages" minmax(0, 1fr) "foot foot" 44px / 220px minmax(0, 1fr); animation: ds-rise .24s ease-out; }
.freeroam-menu .head { grid-area: head; display: flex; align-items: center; gap: 28px; padding: 0 30px; border-bottom: 1px solid #ffffff0c; background: linear-gradient(100deg, #16303d55, transparent 60%); }
.freeroam-menu .head-copy { display: flex; align-items: center; gap: 22px; }
.freeroam-menu .menu-brand { padding-right: 22px; border-right: 1px solid #ffffff1a; color: #b2c3cf; font: 700 12px var(--font-ui); letter-spacing: -.03em; white-space: nowrap; }
.freeroam-menu .menu-brand span { color: var(--o-cyan-500); }
.freeroam-menu .head h1 { font: 700 26px/1.2 var(--font-display); letter-spacing: -.03em; }
.freeroam-menu .head h1 span { color: var(--o-cyan-500); }
.freeroam-menu .head-caption { color: var(--menu-muted); font: 14px var(--font-body); }
.freeroam-menu .close { display: flex; align-items: center; justify-content: center; flex-shrink: 0; gap: 12px; margin-left: auto; padding: 9px 12px; border: 1px solid #ffffff12; border-radius: 7px; color: #bdcbd5; background: #ffffff03; font: 12px var(--font-ui); cursor: pointer; transition: background .15s, border-color .15s; }
.freeroam-menu .close b { font: 24px/1 var(--font-body); }
.freeroam-menu .close:hover { background: #ffffff0a; border-color: #ffffff35; color: white; }
.freeroam-menu kbd { padding: 3px 5px; border: 1px solid #ffffff20; border-radius: 3px; color: var(--menu-muted); font: 10px var(--font-mono); }
.freeroam-menu .tabs { grid-area: nav; display: flex; flex-direction: column; gap: 22px; min-height: 0; padding: 23px 14px; border-right: 1px solid #ffffff0c; overflow-y: auto; background: #060d144a; }
.freeroam-menu .nav-group { display: flex; flex-direction: column; gap: 4px; flex-shrink: 0; }
.freeroam-menu .nav-label { padding: 0 12px 9px; color: #718696; font: 500 9px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
.freeroam-menu .tab { position: relative; display: flex; align-items: center; gap: 12px; min-height: 44px; flex: 0 0 auto; padding: 10px 12px; border: 1px solid transparent; border-radius: 6px; background: none; color: #a4b3c0; text-align: left; font: 500 14px/1.2 var(--font-ui); cursor: pointer; transition: color .15s, background .15s, border-color .15s; }
.freeroam-menu .tab svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; opacity: .8; }
.freeroam-menu .tab span { flex: 1; }
.freeroam-menu .tab i { font: 17px/1 var(--font-body); opacity: .35; }
.freeroam-menu .tab:hover { color: #f4f8fc; background: #ffffff06; }
.freeroam-menu .tab.active { background: linear-gradient(100deg, #22d8e216, #22d8e208); border-color: #22d8e223; color: #56e4ec; }
.freeroam-menu .tab.active::before { content: ""; position: absolute; left: -15px; width: 3px; height: 20px; border-radius: 0 2px 2px 0; background: var(--o-cyan-500); }
.freeroam-menu .tab.active svg, .freeroam-menu .tab.active i { opacity: 1; }
.freeroam-menu .tab:active { background: #22d8e221; }
.freeroam-menu .pages { grid-area: pages; position: relative; flex: 1; min-width: 0; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 32px 36px 36px; overscroll-behavior: contain; }
.freeroam-menu .pages, .freeroam-menu .tabs, .freeroam-menu .catalog-grid { scrollbar-width: thin; scrollbar-color: #3d6270 transparent; }
.freeroam-menu .page { display: none; min-width: 0; flex-direction: column; gap: 16px; }
.freeroam-menu .page.active { display: flex; animation: menu-content-in .18s ease-out; }
.freeroam-menu .section-head { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 8px; }
.freeroam-menu .section-head[data-kicker]::before { content: attr(data-kicker); margin-bottom: 3px; color: var(--o-cyan-500); font: 500 10px var(--font-mono); letter-spacing: .12em; }
.freeroam-menu h2 { font: 650 32px/1.16 var(--font-display); letter-spacing: -.035em; color: #edf4f8; }
.freeroam-menu .section-head.compact { margin: 16px 0 0; padding-top: 22px; border-top: 1px solid #ffffff0d; }
.freeroam-menu .section-head.compact h2 { font-size: 19px; letter-spacing: -.015em; text-transform: none; }
.freeroam-menu .hint { max-width: 72ch; color: var(--menu-muted); font: 15px/1.55 var(--font-body); }
.freeroam-menu .hint:empty { display: none; }
.freeroam-menu .field-label { color: #c3d0da; font: 500 12px/1.2 var(--font-ui); }
.freeroam-menu .catalog-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 8px; }
.freeroam-menu .catalog-heading > span { color: #88a1b3; font: 11px var(--font-mono); }
.freeroam-menu .stat-strip { padding: 13px 16px; border: 1px solid #ffffff0d; border-radius: 6px; background: #17273255; color: #9fb5c4; font: 11px/1.65 var(--font-mono); overflow-wrap: anywhere; }
.freeroam-menu .stat-strip.signal { color: #66dcb7; border-color: #66dcb733; }
.freeroam-menu input[type="text"], .freeroam-menu input[type="search"], .freeroam-menu select { min-width: 0; width: 100%; min-height: 44px; padding: 11px 14px; border: 1px solid #ffffff1c; border-radius: 6px; background: #050b1280; color: #edf4f8; font: 14px/1.3 var(--font-body); outline: none; transition: border-color .15s, background .15s; }
.freeroam-menu input::placeholder { color: #718697; }
.freeroam-menu input:focus { border-color: #22d8e280; background: #0b1b25; }
.freeroam-menu :focus-visible { outline: 2px solid var(--o-cyan-500); outline-offset: -2px; box-shadow: none; }
.freeroam-menu .filters { display: flex; flex-wrap: wrap; gap: 6px; }
.freeroam-menu .filters button, .freeroam-menu .slot-picker button { min-height: 32px; padding: 7px 13px; border: 1px solid #ffffff12; border-radius: 5px; background: #ffffff03; color: #9eafbd; font: 12px/1.2 var(--font-ui); cursor: pointer; transition: background .15s, color .15s, border-color .15s; }
.freeroam-menu .filters button:hover, .freeroam-menu .slot-picker button:hover { color: white; background: #ffffff09; }
.freeroam-menu .filters button.active, .freeroam-menu .slot-picker button.active { border-color: #22d8e250; color: #61e6ed; background: #22d8e212; }
.freeroam-menu .catalog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-content: start; gap: 10px; max-height: clamp(240px, 32vh, 400px); overflow-y: auto; padding: 2px 6px 2px 2px; overscroll-behavior: contain; }
.freeroam-menu .catalog-card { position: relative; min-width: 0; min-height: 86px; padding: 17px 30px 17px 16px; border: 1px solid #ffffff12; border-radius: 7px; background: linear-gradient(125deg, #ffffff05, #ffffff01); color: #e2edf5; text-align: left; cursor: pointer; transition: background .15s, border-color .15s, transform .15s; }
.freeroam-menu .catalog-card::after { content: "+"; position: absolute; right: 12px; top: 15px; color: #7f9cac; font: 17px var(--font-mono); transition: color .15s; }
.freeroam-menu .catalog-card:hover { background: #22d8e20b; border-color: #22d8e260; transform: translateY(-1px); }
.freeroam-menu .catalog-card:hover::after { color: var(--o-cyan-500); }
.freeroam-menu .catalog-card.equipped { border-color: #22d8e260; background: #22d8e212; }
.freeroam-menu .catalog-card.equipped::after { content: "✓"; color: var(--o-cyan-500); }
.freeroam-menu .catalog-card strong { display: block; font: 600 14px/1.3 var(--font-ui); overflow-wrap: anywhere; }
.freeroam-menu .catalog-card small { display: block; margin-top: 8px; color: #8fa4b4; font: 11px/1.45 var(--font-body); overflow-wrap: anywhere; }
.freeroam-menu .catalog-card .tag { display: block; margin-top: 8px; color: #638e9e; font: 10px var(--font-mono); }
.freeroam-menu .empty-state { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 28px; border: 1px dashed #6a92a433; border-radius: 8px; color: var(--menu-muted); font: 15px/1.5 var(--font-body); }
.freeroam-menu .empty-state h3, .freeroam-menu .empty-state strong { color: #e0eaf2; font: 600 18px var(--font-ui); }
.freeroam-menu .availability { color: #e0bd79; font: 10px var(--font-mono); text-transform: uppercase; letter-spacing: .1em; }
.freeroam-menu .slot-picker { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.freeroam-menu .loadout { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.freeroam-menu .loadout-row { min-width: 0; padding: 14px; border: 1px solid #ffffff12; border-radius: 6px; background: #ffffff02; color: #c0d0dc; text-align: left; cursor: pointer; }
.freeroam-menu .loadout-row.selected { border-color: #22d8e250; background: #22d8e208; }
.freeroam-menu .loadout-row strong { display: block; font: 500 12px/1.5 var(--font-ui); overflow-wrap: anywhere; }
.freeroam-menu .loadout-row small { display: block; margin-top: 8px; color: #8ea3b3; font: 10px/1.5 var(--font-mono); overflow-wrap: anywhere; }
.freeroam-menu .custom, .freeroam-menu .row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.freeroam-menu .custom input { flex: 1 1 190px; }
.freeroam-menu .row > .btn { flex: 1 1 auto; }
.freeroam-menu .stack { display: flex; flex-direction: column; gap: 10px; }
.freeroam-menu .action-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.freeroam-menu .ammo-row { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; }
.freeroam-menu .btn { min-height: 42px; padding: 12px 16px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; border: 1px solid #ffffff1b; border-radius: 6px; background: #ffffff03; color: #c7d5df; font: 500 12px/1.3 var(--font-ui); text-align: center; cursor: pointer; transition: border-color .15s, background .15s, transform .15s; }
.freeroam-menu .btn:hover { border-color: #22d8e260; background: #22d8e210; color: #e5faff; }
.freeroam-menu .btn:active { transform: translateY(1px); }
.freeroam-menu .btn small { color: #94a6b5; font: 13px/1.45 var(--font-body); }
.freeroam-menu .btn.primary { border-color: transparent; background: var(--o-cyan-500); color: #062428; font-weight: 700; }
.freeroam-menu .btn.primary:hover { background: var(--o-cyan-400); }
.freeroam-menu .btn.danger { color: #d49ea5; }
.freeroam-menu .btn.danger:hover { background: #ff5c7212; border-color: #ff5c7260; color: #ffacb9; }
.freeroam-menu .btn:disabled { opacity: .4; cursor: not-allowed; transform: none; }
.freeroam-menu .cleanup-actions { margin-top: 8px; }
.freeroam-menu .advanced { border: 1px solid #ffffff12; border-radius: 7px; background: #ffffff02; }
.freeroam-menu .advanced summary { display: flex; align-items: center; gap: 12px; padding: 16px; color: #b2c3cf; font: 500 13px/1.4 var(--font-ui); cursor: pointer; list-style: none; }
.freeroam-menu .advanced summary::-webkit-details-marker { display: none; }
.freeroam-menu .advanced summary::after { content: "+"; margin-left: auto; color: #89a7b8; font: 18px/1 var(--font-mono); }
.freeroam-menu .advanced[open] summary::after { content: "−"; }
.freeroam-menu .advanced summary span { color: #7f94a4; font: 11px var(--font-body); }
.freeroam-menu .advanced summary:hover { color: #eff9ff; background: #ffffff03; }
.freeroam-menu .advanced-body { display: flex; flex-direction: column; gap: 14px; padding: 0 16px 16px; }
.freeroam-menu .advanced-body.custom { flex-direction: row; }
.freeroam-menu .danger-zone summary { color: #d5a4ab; }
.freeroam-menu .player-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 8px 0; }
.freeroam-menu .player-card { position: relative; min-height: 166px; flex-direction: column; align-items: flex-start; justify-content: flex-end; text-align: left; gap: 9px; padding: 22px; }
.freeroam-menu .player-card.featured { background: linear-gradient(125deg, #16414b65, #10252c30); border-color: #22d8e235; }
.freeroam-menu .player-card strong { font: 600 21px/1.2 var(--font-display); }
.freeroam-menu .action-symbol { color: #5ab8c5; font: 9px var(--font-mono); letter-spacing: .12em; margin-bottom: auto; }
.freeroam-menu .player-card i { position: absolute; top: 18px; right: 20px; color: #7bb1bd; font: 22px/1 var(--font-body); }
.freeroam-menu .list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.freeroam-menu .list button { min-width: 0; min-height: 82px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 9px; padding: 17px; border: 1px solid #ffffff14; border-radius: 7px; background: #ffffff03; color: #d8e5ee; font: 500 14px/1.3 var(--font-ui); text-align: left; cursor: pointer; transition: border-color .15s, background .15s; }
.freeroam-menu .list button:hover { border-color: #22d8e250; background: #22d8e20a; }
.freeroam-menu .list button span { overflow-wrap: anywhere; }
.freeroam-menu .list button i { color: #829eaf; font: 11px/1.4 var(--font-body); overflow-wrap: anywhere; }
.freeroam-menu .coords { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
.freeroam-menu .coords label { display: flex; flex-direction: column; gap: 7px; color: var(--menu-muted); font: 12px var(--font-ui); }
.freeroam-menu .coords .btn { grid-column: 1 / -1; }
.freeroam-menu .catalogue-grid { display: grid; gap: 14px; }
.freeroam-menu .catalogue-row { display: flex; flex-direction: column; gap: 14px; padding: 20px; border: 1px solid #ffffff14; border-radius: 7px; min-width: 0; }
.freeroam-menu .catalogue-row strong { font: 500 15px var(--font-ui); overflow-wrap: anywhere; }
.freeroam-menu .catalogue-row .row input { flex: 1 1 180px; }
.freeroam-menu .catalogue-row select { width: auto; }
.freeroam-menu .catalogue-row .placement-controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.freeroam-menu .catalogue-row input[type=range] { accent-color: var(--o-cyan-500); }
.freeroam-menu .foot { grid-area: foot; display: flex; align-items: center; gap: 9px; padding: 0 26px; border-top: 1px solid #ffffff0b; background: #070e16b0; color: #7b94a6; font: 11px var(--font-body); }
.freeroam-menu .session-dot { width: 5px; height: 5px; border-radius: 50%; background: #47d4b2; }
.freeroam-menu .foot-search { display: flex; align-items: center; gap: 7px; margin-left: 32px; }
.freeroam-menu .foot-command { margin-left: auto; }
.freeroam-menu .foot .ds-data { color: #a3c1d1; font-size: 10px; }
.freeroam-menu .toast { position: fixed; z-index: 20; left: 50%; bottom: max(14px, 2vh); transform: translate(-50%, 8px); max-width: min(560px, 90vw); padding: 14px 20px; border: 1px solid #22d8e24d; border-radius: 8px; background: #10212bf7; box-shadow: 0 8px 28px #0008; color: #d2eaf0; font: 14px/1.45 var(--font-body); opacity: 0; pointer-events: none; transition: opacity .18s, transform .18s; }
.freeroam-menu .toast.show { opacity: 1; transform: translate(-50%, 0); }
.freeroam-menu .toast.error { border-color: #ff75836b; color: #ffc3cd; background: #261a22f7; }
@keyframes ds-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes menu-content-in { from { opacity: 0; translate: 0 5px; } to { opacity: 1; translate: 0 0; } }
@media (max-width: 1100px), (max-height: 820px) {
  .freeroam-menu:not(.animation-mode) .drawer { inset: 24px; grid-template-columns: 195px minmax(0, 1fr); grid-template-rows: 74px minmax(0, 1fr) 40px; }
  .freeroam-menu .head { padding: 0 24px; gap: 20px; }
  .freeroam-menu .tabs { padding: 16px 12px; gap: 16px; }
  .freeroam-menu .tab { min-height: 39px; padding: 9px 10px; font-size: 13px; }
  .freeroam-menu .tab.active::before { left: -13px; }
  .freeroam-menu .pages { padding: 26px; }
  .freeroam-menu .catalog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .freeroam-menu .head-caption { display: none; }
}
@media (max-width: 780px) {
  .freeroam-menu:not(.animation-mode) .drawer { inset: 12px; grid-template-columns: 154px minmax(0, 1fr); grid-template-rows: 66px minmax(0, 1fr) 36px; }
  .freeroam-menu .head { padding: 0 16px; }
  .freeroam-menu .head-copy { gap: 12px; }
  .freeroam-menu .menu-brand { padding-right: 12px; font-size: 10px; }
  .freeroam-menu .head h1 { font-size: 23px; }
  .freeroam-menu .close span { display: none; }
  .freeroam-menu .tabs { padding: 16px 8px; }
  .freeroam-menu .tab { gap: 8px; padding: 10px 8px; font-size: 12px; }
  .freeroam-menu .tab svg { width: 16px; height: 16px; }
  .freeroam-menu .tab i { display: none; }
  .freeroam-menu .tab.active::before { left: -9px; }
  .freeroam-menu .nav-label { font-size: 8px; padding-left: 8px; }
  .freeroam-menu .pages { padding: 20px; }
  .freeroam-menu h2 { font-size: 27px; }
  .freeroam-menu .catalog-grid, .freeroam-menu .list, .freeroam-menu .player-actions { grid-template-columns: 1fr; }
  .freeroam-menu .action-grid, .freeroam-menu .coords { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .freeroam-menu .loadout { grid-template-columns: 1fr; }
  .freeroam-menu .ammo-row { grid-template-columns: 1fr 1fr; }
  .freeroam-menu .ammo-row .btn { grid-column: 1 / -1; }
  .freeroam-menu .advanced summary span { display: none; }
  .freeroam-menu .foot { padding: 0 14px; }
  .freeroam-menu .foot-search { display: none; }
  .freeroam-menu .catalogue-row .placement-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (prefers-reduced-motion: reduce) {
  .freeroam-menu *, .freeroam-menu *::before, .freeroam-menu *::after { animation: none !important; transition: none !important; }
}
(() => {
  "use strict";

  const body = document.getElementById("freeroam-menu");
  const toast = document.getElementById("toast");
  let toastTimer = null;
  let state = {
    locations: [], spawns: [],
    vehicles: { catalog: [], allowCustomModels: false },
    weapons: { catalog: [], enabled: false, defaultReserve: 500, maximumReserve: 5000 },
    player: {},
  };
  let selectedSlot = 1;
  let vehicleCategory = "All";
  let weaponCategory = "All";
  let weaponSlots = [];
  let garageState = { count: 0, maximum: 0 };
  let playerState = { available: false };

  const send = (type, extra) => Open77.emit(
    "freeroam:action", Object.assign({ type }, extra || {}));
  const close = () => Open77.emit("freeroam:close", {});
  // An empty Lua table crosses the bridge as {}, not []; never iterate raw.
  const asArray = value => Array.isArray(value) ? value : [];
  const text = value => String(value || "").toLocaleLowerCase();

  function showToast(ok, message) {
    toast.textContent = message;
    toast.classList.toggle("error", !ok);
    toast.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("show"), 3600);
  }

  // Tabs -----------------------------------------------------------------

  const navigation = [...body.querySelectorAll(".tab")];
  const pages = body.querySelector(".pages");
  function activatePage(name) {
    if (name === "tv" && state.canManageTv !== true) name = "vehicles";
    const page = document.getElementById("page-" + name);
    if (!page) return;
    const changed = !page.classList.contains("active");
    body.classList.toggle("animation-mode", name === "animations");
    for (const tab of navigation) {
      const active = tab.dataset.tab === name;
      tab.classList.toggle("active", active);
      if (active) tab.setAttribute("aria-current", "page");
      else tab.removeAttribute("aria-current");
    }
    for (const other of body.querySelectorAll(".page")) other.classList.toggle("active", other === page);
    if (changed) pages.scrollTop = 0;
    body.querySelector(".foot-search").hidden = !page.querySelector("input.search, #travel-search");
  }
  // Activities can also open via slash commands. Keep the same selection and
  // layout path without emitting another Lua open request.
  body.addEventListener("freeroam:navigate", event => activatePage(event.detail));
  document.getElementById("tabs").addEventListener("keydown", event => {
    const visible = navigation.filter(tab => !tab.hidden && !tab.disabled);
    const current = visible.indexOf(document.activeElement);
    if (current < 0 || !["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return;
    event.preventDefault();
    const index = event.key === "Home" ? 0 : event.key === "End" ? visible.length - 1
      : (current + (event.key === "ArrowDown" ? 1 : -1) + visible.length) % visible.length;
    visible[index].focus(); // Enter/Space activates; arrows never launch an activity.
  });

  for (const tab of body.querySelectorAll(".tab")) {
    tab.addEventListener("click", () => {
      if (tab.dataset.tab === "animations") {
        Open77.emit("animations:open", {});
        return;
      }
      if (tab.dataset.tab === "race" || tab.dataset.tab === "footrace") {
        body.classList.remove("animation-mode");
        Open77.emit("freeroam:race", { mode: tab.dataset.tab === "footrace" ? "foot" : "vehicle" });
        return;
      }
      activatePage(tab.dataset.tab);
      if (tab.dataset.tab === "weapons") send("weaponSnapshot", {});
      if (tab.dataset.tab === "tv") requestTv();
      if (tab.dataset.tab === "pvp") Open77.emit("pvp:open", {});
    });
  }

  // Catalog rendering ----------------------------------------------------

  function categories(items) {
    return ["All", ...new Set(asArray(items).map(item => item.category || "Other"))];
  }

  function renderFilters(id, items, active, select) {
    const host = document.getElementById(id);
    const values = categories(items);
    const signature = JSON.stringify(values);
    if (host.dataset.signature === signature) {
      for (const button of host.children) {
        const chosen = button.textContent === active;
        button.classList.toggle("active", chosen);
        button.setAttribute("aria-pressed", String(chosen));
      }
      return;
    }
    host.dataset.signature = signature;
    host.replaceChildren();
    for (const category of values) {
      const button = document.createElement("button");
      button.textContent = category;
      button.classList.toggle("active", category === active);
      button.setAttribute("aria-pressed", String(category === active));
      button.addEventListener("click", () => select(category));
      host.append(button);
    }
  }

  function matches(item, category, query) {
    if (category !== "All" && item.category !== category) return false;
    if (!query) return true;
    return text(`${item.label} ${item.key} ${item.category} ${item.record}`).includes(query);
  }

  function card(item, action) {
    const button = document.createElement("button");
    button.className = "catalog-card";
    button.title = item.record || "";
    const label = document.createElement("strong");
    label.textContent = item.label || item.key;
    const meta = document.createElement("small");
    meta.textContent = item.category || "Other";
    button.append(label, meta);
    button.addEventListener("click", action);
    return button;
  }

  function emptyState(host, message, reset) {
    const empty = document.createElement("div");
    empty.className = "empty-state";
    const copy = document.createElement("p");
    copy.textContent = message;
    empty.append(copy);
    if (reset) {
      const button = document.createElement("button");
      button.className = "btn";
      button.textContent = "Reset search & filters";
      button.addEventListener("click", reset);
      empty.append(button);
    }
    host.append(empty);
  }

  function renderVehicles() {
    const vehicles = state.vehicles && typeof state.vehicles === "object" ? state.vehicles : {};
    const items = asArray(vehicles.catalog);
    const query = text(document.getElementById("vehicle-search").value.trim());
    const grid = document.getElementById("vehicle-grid");
    renderFilters("vehicle-filters", items, vehicleCategory, category => {
      vehicleCategory = category;
      renderVehicles();
    });
    const shown = items.filter(item => matches(item, vehicleCategory, query));
    const signature = JSON.stringify([shown, vehicleCategory, query]);
    if (grid.dataset.signature !== signature) {
      grid.dataset.signature = signature;
      grid.replaceChildren();
      grid.scrollTop = 0;
      for (const item of shown) grid.append(card(item, () => send("car", { model: item.key })));
      if (!shown.length) emptyState(grid, items.length ? "No vehicles match your search." : "No vehicles are configured on this server.", items.length ? () => {
        vehicleCategory = "All";
        document.getElementById("vehicle-search").value = "";
        renderVehicles();
        document.getElementById("vehicle-search").focus();
      } : null);
    }
    document.getElementById("vehicle-count").textContent = `${shown.length} / ${items.length} models`;

    document.getElementById("vehicle-custom").style.display =
      vehicles.allowCustomModels ? "" : "none";
    const max = Number(vehicles.maxPerPlayer) || 0;
    const count = Number(garageState.count) || 0;
    const effectiveMax = Number(garageState.maximum) || max;
    document.getElementById("vehicle-hint").textContent = effectiveMax > 0
      ? `Choose a model to spawn. Garage: ${count} / ${effectiveMax}. Oldest replaced when full.`
      : "Choose a model to spawn it nearby. Your garage has no vehicle limit.";
    const latest = garageState.latest && typeof garageState.latest === "object"
      ? garageState.latest : null;
    const identity = latest && (latest.label || latest.record || `VEHICLE ${latest.id}`);
    document.getElementById("vehicle-latest").textContent = latest
      ? `LATEST · ${identity} · ${latest.engineOn ? "ENGINE ON" : "ENGINE OFF"} · ` +
        `${latest.locked ? "LOCKED" : "UNLOCKED"} · ` +
        `${latest.lightsOn ? "LIGHTS ON" : "LIGHTS OFF"}`
      : "Your garage is empty. Choose your first ride below.";
  }

  function renderWeapons() {
    const weapons = state.weapons && typeof state.weapons === "object" ? state.weapons : {};
    const items = asArray(weapons.catalog);
    const query = text(document.getElementById("weapon-search").value.trim());
    const grid = document.getElementById("weapon-grid");
    renderFilters("weapon-filters", items, weaponCategory, category => {
      weaponCategory = category;
      renderWeapons();
    });
    const shown = items.filter(item => matches(item, weaponCategory, query));
    const equipped = weaponSlots.find(value => Number(value.slot) === selectedSlot) || {};
    const signature = JSON.stringify([shown, weaponCategory, query, equipped.record]);
    if (grid.dataset.signature !== signature) {
      grid.dataset.signature = signature;
      grid.replaceChildren();
      for (const item of shown) {
      const button = card(item, () => send("weaponEquip", {
        key: item.key,
        slot: selectedSlot,
      }));
      button.classList.toggle("equipped", equipped.record === item.record);
      button.setAttribute("aria-pressed", String(equipped.record === item.record));
      grid.append(button);
      }
      if (!shown.length) emptyState(grid, items.length ? "No weapons match your search." : "No weapons are configured on this server.", items.length ? () => {
        weaponCategory = "All";
        document.getElementById("weapon-search").value = "";
        renderWeapons();
        document.getElementById("weapon-search").focus();
      } : null);
    }
    document.getElementById("weapon-count").textContent = `${shown.length} / ${items.length} weapons`;
    document.getElementById("ammo-reserve").placeholder =
      `reserve 0-${Number(weapons.maximumReserve) || 5000}`;
    if (!document.getElementById("ammo-reserve").value)
      document.getElementById("ammo-reserve").value = String(Number(weapons.defaultReserve) || 500);
  }

  function renderLoadout() {
    const host = document.getElementById("weapon-loadout");
    host.replaceChildren();
    for (let slot = 1; slot <= 3; slot += 1) {
      const value = weaponSlots.find(item => Number(item.slot) === slot) || {};
      const row = document.createElement("button");
      row.className = "loadout-row";
      row.classList.toggle("selected", slot === selectedSlot);
      const name = document.createElement("strong");
      const record = value.record || value.tweakDbId || "";
      const configured = asArray(state.weapons && state.weapons.catalog)
        .find(item => item.record === value.record);
      const display = configured && configured.label ? configured.label : record || "Empty";
      name.textContent = `SLOT ${slot} · ${display}`;
      row.title = record;
      const status = document.createElement("small");
      const ammo = value.ammo && typeof value.ammo === "object" ? value.ammo : {};
      const flags = [value.active ? "ACTIVE" : "", value.drawn ? "DRAWN" : ""]
        .filter(Boolean).join(" · ") || "INACTIVE";
      status.textContent = Number(ammo.total) >= 0
        ? `${flags} · reserve ${ammo.reserve} · mag ${ammo.magazine}/${ammo.capacity}`
        : flags;
      row.append(name, status);
      row.addEventListener("click", () => selectSlot(slot));
      host.append(row);
    }
  }

  function selectSlot(slot) {
    selectedSlot = slot;
    for (const button of body.querySelectorAll("#weapon-slots button")) {
      button.classList.toggle("active", Number(button.dataset.slot) === slot);
      button.setAttribute("aria-pressed", String(Number(button.dataset.slot) === slot));
    }
    renderLoadout();
    renderWeapons();
  }

  function renderTravel() {
    const query = text(document.getElementById("travel-search").value.trim());
    const locations = document.getElementById("location-list");
    locations.replaceChildren();
    for (const location of asArray(state.locations)) {
      if (query && !text(`${location.label} ${location.name} ${location.district}`).includes(query)) continue;
      const button = document.createElement("button");
      const label = document.createElement("span");
      label.textContent = location.label || location.name;
      const detail = document.createElement("i");
      const p = location.position || {};
      detail.textContent = `${location.district || "Night City"} · ${Math.round(p.x)}, ${Math.round(p.y)}, ${Math.round(p.z)}`;
      button.append(label, detail);
      button.addEventListener("click", () => send("goto", { name: location.name }));
      locations.append(button);
    }
    if (!locations.childElementCount) emptyState(locations, query ? "No destinations match your search." : "No destinations configured.");

    const spawns = document.getElementById("spawn-list");
    spawns.replaceChildren();
    for (const point of asArray(state.spawns)) {
      if (query && !text(`${point.label} ${point.name}`).includes(query)) continue;
      const button = document.createElement("button");
      const label = document.createElement("span");
      label.textContent = point.label || point.name;
      const coords = document.createElement("i");
      const p = point.position || {};
      coords.textContent = `${Math.round(p.x)}, ${Math.round(p.y)}, ${Math.round(p.z)}`;
      button.append(label, coords);
      button.addEventListener("click", () => send("spawn", { name: point.name }));
      spawns.append(button);
    }
    if (!spawns.childElementCount) emptyState(spawns, query ? "No spawn points match your search." : "No spawn points configured.");
  }

  function render() {
    renderVehicles();
    renderWeapons();
    renderLoadout();
    renderTravel();
    const player = state.player && typeof state.player === "object" ? state.player : {};
    document.getElementById("player-restore").style.display = player.allowRestore ? "" : "none";
    document.getElementById("godmode-controls").style.display = player.allowGodMode ? "" : "none";
    renderPlayerState();
  }

  function renderPlayerState() {
    const host = document.getElementById("player-status");
    if (!playerState.available) {
      host.textContent = "PLAYER STATE UNAVAILABLE";
      host.classList.remove("signal");
      return;
    }
    const health = Math.round(Number(playerState.health) || 0);
    const maximum = Math.round(Number(playerState.maximumHealth) || 0);
    const armor = Math.round(Number(playerState.armor) || 0);
    host.textContent = `HEALTH ${health}/${maximum} · ARMOR ${armor} · ` +
      (playerState.godMode ? "GOD MODE ON" : "GOD MODE OFF");
    host.classList.toggle("signal", playerState.godMode === true);
  }

  // Static controls ------------------------------------------------------

  document.getElementById("close").addEventListener("click", close);
  document.getElementById("vehicle-search").addEventListener("input", renderVehicles);
  document.getElementById("weapon-search").addEventListener("input", renderWeapons);
  document.getElementById("travel-search").addEventListener("input", renderTravel);
  document.getElementById("cyberware-open").addEventListener("click", () => send("cyberlab", {}));
  document.getElementById("vehicle-delete").addEventListener("click", () => send("dv", {}));
  document.getElementById("vehicle-delete-all").addEventListener("click", () => send("dv", { all: true }));
  document.getElementById("vehicle-spawn").addEventListener("click", () => {
    const record = document.getElementById("vehicle-record").value.trim();
    if (record) send("car", { model: record });
  });
  document.getElementById("vehicle-repair").addEventListener("click", () => send("vehicleRepair", {}));
  document.getElementById("vehicle-engine-on").addEventListener("click", () => send("vehicleEngine", { enabled: true }));
  document.getElementById("vehicle-engine-off").addEventListener("click", () => send("vehicleEngine", { enabled: false }));
  document.getElementById("vehicle-lock").addEventListener("click", () => send("vehicleLock", { enabled: true }));
  document.getElementById("vehicle-unlock").addEventListener("click", () => send("vehicleLock", { enabled: false }));
  document.getElementById("vehicle-lights").addEventListener("click", () => send("vehicleLights", { enabled: true }));
  document.getElementById("vehicle-lights-off").addEventListener("click", () => send("vehicleLights", { enabled: false }));

  for (const button of body.querySelectorAll("#weapon-slots button"))
    button.addEventListener("click", () => selectSlot(Number(button.dataset.slot)));
  document.getElementById("weapon-ammo").addEventListener("click", () => {
    const reserveText = document.getElementById("ammo-reserve").value.trim();
    const magazineText = document.getElementById("ammo-magazine").value.trim();
    const reserve = Number(reserveText);
    const maximum = Number(state.weapons && state.weapons.maximumReserve) || 5000;
    if (!Number.isInteger(reserve) || reserve < 0 || reserve > maximum)
      return showToast(false, `reserve must be an integer from 0 to ${maximum}`);
    const payload = { slot: selectedSlot, reserve };
    if (magazineText) {
      const magazine = Number(magazineText);
      if (!Number.isInteger(magazine) || magazine < 0)
        return showToast(false, "magazine must be a positive integer");
      payload.magazine = magazine;
    }
    send("weaponAmmo", payload);
  });
  document.getElementById("weapon-activate").addEventListener("click", () =>
    send("weaponActivate", { slot: selectedSlot }));
  document.getElementById("weapon-refresh").addEventListener("click", () => send("weaponSnapshot", {}));
  document.getElementById("weapon-holster").addEventListener("click", () => send("weaponHolster", {}));
  document.getElementById("weapon-remove").addEventListener("click", () =>
    send("weaponRemove", { slot: selectedSlot }));

  document.getElementById("coord-go").addEventListener("click", () => {
    const value = id => document.getElementById(id).value.trim();
    if (["coord-x", "coord-y", "coord-z"].some(id => !value(id)))
      return showToast(false, "Enter X, Y and Z before travelling.");
    const x = Number(value("coord-x"));
    const y = Number(value("coord-y"));
    const z = Number(value("coord-z"));
    const heading = Number(value("coord-h") || "0");
    if (![x, y, z, heading].every(Number.isFinite))
      return showToast(false, "invalid coordinates");
    send("tpc", { x, y, z, heading });
  });
  document.getElementById("player-wardrobe").addEventListener("click", () => send("wardrobe", {}));
  document.getElementById("player-spawn").addEventListener("click", () => send("spawn", {}));
  document.getElementById("player-restore").addEventListener("click", () => send("restore", {}));
  document.getElementById("player-max-levels").addEventListener("click", () => send("maxLevels", {}));
  document.getElementById("player-revive").addEventListener("click", () => send("revive", {}));
  document.getElementById("player-god-on").addEventListener("click", () => send("godMode", { enabled: true }));
  document.getElementById("player-god-off").addEventListener("click", () => send("godMode", { enabled: false }));
  document.getElementById("player-suicide").addEventListener("click", () => send("suicide", {}));

  // Televisions ----------------------------------------------------------
  //
  // The catalogue and the spawn path live in the `open77_media` resource, not
  // here, so this tab is a client of it rather than a second implementation: it
  // asks, and it renders the answer. Everything a player can change goes through
  // that resource's server events, which is why changing a URL from here changes
  // it for everyone watching the same set.

  let tvCatalogue = [];
  let tvLocal = [];
  let tvFilter = "";

  const tvSend = (action, extra) => {
    if (state.canManageTv === true) Open77.emit("freeroam:tv", Object.assign({ action }, extra || {}));
  };
  const requestTv = () => {
    tvSend("catalogue");
    tvSend("local");
  };

  function renderTvCatalogue() {
    const grid = document.getElementById("tv-grid");
    grid.innerHTML = "";
    const shown = tvCatalogue.filter(record =>
      tvFilter === "" || text(record.label).includes(tvFilter) || text(record.id).includes(tvFilter));

    for (const record of shown) {
      const card = document.createElement("button");
      card.className = "catalog-card";
      card.type = "button";
      const title = document.createElement("strong");
      title.textContent = record.label || record.id;
      const blurb = document.createElement("small");
      blurb.textContent = record.blurb || record.model || "";
      const size = document.createElement("span");
      size.className = "tag";
      size.textContent = `${Number(record.width).toFixed(2)}×${Number(record.height).toFixed(2)} m`;
      card.append(title, blurb, size);
      card.addEventListener("click", () => tvSend("spawn", {
        record: record.id, url: document.getElementById("tv-url").value.trim(),
      }));
      grid.appendChild(card);
    }
    if (shown.length === 0) {
      const empty = document.createElement("p");
      empty.className = "hint";
      empty.textContent = tvCatalogue.length === 0
        ? "No records received. The open77_media resource may not be running."
        : "No records match that filter.";
      grid.appendChild(empty);
    }
  }

  // One row per set this client is rendering. The controls map onto the media
  // resource's own actions, so nothing here is a separate implementation of any
  // of them.
  function renderTvLocal() {
    const list = document.getElementById("tv-screens");
    list.innerHTML = "";
    // Nearest first, and the count stops claiming "in range".
    //
    // `open77:media:local` carries every television this client knows about --
    // the server's whole set, up to its own ceiling -- and it arrives in id
    // order. So the row for the set standing in front of the player sat wherever
    // its id happened to fall, and an operator changing "the volume" was usually
    // changing a television kilometres away while the picture in front of them
    // did not move. Nothing was broken in the control: it was aimed at the wrong
    // set, and the list gave no way to tell. The ones this client is actually
    // rendering come first, then by distance, and each row says which it is.
    const ordered = tvLocal.slice().sort((a, b) => {
      if (Boolean(a.materialised) !== Boolean(b.materialised)) return a.materialised ? -1 : 1;
      const left = Number(a.distance), right = Number(b.distance);
      if (isFinite(left) && isFinite(right) && left !== right) return left - right;
      return (Number(a.id) || 0) - (Number(b.id) || 0);
    });
    const rendered = ordered.filter(screen => screen.materialised === true).length;
    document.getElementById("tv-local-count").textContent = ordered.length === 0
      ? "NO SETS IN RANGE"
      : `${ordered.length} SET${ordered.length === 1 ? "" : "S"} — ${rendered} ON THIS CLIENT`;

    for (const screen of ordered) {
      const row = document.createElement("div");
      row.className = "catalogue-row";

      const head = document.createElement("strong");
      head.textContent = `#${screen.id}  ${screen.label || "television"}`;
      const where = document.createElement("small");
      const distance = screen.distance === null || screen.distance === undefined
        ? "distance unknown"
        : `${Number(screen.distance).toFixed(1)} m away`;
      // Which television this row is. A set this client is rendering is the one
      // on its screen; everything else is somewhere else on the map, and its
      // volume is not the volume of the picture in front of the player.
      where.textContent = `${screen.materialised === true ? "ON SCREEN" : "DRIVING A SET ELSEWHERE"} · ${distance}`;

      const urlRow = document.createElement("div");
      urlRow.className = "row";
      const url = document.createElement("input");
      url.type = "text";
      url.className = "search";
      url.spellcheck = false;
      url.value = screen.url || "";
      url.placeholder = "https://... (empty = idle test pattern)";
      url.setAttribute("aria-label", `Web page for television ${screen.id}`);
      const load = document.createElement("button");
      load.className = "btn";
      load.type = "button";
      load.textContent = "SHOW";
      const show = () => tvSend("url", { id: screen.id, url: url.value.trim() });
      load.addEventListener("click", show);
      url.addEventListener("keydown", event => { if (event.key === "Enter") show(); });
      urlRow.append(url, load);

      const controls = document.createElement("div");
      controls.className = "row";
      const volume = document.createElement("input");
      volume.type = "range";
      volume.min = "0";
      volume.max = "100";
      volume.value = String(screen.volume === undefined ? 100 : screen.volume);
      volume.setAttribute("aria-label", `Volume for television ${screen.id}`);
      volume.addEventListener("change", () =>
        tvSend("volume", { id: screen.id, volume: Number(volume.value) }));
      const sounds = document.createElement("button");
      sounds.className = "btn";
      sounds.type = "button";
      sounds.textContent = screen.muted ? "UNMUTE" : "MUTE";
      sounds.addEventListener("click", () => tvSend("muted", { id: screen.id, value: !screen.muted }));
      const play = document.createElement("button");
      play.className = "btn";
      play.type = "button";
      play.textContent = screen.paused ? "PLAY" : "PAUSE";
      play.addEventListener("click", () => tvSend("paused", { id: screen.id, value: !screen.paused }));
      const remove = document.createElement("button");
      remove.className = "btn danger";
      remove.type = "button";
      remove.textContent = "REMOVE";
      remove.addEventListener("click", () => tvSend("remove", { id: screen.id }));
      controls.append(volume, sounds, play, remove);

      // Placement: where the cabinet stands and which way it points.
      //
      // A spawned set lands about a metre in front of you facing you, which is
      // the right default and rarely the right answer -- hovering over a crate,
      // half inside a shelf, or a hand's width from flush. Before this row, the
      // only way to fix that was REMOVE and spawn again, which threw away the
      // URL and the volume, and there was no way at all to turn a set that had
      // come out facing the wrong way.
      //
      // The nudge is relative to the SET, not to the player or the world axis:
      // LEFT moves the television along the cabinet's own left, so a set turned
      // to face a room still moves the way the button says. The arithmetic lives
      // in the media resource (`shared/placement.lua`) and is pinned by its own
      // test, because a "left" that moves a set right is exactly the kind of
      // wrong that no log line can report.
      const placement = document.createElement("div");
      placement.className = "row placement-controls";
      const step = document.createElement("select");
      step.className = "search";
      step.title = "How far one press moves the set";
      step.setAttribute("aria-label", "Placement step size");
      for (const metres of [0.05, 0.25, 1, 5]) {
        const option = document.createElement("option");
        option.value = String(metres);
        option.textContent = `${metres} m`;
        if (metres === 0.25) option.selected = true;
        step.appendChild(option);
      }
      placement.appendChild(step);
      const nudges = [
        ["▲ UP", "up"], ["▼ DOWN", "down"],
        ["◀ LEFT", "left"], ["▶ RIGHT", "right"],
        ["FORWARD", "forward"], ["BACK", "back"],
      ];
      for (const [label, direction] of nudges) {
        const button = document.createElement("button");
        button.className = "btn";
        button.type = "button";
        button.textContent = label;
        button.title = `Move the set ${direction} by the step`;
        button.addEventListener("click", () =>
          tvSend("move", { id: screen.id, direction, metres: Number(step.value) }));
        placement.appendChild(button);
      }
      for (const [label, direction] of [["↺ TURN", "left"], ["↻ TURN", "right"]]) {
        const button = document.createElement("button");
        button.className = "btn";
        button.type = "button";
        button.textContent = label;
        button.title = `Turn the set 15° to its ${direction}`;
        button.addEventListener("click", () =>
          tvSend("rotate", { id: screen.id, direction, degrees: 15 }));
        placement.appendChild(button);
      }

      row.append(head, where, urlRow, controls, placement);
      list.appendChild(row);
    }
  }

  document.getElementById("tv-search").addEventListener("input", event => {
    tvFilter = text(event.target.value);
    renderTvCatalogue();
  });
  document.getElementById("tv-refresh").addEventListener("click", requestTv);

  document.addEventListener("keydown", event => {
    if (!body.classList.contains("open")) return;
    if (event.key === "Escape") { event.preventDefault(); close(); }
    if (event.key === "/" && !body.classList.contains("animation-mode") &&
        !["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement?.tagName)) {
      const input = body.querySelector(".page.active input.search, .page.active #travel-search");
      if (input) { event.preventDefault(); input.focus(); }
    }
    if (event.key === "Tab") {
      const focusable = [...body.querySelectorAll('button, input, select, summary, [tabindex="0"]')]
        .filter(element => !element.disabled && element.getClientRects().length && getComputedStyle(element).visibility !== "hidden");
      const first = focusable[0], last = focusable[focusable.length - 1];
      if (first && (!body.contains(document.activeElement) ||
          (event.shiftKey && document.activeElement === first) || (!event.shiftKey && document.activeElement === last))) {
        event.preventDefault(); (event.shiftKey ? last : first).focus();
      }
    }
  });

  // Bridge ---------------------------------------------------------------

  Open77.on("freeroam:state", payload => {
    if (payload && typeof payload === "object") state = payload;
    body.querySelector('[data-tab="tv"]').hidden = state.canManageTv !== true;
    if (state.canManageTv !== true) {
      tvCatalogue = []; tvLocal = [];
      renderTvCatalogue(); renderTvLocal();
      if (document.getElementById("page-tv").classList.contains("active")) activatePage("vehicles");
    }
    render();
  });
  Open77.on("freeroam:tv:open", () => {
    if (state.canManageTv !== true) return;
    activatePage("tv"); requestTv();
  });
  Open77.on("freeroam:weapons", payload => {
    weaponSlots = asArray(payload && payload.slots);
    renderWeapons();
    renderLoadout();
  });
  Open77.on("freeroam:garage", payload => {
    garageState = payload && typeof payload === "object" ? payload : { count: 0, maximum: 0 };
    renderVehicles();
  });
  Open77.on("freeroam:player", payload => {
    playerState = payload && typeof payload === "object" ? payload : { available: false };
    renderPlayerState();
  });
  Open77.on("freeroam:open", () => {
    body.classList.add("open");
    const name = body.querySelector(".page.active")?.id.replace("page-", "") || "vehicles";
    activatePage(name);
    const focus = body.classList.contains("animation-mode") ? document.getElementById("anim-search") : body.querySelector(".tab.active");
    focus?.focus({ preventScroll: true });
  });
  Open77.on("freeroam:closed", () => body.classList.remove("open"));
  Open77.on("freeroam:result", payload => {
    if (payload && payload.text) showToast(payload.ok === true, payload.text);
  });
  // `freeroam:tv` carries three shapes, told apart by which key is present
  // rather than by a discriminator: the catalogue, this client's nearby sets, and
  // a one-line answer to an action. They arrive from different places (the media
  // resource's server and its client), so a shared discriminator would have to
  // be invented on both sides for no gain.
  Open77.on("freeroam:tv", payload => {
    if (state.canManageTv !== true) return;
    if (!payload || typeof payload !== "object") return;
    if (payload.catalogue) {
      tvCatalogue = asArray(payload.catalogue);
      document.getElementById("tv-status").textContent = tvCatalogue.length
        ? `${tvCatalogue.length} screens available · Choose a model to place it nearby.`
        : "No televisions are available. Check that the media resource is running.";
      renderTvCatalogue();
      return;
    }
    if (payload.screens) {
      tvLocal = asArray(payload.screens);
      renderTvLocal();
      return;
    }
    if (payload.text) {
      showToast(payload.ok === true, payload.text);
      if (payload.ok === true) requestTv();
    }
  });

  Open77.ready();
  Open77.emit("freeroam:ready", {});
})();
/* OPEN//77 Design System — freeroam production theme.
 *
 * This is the offline/Cef-safe transcription of `Open77 Design System/tokens`.
 * The reference kit loads substitute fonts and icons from public CDNs; a game
 * resource cannot depend on either, so the same roles resolve to Windows faces
 * and all graphics below are CSS geometry. No gameplay surface reaches the
 * network to render its UI.
 */

:root {
  /* Night / chrome ramps. */
  --o-black: #05070b;
  --o-ink-900: #0b0e14;
  --o-ink-800: #0d131d;
  --o-ink-700: #12161f;
  --o-ink-600: #171c26;
  --o-ink-500: #1e242f;
  --o-ink-400: #2a313e;
  --o-ink-300: #3a4250;
  --o-ink-200: #5a6472;
  --o-ink-100: #8a94a2;
  --o-chrome-000: #ffffff;
  --o-chrome-050: #f7f9fb;
  --o-chrome-100: #f0f3f6;
  --o-chrome-200: #dde3e9;
  --o-chrome-300: #bcc5ce;

  /* Brand and functional accents. */
  --o-cyan-400: #4ee6ee;
  --o-cyan-500: #22d8e2;
  --o-cyan-600: #12b4be;
  --o-cyan-700: #0b7f87;
  --o-cyan-900: #0a2a2e;
  --o-teal-muted: #3d7f85;
  --o-red-500: #ff3b4e;
  --o-red-700: #8e1420;
  --o-amber-500: #ffb020;
  --o-amber-700: #8a5a00;
  --o-mint-500: #2be58b;
  --o-mint-700: #0e6b41;
  --o-magenta-500: #ff2e88;
  --o-violet-500: #7c5cff;

  /* Surfaces and text. */
  --surface-app: var(--o-ink-900);
  --surface-panel: var(--o-ink-800);
  --surface-panel-raised: var(--o-ink-700);
  --surface-panel-hover: var(--o-ink-600);
  --surface-inset: var(--o-black);
  --surface-scrim: rgba(5, 7, 11, 0.78);
  --surface-hud: rgba(11, 14, 20, 0.82);
  --text-primary: #e6eaec;
  --text-secondary: #8a94a2;
  --text-muted: #5a6472;
  --text-accent: var(--o-cyan-500);
  --text-on-accent: #05262a;
  --text-on-chrome: #141d29;
  --text-eyebrow: var(--o-teal-muted);
  --line-hairline: rgba(138, 148, 162, 0.18);
  --line-strong: rgba(138, 148, 162, 0.34);
  --line-hud: rgba(230, 234, 236, 0.16);

  /* Vitals. */
  --vital-health: var(--o-red-500);
  --vital-health-empty: rgba(255, 59, 78, 0.16);
  --vital-armor: var(--o-cyan-500);
  --vital-stamina: var(--o-amber-500);
  --vital-ram: var(--o-violet-500);
  --vital-xp: var(--o-mint-500);

  /* Offline font substitutions for the four design roles. */
  --font-display: "Saira", "Bahnschrift SemiCondensed", "Arial Narrow", "Segoe UI", sans-serif;
  --font-ui: "Chakra Petch", "Bahnschrift", "Segoe UI", sans-serif;
  --font-body: "Rajdhani", "Bahnschrift", "Segoe UI", system-ui, sans-serif;
  --font-mono: "JetBrains Mono", "Cascadia Mono", "Consolas", ui-monospace, monospace;
  --fw-regular: 400;
  --fw-medium: 500;
  --fw-semibold: 600;
  --fw-bold: 700;
  --fw-black: 800;
  --size-label-lg: 15px;
  --size-label: 13px;
  --size-label-sm: 11px;
  --size-label-xs: 10px;
  --size-body: 17px;
  --size-body-sm: 15px;
  --size-data: 13px;
  --size-data-sm: 11px;
  --ls-display: -0.01em;
  --ls-label: 0.14em;
  --ls-label-tight: 0.08em;
  --ls-data: 0.04em;

  /* Spacing / controls. */
  --space-1: 2px;
  --space-2: 4px;
  --space-3: 8px;
  --space-4: 12px;
  --space-5: 16px;
  --space-6: 20px;
  --space-7: 24px;
  --space-8: 32px;
  --space-9: 40px;
  --space-10: 56px;
  --control-h-sm: 32px;
  --control-h: 44px;
  --control-h-lg: 54px;
  --control-px: 20px;
  --panel-pad: 24px;
  --panel-pad-sm: 16px;
  --hud-gap: 10px;
  --gutter-page: 32px;

  /* Shape / depth / motion. */
  --chamfer-sm: 6px;
  --chamfer: 10px;
  --chamfer-lg: 16px;
  --chamfer-xl: 24px;
  --cut-sm: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
  --cut-md: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
  --cut-lg: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
  --cut-tr: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
  --cut-tl: polygon(10px 0, 100% 0, 100% 100%, 0 100%, 0 10px);
  --shadow-panel: 0 18px 48px -18px rgba(0, 0, 0, 0.85);
  --shadow-overlay: 0 40px 90px -20px rgba(0, 0, 0, 0.9);
  --shadow-inset-well: inset 0 1px 0 rgba(255, 255, 255, 0.04), inset 0 0 0 1px rgba(0, 0, 0, 0.4);
  --glow-accent: 0 0 0 1px rgba(34, 216, 226, 0.5), 0 0 18px -2px rgba(34, 216, 226, 0.45);
  --glow-accent-soft: 0 0 24px -6px rgba(34, 216, 226, 0.35);
  --glow-danger: 0 0 18px -2px rgba(255, 59, 78, 0.5);
  --scanline: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 3px);
  --grid-fine: linear-gradient(rgba(138, 148, 162, 0.06) 1px, transparent 1px) 0 0 / 100% 8px,
    linear-gradient(90deg, rgba(138, 148, 162, 0.06) 1px, transparent 1px) 0 0 / 8px 100%;
  --blur-hud: blur(10px) saturate(1.1);
  --ease-out: cubic-bezier(0.16, 0.84, 0.44, 1);
  --ease-snap: cubic-bezier(0.2, 0, 0, 1);
  --dur-1: 90ms;
  --dur-2: 140ms;
  --dur-3: 220ms;
  --dur-4: 340ms;
  --t-hover: background var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out),
    box-shadow var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out);
}

*, *::before, *::after { box-sizing: border-box; }

html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  color: var(--text-primary);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
}

button, input { font: inherit; }
button:focus-visible, input:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--o-ink-900), 0 0 0 4px var(--o-cyan-500);
}

.ds-section-label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-4);
  color: var(--text-eyebrow);
  font: var(--fw-semibold) var(--size-label-sm) / 1 var(--font-ui);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
}
.ds-section-label::before {
  content: "//";
  color: var(--o-cyan-500);
  font-weight: var(--fw-black);
  letter-spacing: -0.08em;
}

.ds-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 22px;
  padding: 0 8px;
  border: 1px solid rgba(43, 229, 139, 0.4);
  background: rgba(43, 229, 139, 0.13);
  color: var(--o-mint-500);
  clip-path: var(--cut-sm);
  font: var(--fw-semibold) var(--size-label-xs) / 1 var(--font-ui);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
}
.ds-badge::before {
  content: "";
  width: 6px;
  height: 6px;
  background: currentColor;
  box-shadow: 0 0 8px currentColor;
}

.ds-panel {
  position: relative;
  border: 1px solid var(--line-hairline);
  background: var(--surface-panel);
  clip-path: var(--cut-lg);
}
.ds-panel::after {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--scanline);
  mix-blend-mode: overlay;
  pointer-events: none;
}

.ds-data {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  letter-spacing: var(--ls-data);
}

.ds-label {
  color: var(--text-secondary);
  font: var(--fw-semibold) var(--size-label-xs) / 1 var(--font-ui);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
}

@keyframes ds-slide-right {
  from { opacity: 0; transform: translateX(16px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes ds-slide-left {
  from { opacity: 0; transform: translateX(-24px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes ds-rise {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes ds-critical {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.72; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 1ms !important;
    animation-delay: 0ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 1ms !important;
  }
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Open//77 — Freeroam</title>
  <link rel="stylesheet" href="design-system.css">
  <link rel="stylesheet" href="app.css">
  <link rel="stylesheet" href="race/theme.css">
  <link rel="stylesheet" href="pvp/theme.css">
  <link rel="stylesheet" href="animations/theme.css">
  <link rel="stylesheet" href="animations/idle.css">
</head>
<body>
<div id="freeroam-menu" class="freeroam-menu">
  <div class="scrim" id="scrim"></div>

  <aside class="drawer" role="dialog" aria-modal="true" aria-label="Freeroam menu">
    <header class="head">
      <div class="head-copy">
        <span class="menu-brand">OPEN<span>//</span>77</span>
        <h1>Free<span>roam</span></h1>
      </div>
      <p class="head-caption">Your city. Your playground.</p>
      <button class="close" id="close" aria-label="Close freeroam menu"><span>Back to city</span><kbd>ESC</kbd><b aria-hidden="true">×</b></button>
    </header>

    <nav class="tabs" id="tabs" aria-label="Menu sections">
      <div class="nav-group" role="group" aria-label="Sandbox">
        <span class="nav-label">Explore &amp; equip</span>
        <button class="tab active" data-tab="vehicles" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 10 2-5h10l2 5M4 10h16v8H4zM7 18v2m10-2v2M7 13h2m6 0h2"/></svg><span>Vehicles</span><i aria-hidden="true">›</i></button>
        <button class="tab" data-tab="weapons"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h17v5h-7l-2 7H6l2-7H3zM15 7V5m2 7v3h-4"/></svg><span>Weapons</span><i aria-hidden="true">›</i></button>
        <button class="tab" data-tab="cyberware"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4m6-4v4M9 18v4m6-4v4M2 9h4m-4 6h4m12-6h4m-4 6h4M10 10h4v4h-4z"/></svg><span>Cyberware</span><i aria-hidden="true">›</i></button>
        <button class="tab" data-tab="travel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2"/></svg><span>Travel</span><i aria-hidden="true">›</i></button>
        <button class="tab" data-tab="tv" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="m8 2 4 4 4-4M8 22h8"/></svg><span>Televisions</span><i aria-hidden="true">›</i></button>
      </div>
      <div class="nav-group" role="group" aria-label="Character">
        <span class="nav-label">Your character</span>
        <button class="tab" data-tab="player"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span>Player</span><i aria-hidden="true">›</i></button>
        <button class="tab" data-tab="animations"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="13" cy="4" r="2"/><path d="m4 10 5-2 5 1 5 4m-8-5-2 7-4 6m5-8 5 3 2 5"/></svg><span>Animations</span><i aria-hidden="true">↗</i></button>
      </div>
      <div class="nav-group" role="group" aria-label="Activities">
        <span class="nav-label">Play together</span>
        <button class="tab activity-tab" id="open-footrace" data-tab="footrace"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="14" cy="4" r="2"/><path d="m4 10 5-2 5 1 5 4m-8-5-2 7-4 6m5-8 5 3 2 5"/></svg><span>Foot Race</span><i aria-hidden="true">↗</i></button>
        <button class="tab activity-tab" id="open-race" data-tab="race"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 22V3c5-4 9 4 15 0v12c-6 4-10-4-15 0M10 3v12m5-10v12M5 9c5-4 9 4 15 0"/></svg><span>Race</span><i aria-hidden="true">↗</i></button>
        <button class="tab activity-tab" id="open-pvp" data-tab="pvp"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4"/></svg><span>PvP arena</span><i aria-hidden="true">›</i></button>
      </div>
    </nav>

    <div class="pages">
      <section class="page" id="page-animations" aria-label="Role-play animations">
        <header class="anim-header">
          <button type="button" class="anim-icon-button" id="anim-back" aria-label="Back to Freeroam">←</button>
          <div><span class="anim-eyebrow">OPEN//77 · ROLEPLAY</span><h2>ANIMATIONS<span>.</span></h2></div>
          <span class="anim-total"><strong id="anim-total">—</strong> clips</span>
          <button type="button" class="anim-icon-button" id="anim-close" aria-label="Close animations">✕</button>
        </header>
        <nav class="idle-tabs" aria-label="Animation mode"><button id="idle-tab-emotes" type="button" aria-pressed="true">Emotes</button><button id="idle-tab-poses" type="button" aria-pressed="false">Idle poses <span>FREE CHOICE</span></button></nav>
        <div id="idle-panel" hidden>
          <div class="idle-intro"><span class="anim-eyebrow">YOUR CHARACTER · YOUR STANCE</span><h3>A pose to come back to.</h3><p>Choose any animation bank and clip. Your pose resumes when you stand still, unarmed and on foot. Press <kbd>F7</kbd> to see yourself.</p></div>
          <div class="idle-browser">
            <section class="idle-banks"><label for="idle-search">01 / FIND A BANK</label><input id="idle-search" type="search" placeholder="Search banks: relaxed, stand, female…" maxlength="128"><div id="idle-bank-list"></div><div class="idle-pagination"><button id="idle-bank-prev" type="button">←</button><span id="idle-bank-count"></span><button id="idle-bank-next" type="button">→</button></div></section>
            <section class="idle-clips"><label for="idle-bank">02 / CHOOSE YOUR CLIP</label><div class="idle-path"><input id="idle-bank" type="text" placeholder="Or paste any depot path ending in .anims" maxlength="512" spellcheck="false"><button id="idle-load" type="button">Load</button></div><input id="idle-clip-search" type="search" placeholder="Filter this bank’s clips…" maxlength="128"><div id="idle-clip-list"><p>Pick a bank to read its animations from the game.</p></div><div class="idle-pagination"><button id="idle-clip-prev" type="button">←</button><span id="idle-clip-count"></span><button id="idle-clip-next" type="button">→</button></div></section>
          </div>
          <footer class="idle-footer"><label for="idle-clip">Clip name <input id="idle-clip" type="text" maxlength="192" spellcheck="false" placeholder="Select a clip above or enter its exact name"></label><div class="idle-controls"><label>Blend (ms) <input id="idle-blend" type="number" min="0" max="5000" step="1" value="250" required></label><label>Resume after (ms) <input id="idle-delay" type="number" min="0" max="10000" step="1" value="700" required></label><button id="idle-reset" type="button">Reset to default</button><button id="idle-apply" type="button">Use this idle ↗</button></div><p id="idle-status" role="status" aria-live="polite">Default idle · No custom pose selected</p><p class="idle-note">The bank list is a search aid. Custom banks work too, when installed on every client. Choose an animation that fits your character’s rig; props and scene partners are not spawned.</p></footer>
        </div>
        <div class="anim-library">
          <nav class="anim-filters" id="anim-filters" aria-label="Animation categories"></nav>
          <div class="anim-content">
            <div class="anim-searchbar"><span aria-hidden="true">⌕</span><input id="anim-search" type="search" aria-label="Search animations" maxlength="128" placeholder="Search animations…" autocomplete="off" spellcheck="false"><kbd>/</kbd></div>
            <div class="anim-list-head"><span id="anim-count" role="status" aria-live="polite">Loading collection…</span><label><input id="anim-variants" type="checkbox"> All variants</label></div>
            <p class="anim-message" id="anim-message" role="alert" hidden></p>
            <div class="anim-loading" id="anim-loading" role="status"><span class="anim-spinner" aria-hidden="true"></span>Loading native animations…<button type="button" id="anim-retry">Retry</button></div>
            <div class="anim-grid" id="anim-grid" aria-label="Available animations"></div>
            <div class="anim-empty" id="anim-empty" hidden><strong id="anim-empty-title">NO MATCHES</strong><p id="anim-empty-text"></p><button type="button" id="anim-reset">Reset filters</button></div>
            <div class="anim-pagination" id="anim-pagination" hidden><button type="button" id="anim-prev" aria-label="Previous page">←</button><span id="anim-page"></span><button type="button" id="anim-next" aria-label="Next page">→</button></div>
          </div>
        </div>
        <footer class="anim-player">
          <div class="anim-current" role="status" aria-live="polite"><span class="anim-signal" aria-hidden="true"></span><span id="anim-status">READY</span><strong id="anim-current">No active animation</strong><button type="button" id="anim-stop" disabled>■ Stop</button></div>
          <div class="anim-selection">
            <div class="anim-selection-copy"><strong id="anim-selected">Choose an animation</strong><p id="anim-detail"></p></div>
            <button type="button" class="anim-icon-button" id="anim-favorite" aria-label="Favourite selected variant" aria-pressed="false">☆</button>
            <div class="anim-variant-stepper"><button type="button" id="anim-variant-prev" aria-label="Previous variant">‹</button><span id="anim-variant-count">—</span><button type="button" id="anim-variant-next" aria-label="Next variant">›</button></div>
            <button type="button" id="anim-play" disabled>▶ Play</button>
          </div>
          <div class="anim-options"><label><input type="checkbox" id="anim-loop" checked> Loop</label>
            <div id="anim-duration-wrap" hidden><input id="anim-duration" type="hidden" value="10000"><div class="anim-duration-buttons" role="group" aria-label="Animation duration"><button type="button" data-duration="5000" aria-pressed="false">5s</button><button type="button" data-duration="10000" aria-pressed="true">10s</button><button type="button" data-duration="30000" aria-pressed="false">30s</button></div></div>
            <span class="anim-help">Double-click to play · Moving cancels the stationary ones</span>
            <details id="anim-details"><summary>Details</summary><div><span id="anim-tested"></span><code id="anim-clip"></code><p>Native workspot bindings checked for male/female. Individual clips and props may still need adjustments. Stationary animations: stand still, unarmed and outside a vehicle; TPP activates for playback. On the move: keep walking, the camera stays yours. /anim stop cancels.</p></div></details>
          </div>
        </footer>
      </section>
      <section class="page" id="page-pvp" aria-label="PvP activity">
        <div class="pvp-intro"><span class="ds-section-label">FREEROAM COMBAT NETWORK</span>
          <h2>Pick your fight<span>.</span></h2>
          <p>Drop into free-for-all or queue for a team match. Your place in the city is saved when the fight starts.</p>
        </div>
        <div class="pvp-status-strip"><span class="ds-badge">LIVE</span><span id="pvp-population">Connecting to arena service</span></div>
        <div class="pvp-formats" aria-label="Match formats">
          <button class="pvp-format" data-pvp-format="ffa"><span class="pvp-format-number">FFA</span><strong>FREE-FOR-ALL</strong><small>Join instantly · Respawn and keep fighting</small><span class="pvp-format-meta">NO PLAYER CAP <i>ENTER →</i></span></button>
          <button class="pvp-format" data-pvp-format="blade"><span class="pvp-format-number">BLADE</span><strong>BLADE FFA</strong><small>Melee only · Double jump, dash and Overdrive</small><span class="pvp-format-meta">NO PLAYER CAP <i>ENTER →</i></span></button>
          <button class="pvp-format" data-pvp-format="1v1"><span class="pvp-format-number">1<span>V</span>1</span><strong>DUEL</strong><small>One opponent · Every round counts</small><span class="pvp-format-meta"><b data-pvp-queue="1v1">0 QUEUED</b><i>QUEUE →</i></span></button>
          <button class="pvp-format" data-pvp-format="2v2"><span class="pvp-format-number">2<span>V</span>2</span><strong>DOUBLES</strong><small>Two per side · Win together</small><span class="pvp-format-meta"><b data-pvp-queue="2v2">0 QUEUED</b><i>QUEUE →</i></span></button>
          <button class="pvp-format" data-pvp-format="3v3"><span class="pvp-format-number">3<span>V</span>3</span><strong>SQUADS</strong><small>Three per side · Control the arena</small><span class="pvp-format-meta"><b data-pvp-queue="3v3">0 QUEUED</b><i>QUEUE →</i></span></button>
        </div>
        <label class="pvp-option"><input type="checkbox" id="pvp-bots"> Allow labelled training bots (experimental) <small>All queued players must agree. Training matches do not affect rating.</small></label>
        <div class="pvp-current" id="pvp-current" hidden><div><span class="ds-section-label">YOUR ACTIVITY</span><strong id="pvp-current-label"></strong><p id="pvp-current-detail"></p></div><button class="btn danger" id="pvp-leave">LEAVE ACTIVITY</button></div>
        <div class="section-head compact"><h2>COMBAT LOADOUT</h2><p class="hint" id="pvp-loadout-hint">Choose your free-for-all primary. Sidearm and melee are supplied. Changes during a fight apply on respawn.</p></div>
        <div class="pvp-loadout-tabs" role="group" aria-label="Loadout mode"><button type="button" data-pvp-loadout="ffa" aria-pressed="true">FFA WEAPONS</button><button type="button" data-pvp-loadout="blade" aria-pressed="false">BLADE FFA WEAPONS</button></div>
        <label class="field-label" for="pvp-weapon-search">ARSENAL</label><input class="search" id="pvp-weapon-search" type="search" placeholder="Search weapon or category" autocomplete="off">
        <div class="pvp-weapons" id="pvp-weapons"></div>
        <div class="pvp-options"><label><input type="checkbox" id="pvp-sound" checked> COMBAT SFX</label><span>ESC CLOSES · /PVP REOPENS</span></div>
      </section>
      <section class="page active" id="page-vehicles">
        <div class="section-head" data-kicker="THE GARAGE">
          <h2>Find your next ride.</h2>
          <p class="hint" id="vehicle-hint">Vehicles are server-owned. No per-player spawn quota is enabled.</p>
        </div>
        <div class="stat-strip" id="vehicle-latest">GARAGE STATE UNAVAILABLE</div>
        <div class="catalog-heading"><label class="field-label" for="vehicle-search">Vehicle catalog</label><span id="vehicle-count" role="status"></span></div>
        <input type="text" class="search" id="vehicle-search" spellcheck="false"
               placeholder="Search vehicle or category">
        <div class="filters" id="vehicle-filters"></div>
        <div class="catalog-grid" id="vehicle-grid"></div>
        <details class="advanced" id="vehicle-custom"><summary>Spawn a custom model <span>Advanced</span></summary><div class="advanced-body custom">
          <input type="text" id="vehicle-record" spellcheck="false" aria-label="Vehicle record"
                 placeholder="Vehicle.v_sport1_rayfield_caliburn_player">
          <button class="btn primary" id="vehicle-spawn">SPAWN</button>
        </div></details>
        <div class="section-head compact"><h2>Your latest vehicle</h2><p class="hint">These controls apply to the last vehicle in your garage.</p></div>
        <div class="action-grid">
          <button class="btn" id="vehicle-repair">FULL REPAIR</button>
          <button class="btn" id="vehicle-engine-on">ENGINE ON</button>
          <button class="btn" id="vehicle-engine-off">ENGINE OFF</button>
          <button class="btn" id="vehicle-unlock">UNLOCK</button>
          <button class="btn" id="vehicle-lock">LOCK</button>
          <button class="btn" id="vehicle-lights">LIGHTS ON</button>
          <button class="btn" id="vehicle-lights-off">LIGHTS OFF</button>
        </div>
        <div class="row cleanup-actions">
          <button class="btn danger" id="vehicle-delete">Delete latest vehicle</button>
          <button class="btn danger" id="vehicle-delete-all">Delete my vehicles</button>
        </div>
      </section>

      <section class="page" id="page-weapons">
        <div class="section-head" data-kicker="THE ARMORY">
          <h2>Make it your loadout.</h2>
          <p class="hint">Pick a slot, then a weapon. Ammunition is included.</p>
        </div>
        <div class="slot-picker" id="weapon-slots">
          <button class="active" data-slot="1">SLOT 1</button>
          <button data-slot="2">SLOT 2</button>
          <button data-slot="3">SLOT 3</button>
        </div>
        <div class="loadout" id="weapon-loadout"></div>
        <div class="catalog-heading"><label class="field-label" for="weapon-search">Weapon catalog</label><span id="weapon-count" role="status"></span></div>
        <input type="text" class="search" id="weapon-search" spellcheck="false"
               placeholder="Search weapon or class">
        <div class="filters" id="weapon-filters"></div>
        <div class="catalog-grid weapons" id="weapon-grid"></div>
        <details class="advanced"><summary>Ammunition <span>Reserve &amp; magazine</span></summary><div class="advanced-body">
        <div class="ammo-row">
          <input type="text" id="ammo-reserve" value="500" spellcheck="false" aria-label="Reserve ammunition">
          <input type="text" id="ammo-magazine" placeholder="magazine: keep" spellcheck="false" aria-label="Magazine ammunition">
          <button class="btn primary" id="weapon-ammo">SET AMMO</button>
        </div>
        </div></details>
        <div class="action-grid">
          <button class="btn" id="weapon-activate">ACTIVATE SLOT</button>
          <button class="btn" id="weapon-refresh">REFRESH LOADOUT</button>
          <button class="btn" id="weapon-holster">HOLSTER</button>
          <button class="btn danger" id="weapon-remove">CLEAR SLOT</button>
        </div>
      </section>

      <section class="page" id="page-travel">
        <div class="section-head" data-kicker="AROUND NIGHT CITY"><h2>A change of scenery.</h2><p class="hint">Jump straight to a landmark or return to a spawn point.</p></div>
        <label class="field-label" for="travel-search">Find a destination</label><input type="text" id="travel-search" placeholder="Search by place or district" spellcheck="false">
        <div class="list" id="location-list"></div>
        <div class="section-head compact"><h2>SPAWN POINTS</h2></div>
        <div class="list" id="spawn-list"></div>
        <details class="advanced"><summary>Go to coordinates <span>Advanced</span></summary><div class="advanced-body">
        <p class="hint">Enter X, Y and Z. Heading is optional, in degrees.</p>
        <div class="coords">
          <label>X<input type="text" id="coord-x" placeholder="0.0" spellcheck="false"></label>
          <label>Y<input type="text" id="coord-y" placeholder="0.0" spellcheck="false"></label>
          <label>Z<input type="text" id="coord-z" placeholder="0.0" spellcheck="false"></label>
          <label>Heading<input type="text" id="coord-h" placeholder="0° (optional)" spellcheck="false"></label>
          <button class="btn primary" id="coord-go">TRAVEL</button>
        </div></div></details>
      </section>

      <section class="page" id="page-player">
        <div class="section-head" data-kicker="YOUR CHARACTER">
          <h2>A little more you.</h2>
          <p class="hint">Change your look, restore your vitals or get back into the city.</p>
        </div>
        <div class="stat-strip" id="player-status">PLAYER STATE UNAVAILABLE</div>
        <div class="player-actions">
          <button class="btn player-card featured" id="player-wardrobe"><span class="action-symbol" aria-hidden="true">01 / STYLE</span><strong>Open wardrobe</strong><small>Clothing, outfits and appearance.</small><i aria-hidden="true">↗</i></button>
          <button class="btn player-card" id="player-spawn"><span class="action-symbol" aria-hidden="true">02 / TRAVEL</span><strong>Return to spawn</strong><small>A fresh starting point in the city.</small><i aria-hidden="true">↗</i></button>
          <button class="btn player-card" id="player-restore"><span class="action-symbol" aria-hidden="true">03 / RECOVER</span><strong>Restore vitals</strong><small>Refill your health and armor.</small><i aria-hidden="true">+</i></button>
          <button class="btn player-card" id="player-revive"><span class="action-symbol" aria-hidden="true">04 / RECOVER</span><strong>Revive</strong><small>Get back up. Only available while dead.</small><i aria-hidden="true">+</i></button>
        </div>
        <details class="advanced"><summary>Sandbox options <span>Progression &amp; protection</span></summary><div class="advanced-body stack">
          <button class="btn" id="player-max-levels">Max levels<small>Attributes, levels, perks and traits.</small></button>
          <div class="row" id="godmode-controls">
            <button class="btn" id="player-god-on">GOD MODE ON</button>
            <button class="btn" id="player-god-off">GOD MODE OFF</button>
          </div>
        </div></details>
        <details class="advanced danger-zone"><summary>Respawn character <span>Ends your current life</span></summary><div class="advanced-body"><p class="hint">Kills your character and starts the automatic respawn.</p><button class="btn danger" id="player-suicide">End life &amp; respawn</button></div></details>
      </section>
      <section class="page" id="page-cyberware">
        <div class="section-head" data-kicker="CYBERWARE"><h2>Implant control.</h2><p class="hint">Character upgrades and implants.</p></div>
        <div class="empty-state"><span class="availability">FREEROAM MOVEMENT</span><h3>The city is your playground.</h3><p>Double jump and advanced ground / air dash are enabled for everyone throughout Freeroam. Open Cyberlab to view your cyberware and abilities.</p><button class="btn primary" id="cyberware-open">OPEN CYBERLAB →</button></div>
      </section>
      <section class="page" id="page-tv">
        <div class="section-head" data-kicker="SHARED SCREENS">
          <h2>Put something on.</h2>
          <p class="hint">Place a television in front of you and share a web page with everyone nearby.</p>
        </div>
        <div class="stat-strip" id="tv-status" role="status">Requesting television catalog…</div>

        <label class="field-label" for="tv-url">URL FOR THE NEXT SPAWNED SET</label>
        <input type="text" class="search" id="tv-url" spellcheck="false"
               placeholder="https://... (leave empty for the idle test pattern)" />
        <label class="field-label" for="tv-search">TELEVISION RECORDS</label>
        <input type="text" class="search" id="tv-search" spellcheck="false"
               placeholder="Filter records" />
        <div class="catalog-grid weapons" id="tv-grid"></div>
        <p class="hint" id="tv-note"></p>

        <div class="section-head compact">
          <h2>SETS ON THIS SERVER</h2>
          <p class="hint">Nearest screens first. Changes apply to everyone watching that television.</p>
        </div>
        <details class="advanced"><summary>Placement &amp; visibility <span>How it works</span></summary><div class="advanced-body"><p class="hint">Only the nearest screens are rendered. Look for ON SCREEN to control a television you can see.</p><p class="hint">Placement is relative to the television: LEFT is its left, FORWARD is the direction it faces. Select a step size, then move or rotate it by 15°. Its URL and playback settings are kept.</p></div></details>
        <div class="stat-strip" id="tv-local-count">NO SETS IN RANGE</div>
        <div class="catalogue-grid" id="tv-screens"></div>
        <div class="action-grid">
          <button class="btn" id="tv-refresh">REFRESH</button>
        </div>
        <p class="hint" id="tv-screens-note"></p>
      </section>
    </div>

    <footer class="foot">
      <span class="session-dot" aria-hidden="true"></span><span>Open//77 · Sandbox</span>
      <span class="foot-search"><kbd>/</kbd> Search this section</span>
      <span class="foot-command"><span class="ds-data">/freeroam</span> to reopen</span>
    </footer>
  </aside>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</div>
<div id="race-ui" class="race-ui" data-phase="waiting">
  <main id="race-raceHud" aria-live="polite">
    <section class="race-bar" id="race-raceBar">
      <div class="mode-lockup">
        <span class="eyebrow"><b>//</b> FREEROAM · RACE</span>
        <strong id="race-hudCourse">RACE</strong>
      </div>
      <div class="metric position"><span>POSITION</span><strong id="race-hudPosition">--</strong></div>
      <div class="metric"><span id="race-hudLapLabel">LAP</span><strong id="race-hudLap">-/ -</strong></div>
      <div class="metric"><span>CHECKPOINT</span><strong id="race-hudCheckpoint">-/ -</strong></div>
      <div class="timer"><span id="race-hudTimeLabel">RACE TIME</span><time id="race-hudTime">00:00.000</time></div>
      <div class="recovery-hint hidden" id="race-recoveryHint"><kbd id="race-returnKey">F3</kbd> RETURN TO CHECKPOINT</div>
    </section>

    <aside class="next-card" id="race-nextCard">
      <span class="eyebrow">NEXT CHECKPOINT</span>
      <strong id="race-nextIndex">-- / --</strong>
      <div><span id="race-nextLap">LAP --/--</span><i></i><span id="race-bestLap">BEST --:--.---</span></div>
    </aside>

    <section class="checkpoint-guide" id="race-checkpointGuide" aria-label="Direction du prochain checkpoint">
      <span class="guide-kicker" id="race-guideCheckpoint">CHECKPOINT -- / --</span>
      <div class="guide-stage" id="race-guideStage">
        <svg class="guide-arrow" id="race-guideArrow" viewBox="0 0 160 185" aria-hidden="true">
          <defs>
            <linearGradient id="race-guideFace" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#BDF9FC"/>
              <stop offset=".42" stop-color="#22D8E2"/>
              <stop offset="1" stop-color="#12B4BE"/>
            </linearGradient>
            <linearGradient id="race-guideEdge" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#0B7F87"/>
              <stop offset="1" stop-color="#0A2A2E"/>
            </linearGradient>
            <filter id="race-guideGlow" x="-60%" y="-60%" width="220%" height="240%">
              <feGaussianBlur stdDeviation="5" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          <path class="guide-arrow-shadow" d="M80 5 151 73 115 73 115 160 45 160 45 73 9 73Z"/>
          <path class="guide-arrow-depth" d="M80 17 151 85 115 85 115 172 45 172 45 85 9 85Z" fill="url(#race-guideEdge)"/>
          <path class="guide-arrow-face" d="M80 5 151 73 115 73 115 160 45 160 45 73 9 73Z" fill="url(#race-guideFace)"/>
          <path class="guide-arrow-shine" d="M80 15 132 65 108 65 108 151 92 151 92 58 64 58Z"/>
        </svg>
      </div>
      <div class="guide-readout"><strong id="race-guideDistance">--- M</strong><span id="race-guideDirection">AHEAD</span></div>
    </section>

    <aside class="live-order" id="race-liveOrder" aria-label="Classement temps réel">
      <header><span>LIVE ORDER</span><kbd>TAB</kbd></header>
      <div id="race-liveRows"></div>
    </aside>

    <section class="countdown" id="race-countdown">
      <div class="countdown-frame">
        <i class="countdown-wing left"></i><i class="countdown-wing right"></i>
        <span id="race-countdownLabel">GRID LOCKED</span>
        <strong id="race-countdownValue">3</strong>
        <small id="race-countdownCourse">PREPARE TO RACE</small>
      </div>
    </section>

    <section class="pulse" id="race-pulse"><strong id="race-pulseText">CHECKPOINT</strong></section>

    <section class="result-banner" id="race-resultBanner">
      <span class="eyebrow">OFFICIAL RESULT</span>
      <strong id="race-resultTitle">FINISH</strong>
      <p id="race-resultText"></p>
    </section>

    <aside class="toasts" id="race-toasts"></aside>

    <section class="editor-drive-hud" id="race-editorDriveHud" aria-label="Course drive editor">
      <header>
        <div><span class="eyebrow"><b>//</b> COURSE CREATOR</span><strong id="race-driveCourseName">NEW NIGHT CITY RACE</strong></div>
        <span class="drive-live" id="race-editorMode">DRIVE MODE</span>
      </header>
      <div class="drive-counts">
        <span><i class="start"></i>START <b id="race-driveStartCount">0 / 1</b></span>
        <span><i class="grid"></i>GRID <b id="race-driveGridCount">0</b></span>
        <span><i class="checkpoint"></i>CP <b id="race-driveCheckpointCount">0</b></span>
      </div>
      <div class="drive-primary-actions">
        <div><kbd id="race-keyCaptureStart">F6</kbd><span>CAPTURE START</span></div>
        <div><kbd id="race-keyCaptureGrid">F7</kbd><span>ADD GRID SLOT</span></div>
        <div><kbd id="race-keyCaptureCheckpoint">F8</kbd><span>ADD CHECKPOINT</span></div>
      </div>
      <div class="drive-secondary-actions">
        <span><kbd id="race-keyReturnCheckpoint">F3</kbd> RETURN TO CP</span>
        <span><kbd id="race-keyVehicle">F4</kbd> CAR</span>
        <span><kbd id="race-keyMenu">F5</kbd> OPTIONS</span>
        <span><kbd id="race-keyUndoCheckpoint">F9</kbd> − CP</span>
        <span><kbd id="race-keyUndoGrid">F10</kbd> − GRID</span>
        <span><kbd id="race-keySave">F11</kbd> SAVE</span>
        <span><kbd id="race-keyExit">END</kbd> EXIT</span>
      </div>
      <p class="drive-status" id="race-driveStatus">Drive to a point and use a mapped capture key.</p>
      <footer>REMAP IN PAUSE → SETTINGS → KEY BINDINGS</footer>
    </section>

    <section class="scoreboard" id="race-scoreboard" aria-label="Classement Race">
      <header>
        <div><span class="eyebrow">OPEN77 OFFICIAL TIMING</span><h1 id="race-boardCourse">RACE CLASSIFICATION</h1></div>
        <div class="board-clock"><span id="race-boardPhase">LOBBY</span><time id="race-boardTime">00:00.000</time></div>
      </header>
      <div class="board-meta" id="race-boardMeta">CIRCUIT · 1 LAP · 0 CHECKPOINTS</div>
      <div class="board-columns"><span>POS</span><span id="race-participantLabel">DRIVER</span><span>STATUS</span><span>LAP</span><span>CHECKPOINT</span><span>TIME</span><span>BEST LAP</span></div>
      <div class="board-rows" id="race-boardRows"></div>
      <div class="board-empty" id="race-boardEmpty">The live classification starts when the grid forms.</div>
      <footer><span>SERVER-AUTHORITATIVE TIMING</span><span>HOLD <kbd>TAB</kbd> TO VIEW</span></footer>
    </section>

    <div class="scrim" id="race-scrim"></div>
    <section class="control-panel" id="race-controlPanel" role="dialog" aria-label="Race lobby">
      <button class="close" id="race-closePanel" aria-label="Fermer">×</button>
      <header class="lounge-header">
        <div><button class="back-link" id="race-backFreeroam">← FREEROAM</button>
          <h2>Night City <span id="race-activityTitle">racing.</span></h2>
          <p id="race-activityDescription">Pick your route. Find your rivals. Make the grid.</p></div>
        <span class="lounge-live"><i></i> LIVE LOBBY</span>
      </header>
      <nav class="tabs">
        <button class="tab active" data-tab="lobby">Race lobby</button>
        <button class="tab" data-tab="courses">Course library</button>
        <button class="tab editor-tab hidden" data-tab="editor" id="race-editorTab">EDITOR</button>
      </nav>

      <div class="tab-page active" data-page="lobby">
        <section class="session-stage" id="race-sessionStage">
          <div class="stage-copy"><span class="eyebrow" id="race-stageLabel">THE NEXT HEAT</span>
            <h3 id="race-stageTitle">The city is your starting line.</h3>
            <p id="race-stageHint">Join the queue to open the course vote.</p></div>
          <div class="stage-clock"><span id="race-clockLabel">WAITING FOR DRIVERS</span>
            <time id="race-lobbyClock">—</time><div class="clock-track"><i id="race-clockProgress"></i></div></div>
        </section>
        <div class="lounge-grid">
          <section class="ballot-section" aria-label="Next course vote">
            <header class="lounge-section-title"><div><span class="eyebrow">01 / THE ROUTE</span>
              <h3 id="race-voteTitle">Where to next?</h3></div><span id="race-voteSummary">Join to vote</span></header>
            <div class="vote-courses" id="race-voteCourses"></div>
            <p class="vote-help" id="race-voteHelp">One driver, one vote. You can change your mind until voting closes.</p>
            <div class="heat-summary hidden" id="race-currentHeat"></div>
          </section>
          <aside class="drivers-section" aria-label="Live race participants">
            <header class="lounge-section-title"><div><span class="eyebrow" id="race-rosterLabel">02 / THE DRIVERS</span>
              <h3>On the grid.</h3></div><span class="driver-count" id="race-driverCount">0</span></header>
            <div class="roster-list" id="race-rosterList"></div>
            <p class="roster-foot" id="race-rosterFoot">Unlimited queue · Course-sized grids</p>
          </aside>
        </div>
        <footer class="lounge-footer">
          <div class="queue-status"><span class="eyebrow" id="race-queueLabel">YOUR NEXT RACE</span>
            <p id="race-queueCopy">Join the next heat.</p></div>
          <div class="panel-actions">
            <button class="primary" id="race-joinButton">JOIN &amp; VOTE <span>↗</span></button>
            <button class="secondary hidden" id="race-leaveQueueButton">LEAVE QUEUE</button>
            <button class="secondary hidden" id="race-returnCheckpointButton">RETURN TO CHECKPOINT</button>
            <button class="danger hidden" id="race-leaveRaceButton">FORFEIT RACE</button>
          </div>
        </footer>
        <div class="lounge-bottom"><span>RACE TOGETHER. RETURN TO YOUR SESSION.</span>
          <button class="back-link" id="race-openEditor">COURSE EDITOR ↗</button></div>
      </div>

      <div class="tab-page" data-page="courses">
        <p class="section-copy">Explore the server's routes. Players vote before each heat; admins can select a course for one heat.</p>
        <div class="course-list" id="race-courseList"></div>
      </div>

      <div class="tab-page editor-page" data-page="editor">
        <div class="editor-status" id="race-editorStatus">Admin editor session active.</div>
        <label>COURSE NAME<input id="race-editName" maxlength="64" autocomplete="off"></label>
        <label>DESCRIPTION<textarea id="race-editDescription" maxlength="240"></textarea></label>
        <div class="editor-field" id="race-vehicleField"><span>RACE VEHICLE</span>
          <div class="custom-dropdown" id="race-editVehicle" data-value="">
            <button class="custom-dropdown-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="race-editVehicleMenu">
              <span class="custom-dropdown-value">SELECT VEHICLE</span><i aria-hidden="true"></i>
            </button>
            <div class="custom-dropdown-menu" id="race-editVehicleMenu" role="listbox" aria-label="Race vehicle"></div>
          </div>
        </div>
        <div class="form-row">
          <div class="editor-field"><span>FORMAT</span>
            <div class="custom-dropdown" id="race-editType" data-value="circuit">
              <button class="custom-dropdown-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="race-editTypeMenu">
                <span class="custom-dropdown-value">CIRCUIT / MULTILAP</span><i aria-hidden="true"></i>
              </button>
              <div class="custom-dropdown-menu" id="race-editTypeMenu" role="listbox" aria-label="Race format"></div>
            </div>
          </div>
          <label>LAPS<input id="race-editLaps" type="number" min="1" max="99" step="1"></label>
          <label>ZONE RADIUS<input id="race-editRadius" type="number" min="2" max="30" step="0.5"></label>
        </div>
        <p class="editor-hint" id="race-captureHint">Drive onto the exact mark and face the desired direction before each capture.</p>
        <div class="capture-grid">
          <button class="capture" id="race-captureStart"><span>01</span><b>CAPTURE START</b><small id="race-startState">Not captured</small></button>
          <button class="capture" id="race-addCheckpoint"><span>+</span><b>ADD CHECKPOINT</b><small>Current server position</small></button>
          <button class="capture grid-slot" id="race-captureGrid"><span>▦</span><b>ADD VEHICLE GRID SLOT</b><small>One exact, non-overlapping spawn position per racer</small></button>
        </div>
        <div class="checkpoint-head"><span>STARTING GRID</span><b id="race-gridCount">0 SLOTS</b></div>
        <div class="checkpoint-list grid-list" id="race-gridList"></div>
        <button class="inline-undo" id="race-undoGrid">UNDO LAST GRID SLOT</button>
        <div class="checkpoint-head"><span>CHECKPOINTS</span><b id="race-checkpointCount">0</b></div>
        <div class="checkpoint-list" id="race-checkpointList"></div>
        <div class="editor-actions">
          <button class="secondary" id="race-newCourse">NEW</button>
          <button class="secondary" id="race-undoCheckpoint">UNDO CHECKPOINT</button>
          <button class="primary" id="race-saveCourse">SAVE COURSE</button>
        </div>
        <div class="editor-actions editor-session-actions">
          <button class="secondary hidden" id="race-editorReturnCheckpoint">RETURN TO CHECKPOINT</button>
          <button class="secondary" id="race-respawnEditorVehicle">RESPAWN CAR</button>
          <button class="danger" id="race-exitEditor">EXIT DRIVE MODE</button>
        </div>
        <div class="editor-catalog" id="race-editorCatalog"></div>
      </div>
    </section>
  </main>
  </div>
  <script src="app.js"></script>
  <script src="race/app.js"></script>
  <div id="pvp-hud" class="pvp-hud" hidden aria-label="PvP match HUD">
    <div id="pvp-overdrive-glow" class="pvp-overdrive-glow" hidden aria-hidden="true"></div>
    <section id="pvp-overdrive" class="pvp-overdrive" hidden aria-label="Overdrive status"><kbd>X</kbd><div><span>OVERDRIVE</span><strong id="pvp-overdrive-status">READY</strong></div><div class="pvp-overdrive-track"><i id="pvp-overdrive-fill"></i></div></section>
    <section class="pvp-matchbar"><div><span class="pvp-eyebrow" id="pvp-mode">FREE-FOR-ALL</span><strong id="pvp-objective">FREEROAM ARENA</strong><small id="pvp-match-hint"></small></div><div class="pvp-scoreline" id="pvp-scoreline"></div><div class="pvp-clock"><span id="pvp-phase">LIVE</span><strong id="pvp-timer">05:00</strong></div></section>
    <div class="pvp-protection" id="pvp-protection" hidden>SPAWN PROTECTION <strong id="pvp-protection-time"></strong><small>Attacking ends protection</small></div>
    <section class="pvp-personal"><header><span id="pvp-rank">P1</span><span>YOUR PERFORMANCE</span><kbd>TAB</kbd></header><div class="pvp-stat-grid"><div><strong id="pvp-kills">0</strong><span>KILLS</span></div><div><strong id="pvp-deaths">0</strong><span>DEATHS</span></div><div><strong id="pvp-assists">0</strong><span>ASSISTS</span></div></div><footer id="pvp-streak">/PVP · LOADOUT / LEAVE</footer></section>
    <div class="pvp-feed" id="pvp-feed" aria-live="polite"></div>
    <section class="pvp-death" id="pvp-death" hidden><span class="pvp-eyebrow">SIGNAL LOST</span><h2 id="pvp-death-title">ELIMINATED</h2><p id="pvp-death-detail"></p><strong id="pvp-respawn"></strong></section>
    <section class="pvp-board" id="pvp-board" hidden><header><span class="pvp-eyebrow">COMBAT REPORT</span><h2 id="pvp-board-title">LIVE STANDINGS</h2><p id="pvp-board-subtitle"></p></header><div class="pvp-table-scroll"><table><thead><tr><th>#</th><th>PLAYER</th><th>K</th><th>D</th><th>A</th><th>SCORE</th></tr></thead><tbody id="pvp-rows"></tbody></table></div></section>
  </div>
  <div class="pvp-queue-dock" id="pvp-queue-dock" hidden><span class="pvp-eyebrow">ARENA MATCHMAKING</span><strong id="pvp-queue-label"></strong><small>Explore the city while you wait · /pvp</small></div>
  <div class="pvp-notice" id="pvp-notice" hidden role="status"><span class="pvp-eyebrow" id="pvp-notice-title"></span><p id="pvp-notice-body"></p></div>
  <script src="pvp/app.js"></script>
  <script src="animations/catalog.js"></script>
  <script src="animations/app.js"></script>
  <script src="animations/banks.js"></script>
  <script src="animations/idle.js"></script>
</body>
</html>
* { margin: 0; padding: 0; }

html, body {
  overflow: hidden;
  pointer-events: none;
  user-select: none;
}

.feed {
  position: absolute;
  top: 92px;
  right: 360px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--space-3);
}

.entry {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-width: 270px;
  padding: 10px var(--space-4);
  border: 1px solid var(--line-hud);
  border-left: 2px solid var(--o-magenta-500);
  background: rgba(11, 14, 20, 0.9);
  color: var(--text-primary);
  clip-path: var(--cut-sm);
  backdrop-filter: var(--blur-hud);
  box-shadow: var(--shadow-panel);
  opacity: 0;
  transform: translateX(16px);
  transition: opacity var(--dur-3) var(--ease-out), transform var(--dur-3) var(--ease-out);
}
.entry.visible { opacity: 1; transform: translateX(0); }
.entry.expiring { opacity: 0; transform: translateX(16px); }

.entry .killer, .entry .victim {
  overflow: hidden;
  font: var(--fw-semibold) var(--size-body-sm) / 1 var(--font-ui);
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}
.entry .killer { color: var(--o-cyan-500); }
.entry .victim { color: var(--text-primary); }
.entry .skull {
  margin-left: auto;
  color: var(--o-magenta-500);
  font: var(--fw-semibold) 9px / 1 var(--font-ui);
  letter-spacing: var(--ls-label);
}
.entry.unattributed { border-left-color: var(--text-muted); }
.entry.unattributed .victim { color: var(--text-secondary); }

.hitmarker {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 34px;
  height: 34px;
  opacity: 0;
  transform: translate(-50%, -50%);
}
.hitmarker.show { animation: hit-pop 220ms var(--ease-out); }
.hitmarker.lethal .hm { background: var(--o-magenta-500); box-shadow: 0 0 8px var(--o-magenta-500); }
.hitmarker.headshot .hm { background: var(--o-amber-500); box-shadow: 0 0 8px var(--o-amber-500); }

.hm {
  position: absolute;
  width: 12px;
  height: 3px;
  background: var(--text-primary);
  box-shadow: 0 0 2px rgba(0, 0, 0, 0.95);
}
.hm-tl { top: 6px; left: 0; transform: rotate(45deg); }
.hm-tr { top: 6px; right: 0; transform: rotate(-45deg); }
.hm-bl { bottom: 6px; left: 0; transform: rotate(-45deg); }
.hm-br { right: 0; bottom: 6px; transform: rotate(45deg); }

.damage-flash {
  position: absolute;
  inset: 0;
  opacity: 0;
  background: radial-gradient(ellipse at center, transparent 55%, rgba(255, 59, 78, 0.42) 100%);
}
.damage-flash.show { animation: damage-fade 420ms ease-out; }

@keyframes hit-pop {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(1.35); }
  25% { opacity: 1; }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
}

@keyframes damage-fade {
  0% { opacity: 0; }
  15% { opacity: 1; }
  100% { opacity: 0; }
}

@media (max-width: 1500px) {
  .feed { right: 300px; }
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Open77 — Combat feed</title>
  <link rel="stylesheet" href="design-system.css">
  <link rel="stylesheet" href="killfeed.css">
</head>
<body>
  <div class="damage-flash" id="damage-flash"></div>
  <div class="hitmarker" id="hitmarker">
    <span class="hm hm-tl"></span><span class="hm hm-tr"></span>
    <span class="hm hm-bl"></span><span class="hm hm-br"></span>
  </div>
  <div class="feed" id="feed" aria-live="polite" aria-label="Kill feed"></div>
  <script src="killfeed.js"></script>
</body>
</html>
(() => {
  "use strict";

  const feedEl = document.getElementById("feed");
  const hitmarkerEl = document.getElementById("hitmarker");
  const flashEl = document.getElementById("damage-flash");

  let maxEntries = 5;
  let entryTtlMs = 6000;
  let hitmarkerTimer = 0;
  let flashTimer = 0;

  function addEntry(payload) {
    const killer = String((payload && payload.killer) || "").slice(0, 48);
    const victim = String((payload && payload.victim) || "").slice(0, 48);
    if (!victim) return;

    const entry = document.createElement("div");
    entry.className = "entry" + (killer ? "" : " unattributed");

    if (killer) {
      const killerEl = document.createElement("span");
      killerEl.className = "killer";
      killerEl.textContent = killer;
      entry.append(killerEl);
    }
    const skull = document.createElement("span");
    skull.className = "skull";
    // The design language uses tracked labels, never emoji. Keep the transport
    // neutral and let this compact action label carry the relationship.
    skull.textContent = "ELIM";
    const victimEl = document.createElement("span");
    victimEl.className = "victim";
    victimEl.textContent = victim;
    entry.append(skull, victimEl);

    feedEl.append(entry);
    requestAnimationFrame(() => entry.classList.add("visible"));
    while (feedEl.children.length > maxEntries) feedEl.firstChild.remove();
    setTimeout(() => {
      entry.classList.add("expiring");
      setTimeout(() => entry.remove(), 220);
    }, entryTtlMs);
  }

  function showHitmarker(payload) {
    hitmarkerEl.classList.remove("show", "lethal", "headshot");
    if (payload && payload.lethal) hitmarkerEl.classList.add("lethal");
    else if (payload && payload.bodyPart === "head") hitmarkerEl.classList.add("headshot");
    // Restart the CSS animation even when hits land back to back.
    void hitmarkerEl.offsetWidth;
    hitmarkerEl.classList.add("show");
    clearTimeout(hitmarkerTimer);
    hitmarkerTimer = setTimeout(() => hitmarkerEl.classList.remove("show"), 240);
  }

  function showDamageFlash() {
    flashEl.classList.remove("show");
    void flashEl.offsetWidth;
    flashEl.classList.add("show");
    clearTimeout(flashTimer);
    flashTimer = setTimeout(() => flashEl.classList.remove("show"), 440);
  }

  Open77.on("killfeed:config", payload => {
    if (payload && Number(payload.maxEntries) > 0) maxEntries = Number(payload.maxEntries);
    if (payload && Number(payload.entryTtlMs) > 0) entryTtlMs = Number(payload.entryTtlMs);
  });
  Open77.on("killfeed:entry", addEntry);
  Open77.on("killfeed:hit", showHitmarker);
  Open77.on("killfeed:damaged", showDamageFlash);

  Open77.ready();
  Open77.emit("killfeed:ready", {});
})();
/* =============================================================================
   OPEN//77 - in-game UI design tokens
   =============================================================================

   MIRRORED FILE. Every in-game WebUI resource ships a byte-identical copy at
   `<resource>/web/open77-ui.css`. Do not edit one copy: edit them all, then
   verify they still match (the one-line check is in `docs/ui-design-system.md`).

   Why a copy and not a shared file: each resource's WebUI runs under its own
   isolated virtual origin and can only load files declared in its own manifest,
   so `resources/A/web/index.html` cannot reference a stylesheet that lives in
   `resources/B/web/`. There is no shared origin to put one file on. The same
   reasoning is already recorded in the token blocks of `open77_pause` and
   `open77_debug`; this file replaces those twelve divergent blocks with twelve
   identical ones.

   Source of truth: the OPEN//77 website design system -
   `app/references/design-system.md` (the "OPEN SIGNAL" addendum, which the
   document itself marks as superseding its section 1) and
   `app/src/styles/legacy/01-tokens.css`. Values below are those values.
   Deviations are marked `IN-GAME:` and each carries its reason.
   ========================================================================== */

:root {
  /* --- FIELD ---------------------------------------------------------------
     The night. Never pure black: on the site because black reads as a void,
     in-game because a black panel over a night street disappears. */
  --op77-void:       #060a12;
  --op77-bg:         #080e19;
  --op77-bg-elev:    #0d1624;
  --op77-surface:    #101b2b;
  --op77-surface-2:  #132032;

  /* IN-GAME: panel fills drawn over live gameplay.
     The site can use flat opaque surfaces because nothing moves behind them.
     A HUD panel sits over a scene that swings from a blown-out white plaza to a
     black alley, so its backing must stay opaque enough to hold text at either
     extreme. 0.94 is the floor for anything carrying words; use --op77-panel
     for read-me-now surfaces and --op77-panel-quiet only for decoration. */
  --op77-panel:        rgba(10, 18, 32, 0.94);
  --op77-panel-raised: rgba(16, 27, 43, 0.96);
  --op77-panel-quiet:  rgba(10, 18, 32, 0.78);
  --op77-scrim:        rgba(3, 7, 13, 0.72);

  /* --- LINES ---------------------------------------------------------------
     Blue-gray hairlines, never cyan. Depth comes from borders, not shadows. */
  --op77-line:        rgba(174, 211, 224, 0.10);
  --op77-line-strong: rgba(174, 211, 224, 0.19);
  /* IN-GAME: a 10%-alpha hairline vanishes against a bright frame. Panel
     outlines that must survive any backdrop use --op77-line-hud. */
  --op77-line-hud:    rgba(174, 211, 224, 0.30);

  /* --- INK -----------------------------------------------------------------
     Contrast measured against --op77-surface #101b2b:
       text       16.2:1   body and headings, any size
       text-dim    6.2:1   secondary copy, passes AA at any size
       text-faint  3.6:1   decoration and disabled only - never body copy */
  --op77-text:       #f2f6f8;
  --op77-text-dim:   #8d99a8;
  --op77-text-faint: rgba(141, 153, 168, 0.72);
  --op77-ink:        #071013;  /* text ON an accent fill - never white */

  /* --- SIGNAL --------------------------------------------------------------
     One chromatic family with depth. Cyan = platform / active / connected.
     Coral = live / full / featured / new - semantic only, never a CTA.
     Budget: if a viewport shows more than ~3 cyan elements, remove some. */
  --op77-accent:       #22d8e2;   /* OPEN Electric - CTAs, links, active state */
  --op77-accent-ice:   #70f3f5;   /* OPEN Ice - brand mark and hover peaks     */
  --op77-accent-deep:  #18c8d4;   /* OPEN Deep - second signal channel         */
  --op77-accent-soft:  rgba(34, 216, 226, 0.12);
  --op77-accent-line:  rgba(34, 216, 226, 0.45);
  --op77-signal:       #ff5964;   /* coral - live / full / featured / new      */
  --op77-danger:       #ff5c5c;   /* errors, destructive, offline              */

  /* IN-GAME: the site has no success or warning role because a marketing page
     never has to say "spawned" or "connection degraded". A HUD does. These two
     are the only colours here with no website counterpart; they are tuned to
     sit in the same cold family rather than borrowing the game's own palette. */
  --op77-ok:   #4fe3a9;
  --op77-warn: #f5c95c;

  /* Reserved for live things only - status dots, a running counter, an active
     nav state. Never on static decoration. */
  --op77-glow: 0 0 24px rgba(34, 216, 226, 0.25);

  /* --- TYPE ----------------------------------------------------------------
     The website self-hosts Rajdhani / Saira / IBM Plex Mono through next/font.
     In-game there is no network and no font is bundled with any resource, so
     those three names NEVER resolve and every surface silently fell back to
     whatever came next in its stack - which is why the twelve surfaces do not
     look related today. They are kept first in each stack so that bundling a
     webfont later takes over with no edit here.

     What actually renders is the second name in each stack, chosen to carry the
     same voice from fonts Windows ships:
       display  Bahnschrift Condensed  - DIN-derived, squared terminals, the
                                         closest shipping face to Rajdhani
       body     Bahnschrift            - same family, normal width
       mono     Cascadia Mono          - the micro-label and data voice */
  --op77-font-display: "Rajdhani", "Bahnschrift Condensed", "Bahnschrift SemiCondensed", "Arial Narrow", "Segoe UI", sans-serif;
  --op77-font-body:    "Saira", "Bahnschrift", "Segoe UI", system-ui, sans-serif;
  --op77-font-mono:    "IBM Plex Mono", "Cascadia Mono", "Consolas", ui-monospace, monospace;

  /* HUD type scale. Larger than the website's page scale on purpose: this text
     is read at arm's length over a moving image, not on a document. */
  --op77-fs-micro:  9px;    /* mono eyebrow, letter-spacing .18em, UPPERCASE  */
  --op77-fs-label:  10px;   /* mono labels, keycaps                          */
  --op77-fs-meta:   11px;   /* mono data, secondary lines                    */
  --op77-fs-body:   14px;   /* the default                                   */
  --op77-fs-lead:   16px;   /* the one line that must be read first          */
  --op77-fs-title:  18px;   /* card and toast titles                         */
  --op77-fs-head:   26px;   /* panel headings                                */
  --op77-fs-hero:   40px;   /* countdowns, verdicts                          */

  --op77-track-micro: 0.18em;  /* mono eyebrows */
  --op77-track-label: 0.12em;  /* mono labels   */
  --op77-track-head:  0.02em;  /* display heads */

  /* --- SPACE ---------------------------------------------------------------
     Base-4. Density lives inside panels, not between them. */
  --op77-space-1: 4px;
  --op77-space-2: 8px;
  --op77-space-3: 12px;
  --op77-space-4: 16px;
  --op77-space-5: 24px;
  --op77-space-6: 32px;
  --op77-space-7: 48px;
  --op77-space-8: 64px;

  /* IN-GAME: distance from the viewport edge for every HUD surface, so the
     twelve of them line up instead of each picking its own vh/vw. */
  --op77-inset-x: 32px;
  --op77-inset-y: 28px;

  /* --- SHAPE ---------------------------------------------------------------
     Square-leaning. 6px is the maximum radius anywhere in the system. */
  --op77-radius-sm: 2px;
  --op77-radius-md: 6px;
  --op77-notch: 12px;
  --op77-notch-clip: polygon(0 0, calc(100% - var(--op77-notch)) 0, 100% var(--op77-notch), 100% 100%, 0 100%);
  /* Accent rule down the leading edge of a panel - the house marker for
     "this belongs to Open77". 3px; 2px on small items. */
  --op77-rule: 3px;

  /* IN-GAME: the site forbids shadows for elevation and it is right - on a flat
     page a border is enough. Over gameplay a border alone does not separate a
     panel from a detailed backdrop, so one shadow is allowed, and only this
     one. It is a separation device, not a depth ramp: there are no levels. */
  --op77-shadow: 0 8px 28px rgba(0, 0, 0, 0.55);

  /* --- MOTION --------------------------------------------------------------
     Functional and fast. No glitch loops, no parallax, no idle animation. */
  --op77-ease: cubic-bezier(0.2, 0, 0, 1);
  --op77-dur-fast: 90ms;    /* colour and border changes  */
  --op77-dur:      150ms;   /* enter, leave, hover        */
  --op77-dur-slow: 220ms;   /* a whole panel sliding in   */
}

/* The `//` device. Where it appears, nothing else glows.
   Use as: <span class="op77-eyebrow">Session</span> */
.op77-eyebrow {
  font: 700 var(--op77-fs-micro) / 1 var(--op77-font-mono);
  letter-spacing: var(--op77-track-micro);
  text-transform: uppercase;
  color: var(--op77-text-dim);
}
.op77-eyebrow::before {
  content: "//";
  margin-right: 0.7em;
  color: var(--op77-accent);
  font-weight: 900;
  letter-spacing: -0.06em;
}

/* Animation enhances, it never gates: nothing here starts at opacity 0 without
   a paired end state, and all of it is off when the player asked for less. */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 1ms !important;
    animation-delay: 0ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 1ms !important;
    transition-delay: 0ms !important;
    scroll-behavior: auto !important;
  }
}
(() => {
  'use strict';
  const $ = id => document.getElementById(`pvp-${id}`);
  const list = value => Array.isArray(value) ? value : [];
  const number = value => Number.isFinite(Number(value)) ? Number(value) : 0;
  const write = (id, value) => { $(id).textContent = String(value ?? ''); };
  const emit = (action, data = {}) => Open77.emit('pvp:action', { action, ...data });
  let state = {}, weapons = [], chosen = '', anchor = performance.now(), board = false, noticeTimer, weaponSignature = '';
  let bladeWeapons = [], bladeChosen = '', loadoutMode = 'ffa';
  const formatNames = { ffa:'FREE-FOR-ALL', blade:'BLADE FFA', '1v1':'DUEL', '2v2':'DOUBLES', '3v3':'SQUADS' };
  function open() {
    document.getElementById('freeroam-menu').dispatchEvent(new CustomEvent('freeroam:navigate', { detail: 'pvp' }));
  }
  function formatTime(ms) {
    const seconds = Math.ceil(Math.max(0,ms) / 1000);
    return `${Math.floor(seconds/60).toString().padStart(2,'0')}:${(seconds%60).toString().padStart(2,'0')}`;
  }
  function notify(payload) {
    write('notice-title', payload.title || 'PVP'); write('notice-body', payload.message);
    $('notice').hidden = false; clearTimeout(noticeTimer);
    noticeTimer = setTimeout(() => { $('notice').hidden = true; }, 3600);
  }
  function renderWeapons() {
    const query = $('weapon-search').value.trim().toLowerCase();
    const kits = list(state.arena?.kits);
    const blade = state.participant ? state.mode === 'blade' : loadoutMode === 'blade';
    const inArena = !!state.arena, locked = inArena && state.roundState !== 'buy';
    const entries = inArena ? kits : blade ? bladeWeapons : weapons;
    const selection = blade ? bladeChosen : chosen;
    for (const tab of document.querySelectorAll('[data-pvp-loadout]')) {
      tab.disabled = !!state.participant;
      tab.setAttribute('aria-pressed', String((blade ? 'blade' : 'ffa') === tab.dataset.pvpLoadout));
    }
    const signature = JSON.stringify([query,entries,inArena,state.arena?.kit,selection,locked,blade]);
    if (signature === weaponSignature) return;
    weaponSignature = signature;
    $('weapons').replaceChildren();
    for (const item of entries) {
      if (query && !`${item.label} ${item.category || ''} ${item.key}`.toLowerCase().includes(query)) continue;
      const button = document.createElement('button'); button.className = 'pvp-weapon';
      const selected = item.key === (inArena ? state.arena.kit : selection);
      button.setAttribute('aria-pressed', String(selected));
      const name = document.createElement('span'); name.textContent = item.label || item.key;
      const category = document.createElement('small'); category.textContent = selected ? 'SELECTED' : (item.category || 'ARENA KIT').toUpperCase();
      button.append(name,category);
      button.disabled = locked;
      button.addEventListener('click', () => { emit(inArena ? 'kit' : blade ? 'bladeWeapon' : 'weapon', {key:item.key}); });
      $('weapons').append(button);
    }
    if (!$('weapons').childElementCount) {
      const empty = document.createElement('p'); empty.textContent = locked ? 'Kit locked for this round.' : query ? 'No matching weapons.' : 'Loading the server arsenal.';
      $('weapons').append(empty);
    }
    write('loadout-hint', blade ? 'Melee only. Choose before joining or during spawn protection; later changes apply on respawn.'
      : locked ? 'Reopen /pvp during the next buy phase to change your arena kit.'
      : inArena ? 'Buy phase. Both teams receive the same kit list. Choose before the timer ends.'
      : 'Choose your free-for-all primary. Changes during a fight apply on respawn.');
  }
  function renderRows() {
    $('rows').replaceChildren();
    for (const [index,row] of list(state.rows).entries()) {
      const tr = document.createElement('tr'); tr.classList.toggle('self', String(row.id) === String(state.playerId));
      const team = state.arena && number(row.team) > 0 ? (number(row.team) === number(state.arena.side) ? 'ALLY' : 'OPPONENT') : '';
      if (team) tr.classList.add(team.toLowerCase());
      const name = `${row.name || 'Player'}${row.bot ? ' [BOT]' : ''}${team ? ` · ${team}` : ''}`;
      for (const value of [row.rank || index+1, name, number(row.kills), number(row.deaths), number(row.assists), number(row.score)]) {
        const td = document.createElement('td'); td.textContent = String(value); tr.append(td);
      }
      $('rows').append(tr);
    }
  }
  function render() {
    const participant = state.participant === true, queued = state.playerState === 'queued';
    const arena = state.arena, me = state.self || {};
    $('hud').hidden = !participant;
    $('queue-dock').hidden = !queued || participant;
    const queueFormat = state.queueFormat || state.queuedFormat || state.queue?.format || 'ARENA';
    const current = participant ? `${formatNames[state.mode] || 'PVP'} · IN MATCH` : `${queueFormat.toUpperCase()} · QUEUED`;
    write('current-label', current); write('queue-label', current);
    write('current-detail', participant ? 'Leaving returns you to your saved Freeroam position.' : 'You can close the menu and keep exploring.');
    $('current').hidden = !participant && !queued;
    for (const button of document.querySelectorAll('[data-pvp-format]')) button.disabled = participant || queued;
    write('population', `${number(state.instancePlayers)} players · ${number(state.instanceCount)} live instances`);
    for (const label of document.querySelectorAll('[data-pvp-queue]')) {
      const format = label.dataset.pvpQueue;
      const counts = state.arenaQueue || {};
      const item = Array.isArray(counts) ? counts.find(x => x.format === format || x.key === format) : counts[format];
      label.textContent = `${number(typeof item === 'object' ? item?.count ?? item?.players ?? item?.queued : item)} QUEUED`;
    }
    write('mode', formatNames[state.mode] || 'ARENA');
    write('objective', arena ? `ROUND ${number(arena.round)} · FIRST TO ${number(arena.target)}` : `FIRST TO ${number(state.killLimit) || 25} ELIMINATIONS`);
    const alive = list(arena?.aliveByTeam), side = number(arena?.side) || 1;
    write('match-hint', arena ? (state.roundState === 'buy' ? '/PVP · CHOOSE YOUR KIT'
      : `${number(alive[side-1])} ALLIES · ${number(alive[side===1 ? 1 : 0])} OPPONENTS ALIVE`) : state.mode === 'blade' ? 'MELEE ONLY · CTRL DASH · X OVERDRIVE' : '');
    $('scoreline').replaceChildren();
    if (arena) {
      const side = number(arena.side) || 1, wins = list(arena.wins);
      const mine = document.createTextNode(String(number(wins[side-1])));
      const separator = document.createElement('span'); separator.textContent = 'VS';
      const theirs = document.createElement('b'); theirs.textContent = String(number(wins[side===1 ? 1 : 0]));
      $('scoreline').append(mine,separator,theirs);
    }
    write('rank', `P${number(me.rank) || '—'}`); write('kills',number(me.kills)); write('deaths',number(me.deaths)); write('assists',number(me.assists));
    write('streak', number(me.streak) >= 2 ? `${number(me.streak)} ELIMINATION STREAK` : '/PVP · LOADOUT / LEAVE');
    const result = state.phase === 'results' || state.roundState === 'resolved' || state.roundState === 'standings';
    const dead = !result && ['respawning','eliminated','dead'].includes(state.playerState);
    $('death').hidden = !participant || !dead || board;
    write('death-title', state.playerState === 'eliminated' ? 'ROUND OVER FOR YOU' : 'ELIMINATED');
    write('death-detail', state.death?.killerName ? `Eliminated by ${state.death.killerName}` : 'Your next opportunity is coming.');
    $('board').hidden = !participant || (!board && !result);
    const outcome = state.result || {};
    const victory = arena ? number(outcome.winnerSide) === number(arena.side)
      : outcome.winnerId != null && String(outcome.winnerId) === String(state.playerId);
    write('board-title', result ? (victory ? 'VICTORY' : 'MATCH COMPLETE') : 'LIVE STANDINGS');
    write('board-subtitle', result
      ? (arena ? 'Server-confirmed results · Returning to Freeroam after the result timer.' : 'Server-confirmed results · The next round starts automatically.')
      : state.mode === 'blade' ? 'Blade FFA · Unranked melee playtest.' : 'Bots are labelled. Only eligible human matches affect rating.');
    renderRows(); tick();
  }
  function tick() {
    const elapsed = Math.max(0,performance.now()-anchor);
    const remaining = Math.max(0,number(state.remainingMs)-elapsed);
    const boost = state.overdrive || {};
    const boostMs = Math.max(0,number(boost.remainingMs)-elapsed);
    const active = boost.phase === 'active' && boostMs > 0 && state.playerState === 'active';
    const cooldown = Math.max(0,number(boost.cooldownMs)-elapsed);
    const showBoost = state.participant === true && state.mode === 'blade';
    $('overdrive').hidden = !showBoost;
    $('overdrive-glow').hidden = !showBoost || !active;
    $('overdrive').dataset.phase = active ? 'active' : cooldown > 0 ? 'cooldown' : 'ready';
    write('overdrive-status', active ? `ACTIVE · ${(boostMs/1000).toFixed(1)}S`
      : cooldown > 0 ? `COOLDOWN · ${Math.ceil(cooldown/1000)}S`
      : boost.available && number(boost.charges) > 0 ? 'READY' : 'UNAVAILABLE');
    const fill = active ? boostMs / Math.max(1,number(boost.durationMs))
      : cooldown > 0 ? 1-cooldown / Math.max(1,number(boost.rechargeMs)) : boost.available ? 1 : 0;
    $('overdrive-fill').style.width = `${Math.max(0,Math.min(1,fill))*100}%`;
    write('timer',formatTime(remaining));
    write('phase', ({buy:'BUY PHASE',active:'LIVE',playing:'LIVE',between:'NEXT ROUND',results:'RESULTS',resolved:'RESULTS',standings:'RESULTS'})[state.roundState || state.phase] || 'PREPARING');
    $('timer').parentElement.classList.toggle('urgent',remaining < 30000 && remaining > 0);
    const protection = Math.max(0,number(state.self?.protection?.remainingMs)-elapsed);
    $('protection').hidden = !state.participant || protection <= 0;
    write('protection-time',`${Math.ceil(protection/1000)}S`);
    write('respawn', state.playerState === 'respawning' ? `RESPAWN IN ${Math.ceil(Math.max(0,number(state.death?.remainingMs)-elapsed)/1000)}` : 'WAITING FOR THE NEXT ROUND');
  }
  for (const button of document.querySelectorAll('[data-pvp-format]')) button.addEventListener('click', () => {
    emit(['ffa','blade'].includes(button.dataset.pvpFormat) ? 'join' : 'queue', {format:button.dataset.pvpFormat,bots:$('bots').checked});
  });
  for (const button of document.querySelectorAll('[data-pvp-loadout]')) button.addEventListener('click', () => {
    loadoutMode = button.dataset.pvpLoadout; $('weapon-search').value = ''; renderWeapons();
  });
  $('leave').addEventListener('click', () => emit('leave'));
  $('weapon-search').addEventListener('input', renderWeapons);
  $('sound').addEventListener('change', () => emit('sound',{enabled:$('sound').checked}));
  Open77.on('pvp:open', () => { open(); emit('refresh'); });
  Open77.on('pvp:state', payload => { state = payload || {}; anchor = performance.now(); render(); renderWeapons(); });
  Open77.on('pvp:weapons', payload => { weapons = list(payload.weapons); chosen = payload.chosen || ''; bladeWeapons = list(payload.bladeWeapons); bladeChosen = payload.bladeChosen || ''; renderWeapons(); });
  Open77.on('pvp:notice', notify);
  Open77.on('pvp:board', payload => { board = payload.open === true; render(); });
  Open77.on('pvp:killfeed', payload => {
    if (!state.participant) return;
    const row = document.createElement('div'); row.className = 'pvp-feed-row';
    const killer = document.createTextNode(`${payload.killerName || payload.killer?.name || 'Environment'}${payload.killerBot ? ' [BOT]' : ''}`);
    const marker = document.createElement('span'); marker.textContent = payload.headshot ? 'HEADSHOT' : 'ELIM';
    const victim = document.createTextNode(`${payload.victimName || payload.victim?.name || 'Player'}${payload.victimBot ? ' [BOT]' : ''}`);
    row.append(killer,marker,victim); $('feed').prepend(row);
    while($('feed').childElementCount > 4) $('feed').lastElementChild.remove();
    setTimeout(() => row.remove(),5000);
  });
  setInterval(tick,100);
  Open77.emit('pvp:ready',{});
})();
/* Open77 combat activity: chamfered glass, cyan light, mechanical motion. */
[hidden] { display: none !important; }
.freeroam-menu .pvp-intro h2 { font: 650 32px/1.16 var(--font-display); margin: 14px 0 10px; letter-spacing: -.035em; }
.pvp-intro h2 span { color: var(--o-cyan-500); }
.pvp-intro p { color: var(--menu-muted); font-size: 15px; line-height: 1.55; max-width: 68ch; }
.pvp-status-strip { display:flex; gap:12px; align-items:center; margin:4px 0 8px; font:11px var(--font-mono); color:var(--menu-muted); }
.pvp-formats { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
.pvp-format { min-width:0; text-align:left; padding:22px; color:var(--text-primary); background:linear-gradient(125deg,#ffffff05,#ffffff01); border:1px solid #ffffff16; border-radius:8px; cursor:pointer; display:flex; flex-direction:column; gap:10px; transition:background .15s,border-color .15s,transform .15s; }
.pvp-format:hover,.pvp-format:focus-visible { background:rgba(34,216,226,.10); border-color:var(--o-cyan-500); outline:2px solid var(--o-cyan-500); outline-offset:-3px; }
.pvp-format:active { transform:translateY(1px); }
.pvp-format:disabled { opacity:.4; cursor:not-allowed; transform:none; }
.pvp-format-number { font:800 36px/1 var(--font-display); color:var(--o-cyan-500); }
.pvp-format-number span { font-size:20px; color:var(--text-secondary); padding:0 4px; }
.pvp-format strong { font:600 12px var(--font-ui); letter-spacing:.12em; }
.pvp-format small { color:var(--menu-muted); min-height:32px; font:14px/1.4 var(--font-body); }
.pvp-format-meta { display:flex; justify-content:space-between; gap:8px; font:10px var(--font-mono); color:var(--text-secondary); margin-top:8px; }
.pvp-format-meta b { font-weight:400; }
.pvp-format-meta i { font-style:normal; color:var(--o-cyan-500); }
.pvp-loadout-tabs { display:flex; gap:8px; margin:12px 0; }
.pvp-loadout-tabs button { padding:10px 14px; background:var(--surface-panel-raised); color:var(--text-secondary); border:1px solid var(--line-strong); border-radius:6px; cursor:pointer; }
.pvp-loadout-tabs button[aria-pressed=true] { color:var(--o-cyan-500); border-color:var(--o-cyan-500); }
.pvp-loadout-tabs button:disabled { cursor:default; }
.pvp-option { display:block; color:var(--text-primary); font-size:15px; margin:16px 0; }
.pvp-option small { display:block; padding-left:22px; margin-top:6px; color:var(--menu-muted); }
.pvp-option input,.pvp-options input { accent-color:var(--o-cyan-500); }
#pvp-weapon-search { box-sizing:border-box; width:100%; min-height:42px; padding:10px 12px; border:1px solid var(--line-strong); border-radius:0; background:var(--surface-panel-raised); color:var(--text-primary); font:14px var(--font-body); outline:none; }
#pvp-weapon-search::placeholder { color:var(--text-secondary); }
#pvp-weapon-search:focus { border-color:var(--o-cyan-500); }
.pvp-option input,.pvp-options input { width:15px; height:15px; margin:0 6px 0 0; vertical-align:middle; color-scheme:dark; }
.pvp-current { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:16px; margin:18px 0; border:1px solid var(--line-strong); }
.pvp-current strong { display:block; margin:8px 0; font:600 15px var(--font-ui); }
.pvp-current p { color:var(--text-secondary); font-size:14px; }
.pvp-weapons { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; margin-top:10px; max-height:260px; overflow-y:auto; padding:2px; }
.pvp-weapon { color:var(--text-primary); text-align:left; background:#ffffff03; border:1px solid var(--line-hairline); border-radius:6px; padding:16px; cursor:pointer; font:600 13px var(--font-ui); }
.pvp-weapon small { display:block; color:var(--text-secondary); margin-top:5px; font:10px var(--font-mono); }
.pvp-weapon[aria-pressed=true],.pvp-weapon:hover,.pvp-weapon:focus-visible { border-color:var(--o-cyan-500); color:var(--o-cyan-500); background:rgba(34,216,226,.08); }
.pvp-options { display:flex; justify-content:space-between; gap:10px; margin:18px 0 8px; color:var(--text-secondary); font:10px var(--font-ui); letter-spacing:.1em; }
.pvp-hud { position:fixed; inset:0; pointer-events:none; color:var(--text-primary); font-family:var(--font-ui); --pvp-inset:clamp(20px,2.2vw,40px); }
.pvp-matchbar,.pvp-personal,.pvp-board,.pvp-death,.pvp-queue-dock,.pvp-notice { background:rgba(11,14,20,.90); border:1px solid var(--line-strong); clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px)); }
.pvp-matchbar { position:absolute; top:max(64px,7.5vh); left:50%; transform:translateX(-50%); width:min(590px,54vw); display:flex; align-items:center; gap:20px; padding:14px 20px; border-top:2px solid var(--o-cyan-500); }
.pvp-matchbar>div:first-child { flex:1; min-width:0; }
.pvp-matchbar strong { font:700 17px var(--font-ui); display:block; margin-top:6px; }
.pvp-matchbar small { display:block; color:var(--text-secondary); font:10px var(--font-mono); margin-top:6px; }
.pvp-matchbar small:empty { display:none; }
.pvp-board tr.ally td:nth-child(2) { color:var(--o-cyan-500); }
.pvp-board tr.opponent td:nth-child(2) { color:var(--o-red-500); }
.pvp-eyebrow { font:600 10px var(--font-ui); letter-spacing:.14em; color:var(--o-cyan-500); }
.pvp-scoreline { white-space:nowrap; font:700 27px var(--font-mono); color:var(--o-cyan-500); }
.pvp-scoreline span { color:var(--text-secondary); font-size:13px; padding:0 10px; }
.pvp-scoreline b { color:var(--o-red-500); }
.pvp-clock { border-left:1px solid var(--line-strong); padding-left:20px; text-align:right; }
.pvp-clock span { font-size:9px; letter-spacing:.14em; color:var(--text-secondary); }
.pvp-clock strong { font:700 24px var(--font-mono); }
.pvp-clock.urgent strong { color:var(--o-amber-500); }
.pvp-protection { position:absolute; top:calc(max(64px,7.5vh) + 90px); left:50%; transform:translateX(-50%); color:var(--o-cyan-500); padding:8px 14px; background:rgba(11,14,20,.86); font:600 10px var(--font-ui); letter-spacing:.10em; text-align:center; }
.pvp-protection small { display:block; font:12px var(--font-body); color:var(--text-secondary); margin-top:4px; }
.pvp-personal { position:absolute; right:32px; bottom:96px; width:285px; }
.pvp-personal header { display:flex; gap:12px; align-items:center; padding:12px 16px; border-bottom:1px solid var(--line-hairline); font-size:9px; letter-spacing:.10em; }
.pvp-personal header>span:first-child { color:var(--o-cyan-500); font:700 18px var(--font-mono); }
.pvp-personal kbd { margin-left:auto; color:var(--text-secondary); }
.pvp-stat-grid { display:grid; grid-template-columns:repeat(3,1fr); padding:16px; gap:12px; }
.pvp-stat-grid strong { display:block; font:700 30px/1 var(--font-mono); }
.pvp-stat-grid span { display:block; margin-top:7px; font-size:9px; letter-spacing:.12em; color:var(--text-secondary); }
.pvp-personal footer { border-top:1px solid var(--line-hairline); padding:9px 16px; color:var(--text-secondary); font:9px var(--font-mono); }
.pvp-feed { position:absolute; right:var(--pvp-inset); top:36%; width:min(340px,28vw); display:grid; gap:5px; }
.pvp-feed-row { padding:9px 12px; text-align:right; background:rgba(11,14,20,.84); border:1px solid var(--line-hairline); font-size:12px; animation:pvp-enter 220ms var(--ease-out); }
.pvp-feed-row span { color:var(--o-magenta-500); margin:0 8px; font:9px var(--font-mono); }
.pvp-board { position:absolute; top:27%; left:50%; transform:translateX(-50%); width:min(720px,64vw); padding:24px; }
.pvp-board header h2,.pvp-death h2 { font:800 clamp(28px,3vw,42px)/1 var(--font-display); margin:12px 0 8px; }
.pvp-board header p { color:var(--text-secondary); font:14px var(--font-body); margin-bottom:16px; }
.pvp-table-scroll { max-height:42vh; overflow:auto; pointer-events:auto; }
.pvp-board table { width:100%; border-collapse:collapse; text-align:left; font:12px var(--font-mono); }
.pvp-board th { position:sticky; top:0; background:var(--surface-panel); color:var(--text-secondary); font:10px var(--font-ui); letter-spacing:.1em; }
.pvp-board th,.pvp-board td { padding:10px 8px; border-bottom:1px solid var(--line-hairline); }
.pvp-board tr.self { background:rgba(34,216,226,.08); color:var(--o-cyan-500); }
.pvp-board td:nth-child(2) { max-width:210px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.pvp-death { position:absolute; left:50%; top:42%; transform:translate(-50%,-50%); text-align:center; padding:28px 42px; max-width:75vw; }
.pvp-death h2 { color:var(--o-red-500); }
.pvp-death p { color:var(--text-secondary); font:16px var(--font-body); }
.pvp-death>strong { display:block; color:var(--o-cyan-500); font:700 24px var(--font-mono); margin-top:16px; }
.pvp-queue-dock { position:fixed; right:32px; bottom:96px; width:285px; padding:16px; pointer-events:none; }
.pvp-queue-dock strong,.pvp-queue-dock small { display:block; margin-top:9px; color:var(--text-primary); }
.pvp-queue-dock strong { font:600 17px var(--font-ui); }
.pvp-queue-dock small { color:var(--text-secondary); font:13px var(--font-body); }
.pvp-notice { position:fixed; right:clamp(20px,2.2vw,40px); top:25%; width:min(320px,28vw); padding:14px 18px; pointer-events:none; color:var(--text-primary); animation:pvp-enter 220ms var(--ease-out); }
.pvp-notice p { margin:8px 0 0; font:15px/1.35 var(--font-body); }
@keyframes pvp-enter { from { opacity:0; translate:16px 0; } to { opacity:1; translate:0 0; } }
.pvp-overdrive { position:absolute; right:32px; bottom:280px; width:250px; padding:14px 16px; background:rgba(11,14,20,.9); border:1px solid var(--o-cyan-500); display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
.pvp-overdrive kbd { font:700 22px var(--font-mono); color:var(--o-cyan-500); border:1px solid currentColor; padding:7px 10px; }
.pvp-overdrive span { display:block; color:var(--text-secondary); font:10px var(--font-ui); letter-spacing:.12em; }
.pvp-overdrive strong { display:block; margin-top:5px; font:600 13px var(--font-mono); color:var(--o-cyan-500); }
.pvp-overdrive[data-phase=cooldown] { border-color:var(--line-strong); }
.pvp-overdrive[data-phase=cooldown] strong { color:var(--text-secondary); }
.pvp-overdrive-track { width:100%; height:3px; background:#ffffff18; }
.pvp-overdrive-track i { display:block; height:100%; background:var(--o-cyan-500); }
.pvp-overdrive-glow { position:absolute; inset:0; pointer-events:none; box-shadow:inset 0 0 60px 10px #22d8e23b; border:2px solid #22d8e24d; animation:pvp-boost-pulse 2.4s ease-in-out infinite; }
@keyframes pvp-boost-pulse { 0%,100% { opacity:.55; } 50% { opacity:.9; } }
@media(max-width:1366px) { .pvp-matchbar { width:52vw; gap:12px; padding:12px; } .pvp-matchbar strong { font-size:14px; } .pvp-clock { padding-left:12px; } .pvp-personal,.pvp-queue-dock { width:250px; } .pvp-format { padding:13px; } }
@media(max-width:850px) { .pvp-matchbar { width:70vw; } .pvp-formats { grid-template-columns:1fr; } .pvp-board { width:80vw; } }
@media(prefers-reduced-motion:reduce) { .pvp-hud *,.pvp-notice,.pvp-format { animation:none!important; transition:none!important; } }
(() => {
  "use strict";

  const body = document.getElementById("race-ui");
  const $ = id => document.getElementById("race-" + id);
  let state = { phase: "waiting", rows: [], courses: [] };
  let activeTab = "lobby";
  let courseSignature = "";
  let liveRowsSignature = "";
  let boardRowsSignature = "";
  let editorSignature = "";
  let pulseTimer = 0;
  let goTimer = 0;
  let goActive = false;
  let countdownVisualToken = "";
  let guideAngle = 0;
  let guideAngleReady = false;
  let ballotSignature = "";
  const rosterNodes = new Map();
  const collectionCache = new Map();

  const phaseNames = {
    waiting: "LOBBY",
    forming: "COURSE VOTE",
    reveal: "COURSE SELECTED",
    grid: "DRIVERS TO CARS",
    countdown: "COUNTDOWN",
    active: "RACING",
    results: "RESULTS"
  };

  function number(value, fallback = 0) {
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : fallback;
  }

  function integer(value, fallback = 0) {
    return Math.trunc(number(value, fallback));
  }

  function raceTime(milliseconds, short = false) {
    const value = Math.max(0, number(milliseconds));
    const totalSeconds = Math.floor(value / 1000);
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = totalSeconds % 60;
    const millis = Math.floor(value % 1000);
    if (short) return `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
    return `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}.${String(millis).padStart(3, "0")}`;
  }

  function selfRow() {
    return (Array.isArray(state.rows) ? state.rows : []).find(row =>
      String(row.id) === String(state.playerId));
  }

  function statusLabel(row) {
    const status = String(row.state || "").toLowerCase();
    if (status === "finished") return row.finishMs != null ? raceTime(row.finishMs) : "FINISH";
    if (status === "dnf" || status === "disconnected") return "DNF";
    if (status === "countdown") return "GRID";
    if (status === "grid") return "BOARDING";
    if (status === "racing") return "RACING";
    return status.toUpperCase() || "--";
  }

  function setTab(name) {
    if (name === "editor" && !(state.editor && state.editor.open !== false)) name = "lobby";
    activeTab = name;
    body.querySelectorAll(".tab").forEach(button =>
      button.classList.toggle("active", button.dataset.tab === name));
    body.querySelectorAll(".tab-page").forEach(page =>
      page.classList.toggle("active", page.dataset.page === name));
  }

  function renderLiveRows() {
    const container = $("liveRows");
    const all = Array.isArray(state.rows) ? state.rows : [];
    const ownIndex = all.findIndex(row => String(row.id) === String(state.playerId));
    // Keep the leader and the player's immediate rivals visible even in P32.
    const rows = ownIndex < 6 ? all.slice(0, 6) :
      [...all.slice(0, 2), ...all.slice(Math.min(ownIndex - 1, all.length - 4),
        Math.min(ownIndex - 1, all.length - 4) + 4)];
    const projection = rows.map(row => ({
      self: String(row.id) === String(state.playerId),
      leader: integer(row.rank) === 1,
      rank: `P${integer(row.rank, 0) || "-"}`,
      name: String(row.name || "Driver").slice(0, 48),
      progress: row.state === "finished" ? raceTime(row.finishMs) :
        row.state === "dnf" || row.state === "disconnected" ? "DNF" :
        `L${integer(row.lap, 1)} · ${Math.min(integer(row.checkpointIndex, 1), integer(row.totalCheckpoints, 1))}/${integer(row.totalCheckpoints, 1)}`
    }));
    const signature = JSON.stringify(projection);
    if (signature === liveRowsSignature) return;
    liveRowsSignature = signature;
    container.replaceChildren();
    for (const row of projection) {
      const item = document.createElement("div");
      item.className = "live-row";
      if (row.self) item.classList.add("self");
      if (row.leader) item.classList.add("leader");
      const rank = document.createElement("span");
      rank.textContent = row.rank;
      const driver = document.createElement("b");
      driver.textContent = row.name;
      const progress = document.createElement("em");
      progress.textContent = row.progress;
      item.append(rank, driver, progress);
      container.append(item);
    }
  }

  function renderBoard(visible) {
    // Keep the prior projection while hidden; reveal renders current rows.
    if (!visible) return;
    const container = $("boardRows");
    const rows = Array.isArray(state.rows) ? state.rows : [];
    const projection = rows.map(row => ({
      self: String(row.id) === String(state.playerId),
      leader: integer(row.rank) === 1,
      dnf: ["dnf", "disconnected"].includes(String(row.state)),
      values: [
        `P${integer(row.rank, 0) || "-"}`,
        String(row.name || "Driver").slice(0, 48),
        statusLabel(row),
        `${integer(row.lap, 1)}/${integer(row.laps, 1)}`,
        `${Math.min(integer(row.checkpointIndex, 1), integer(row.totalCheckpoints, 1))}/${integer(row.totalCheckpoints, 1)}`,
        row.finishMs != null ? raceTime(row.finishMs) : "--:--.---",
        row.bestLapMs != null ? raceTime(row.bestLapMs) : "--:--.---"
      ]
    }));
    const signature = JSON.stringify(projection);
    if (signature === boardRowsSignature) return;
    boardRowsSignature = signature;
    container.replaceChildren();
    for (const row of projection) {
      const item = document.createElement("div");
      item.className = "board-row";
      if (row.self) item.classList.add("self");
      if (row.leader) item.classList.add("leader");
      if (row.dnf) item.classList.add("dnf");
      row.values.forEach((value, index) => {
        const cell = document.createElement("span");
        cell.textContent = value;
        if (index === 1) cell.className = "driver";
        if (index === 2) cell.className = "status";
        item.append(cell);
      });
      container.append(item);
    }
    $("boardEmpty").classList.toggle("hidden", rows.length > 0);
  }

  function renderCourses(courses) {
    courses = (courses || []).filter(course => (course.vehicle === "on_foot") === (state.mode === "foot"));
    const signature = JSON.stringify((courses || []).map(course => [
      course.id, course.name, course.type, course.laps, course.checkpointCount,
      course.gridCount, course.gridCapacity, course.automaticGrid, course.vehicle, course.vehicleLabel,
      course.selected, course.revision
    ]));
    if (signature === courseSignature) return;
    courseSignature = signature;
    const container = $("courseList");
    container.replaceChildren();
    for (const course of courses || []) {
      const card = document.createElement("article");
      card.className = "course-card" + (course.selected ? " selected" : "");
      const name = document.createElement("b");
      name.textContent = String(course.name || course.id || "Course").slice(0, 64);
      const specs = document.createElement("em");
      specs.textContent = `${String(course.type || "circuit").toUpperCase()} · ${integer(course.laps, 1)}L · ${integer(course.checkpointCount)}CP · ${course.automaticGrid ? "AUTO GRID" : `${integer(course.gridCapacity)} GRID`} · ${String(course.vehicleLabel || "CAR").toUpperCase()}`;
      const description = document.createElement("p");
      description.textContent = String(course.description || "No description.").slice(0, 240);
      card.append(routeArt(course), name, specs, description);
      container.append(card);
    }
  }

  function element(tag, className, text) {
    const node = document.createElement(tag);
    node.className = className;
    if (text != null) node.textContent = text;
    return node;
  }

  function routeArt(course) {
    const art = element("div", "route-art");
    const route = typeof course.route === "string" ? course.route.split(" ").map(pair => {
      const [x, y] = pair.split(",").map(Number); return { x, y };
    }) : course.route;
    const points = (Array.isArray(route) ? route : [])
      .filter(p => Number.isFinite(p.x) && Number.isFinite(p.y));
    if (points.length < 2) { art.append(element("span", "route-number", "ROUTE PREVIEW UNAVAILABLE")); return art; }
    const xs = points.map(p => p.x), ys = points.map(p => p.y);
    const minX = Math.min(...xs), minY = Math.min(...ys);
    const width = Math.max(...xs) - minX, height = Math.max(...ys) - minY;
    const scale = Math.min(230 / Math.max(1, width), 110 / Math.max(1, height));
    const fitted = points.map(p => [
      140 + (p.x - minX - width / 2) * scale,
      75 - (p.y - minY - height / 2) * scale
    ]);
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("viewBox", "0 0 280 150");
    svg.setAttribute("aria-hidden", "true");
    const line = document.createElementNS(svg.namespaceURI, "polyline");
    line.setAttribute("points", fitted.map(p => p.join(",")).join(" "));
    line.setAttribute("fill", "none"); line.setAttribute("stroke", "currentColor");
    line.setAttribute("stroke-width", "3"); line.setAttribute("stroke-linejoin", "round");
    line.setAttribute("stroke-linecap", "round"); svg.append(line);
    [fitted[0], fitted[fitted.length - 1]].forEach((p, index) => {
      const dot = document.createElementNS(svg.namespaceURI, "circle");
      dot.setAttribute("cx", p[0]); dot.setAttribute("cy", p[1]); dot.setAttribute("r", index ? "4" : "6");
      dot.setAttribute("fill", index ? "currentColor" : "#0b1820");
      dot.setAttribute("stroke", "currentColor"); dot.setAttribute("stroke-width", "2"); svg.append(dot);
    });
    art.append(svg);
    return art;
  }

  function renderBallot() {
    const ballot = state.ballot || {};
    const available = Array.isArray(ballot.candidates) ? ballot.candidates :
      state.nextCourseLocked && state.nextCourse ? [state.nextCourse] :
      (Array.isArray(state.courses) ? state.courses : []);
    const candidates = available.filter(course => (course.vehicle === "on_foot") === (state.mode === "foot"));
    const canVote = ballot.open === true && state.queued === true;
    const signature = JSON.stringify([ballot.id, candidates.map(c => [c.id, c.revision, c.name, c.route])]);
    if (signature !== ballotSignature) {
      ballotSignature = signature;
      $("voteCourses").replaceChildren();
      candidates.forEach((course, index) => {
        const card = element("button", "route-card");
        card.type = "button"; card.dataset.courseId = course.id;
        const art = routeArt(course);
        art.append(element("span", "route-number", `ROUTE ${String(index + 1).padStart(2, "0")}`), element("span", "route-pick"));
        const info = element("div", "route-info");
        info.append(element("span", "route-type", `${course.type || "circuit"} / ${integer(course.laps, 1)} lap${integer(course.laps, 1) > 1 ? "s" : ""}`),
          element("h4", "", String(course.name || "Unnamed route").slice(0, 64)),
          element("div", "route-specs", `${(number(course.routeMetres) / 1000).toFixed(1)} km route · ${integer(course.checkpointCount)} checkpoints`),
          element("div", "route-specs", course.automaticGrid ? "Automatic starting line · no course limit" : `${integer(course.gridCapacity)} grid slots`),
          element("div", "route-vehicle", course.vehicleLabel || "Race vehicle"));
        const votes = element("div", "route-votes"); votes.append(element("span", "", "VOTES"), element("b", "", "0"));
        card.append(art, info, votes);
        card.addEventListener("click", () => {
          if (!state.queued || !state.ballot?.open || state.ballot.id !== ballot.id) return;
          Open77.emit("race:action", { action: "vote", ballotId: state.ballot.id, courseId: course.id });
        });
        $("voteCourses").append(card);
      });
      if (!candidates.length) $("voteCourses").append(element("p", "vote-help", "No courses available. An admin can create one in the course editor."));
    }
    [...$("voteCourses").querySelectorAll(".route-card")].forEach((card, index) => {
      const course = candidates[index];
      const selected = state.ownVote === course.id;
      const winner = ballot.winnerId === course.id;
      card.classList.toggle("selected", selected); card.classList.toggle("winner", winner);
      card.setAttribute("aria-pressed", String(selected));
      card.setAttribute("aria-disabled", String(!canVote));
      card.setAttribute("aria-label", `${course.name}. ${integer(course.votes)} votes. ${winner ? "Selected course." : selected ? "Your vote." : canVote ? "Vote for this course." : "Join the queue to vote."}`);
      card.querySelector(".route-pick").textContent = winner ? "SELECTED" : selected ? "YOUR VOTE ✓" : canVote ? "VOTE ↗" : state.nextCourseLocked && !ballot.id ? "NEXT HEAT" : "PREVIEW";
      const count = card.querySelector(".route-votes b"), value = String(integer(course.votes));
      if (count.textContent !== value) {
        count.textContent = value; count.classList.remove("changed"); void count.offsetWidth; count.classList.add("changed");
      }
      card.querySelector(".route-votes").classList.toggle("hidden", !ballot.id);
    });
    $("voteTitle").textContent = ballot.winnerId ? "The route is decided." : state.nextCourseLocked && !ballot.id ? "Next on the grid." : "Where to next?";
    $("voteSummary").textContent = ballot.id ? `${integer(ballot.totalVotes)} / ${integer(ballot.eligibleCount)} voted` : "COURSE PREVIEW";
    $("voteHelp").textContent = ballot.winnerId
      ? ballot.resultReason === "tie" ? "It's a tie! The server drew a winner from the tied courses."
        : ballot.resultReason === "random" ? "No votes cast. The server picked the next route." : "The votes are in. Get ready for the starting line."
      : !ballot.id && state.nextCourseLocked ? "Course locked for the next heat. An admin selection takes priority over voting."
      : state.queued ? "Your vote is counted live. Change it until voting closes; ties are drawn at random."
      : "Join the queue to vote. One player, one vote; ties are drawn at random.";
  }

  function renderRoster() {
    const queued = Array.isArray(state.roster) ? state.roster : [];
    const racing = Array.isArray(state.rows) ? state.rows : [];
    const rows = [...racing.map(row => ({ ...row, heat: true })), ...queued];
    const container = $("rosterList"), present = new Set();
    $("driverCount").textContent = String(rows.length).padStart(2, "0");
    rows.forEach((row, index) => {
      const key = `${row.heat ? "heat" : "queue"}:${row.id}`;
      present.add(key);
      let item = rosterNodes.get(key);
      if (!item) {
        item = element("div", "driver-row");
        const details = element("div", "driver-details"); details.append(element("b", ""), element("small", ""));
        item.append(element("span", "driver-avatar"), details, element("span", "driver-place"));
        rosterNodes.set(key, item);
      }
      const own = String(row.id) === String(state.playerId);
      const name = String(row.name || "Driver").slice(0, 48);
      const votedCourse = (state.ballot?.candidates || []).find(c => c.id === row.voteCourseId);
      item.classList.toggle("self", own); item.classList.toggle("voted", Boolean(votedCourse));
      item.querySelector(".driver-avatar").textContent = name.slice(0, 2).toUpperCase();
      item.querySelector("b").textContent = name + (own ? " · YOU" : "");
      item.querySelector("small").textContent = row.heat ? `CURRENT HEAT · ${row.state === "grid" && row.vehicleReady ? "READY" : statusLabel(row)}`
        : !row.ready ? "Not ready · check your character" : votedCourse ? `Voted · ${votedCourse.name}`
        : state.nextCourseLocked ? "Waiting for the next grid" : "In queue · choosing a route";
      item.querySelector(".driver-place").textContent = row.heat ? `P${integer(row.rank)}` : `#${integer(row.queuePosition)}`;
      if (container.children[index] !== item) container.insertBefore(item, container.children[index] || null);
    });
    for (const [key, node] of rosterNodes) if (!present.has(key)) { node.remove(); rosterNodes.delete(key); }
    const empty = container.querySelector(".roster-empty");
    if (rows.length) empty?.remove();
    else if (!empty) {
      const placeholder = element("div", "roster-empty");
      placeholder.append(element("b", "", "First to the line?"), element("p", "", "Join the queue. Other players will appear here as they arrive."));
      container.append(placeholder);
    }
    $("rosterFoot").textContent = `${queued.length} waiting${racing.length ? ` · ${racing.length} in current heat` : ""} · Queue order is preserved`;
  }

  function renderLounge() {
    const phase = state.phase, ballot = state.ballot || {}, next = state.nextCourse || {};
    const foot = state.mode === "foot", automatic = next.automaticGrid === true;
    const seconds = Math.max(0, Math.ceil(number(state.remainingMs) / 1000));
    const title = phase === "forming" ? ballot.id ? "Choose the next course." : "Your grid is forming."
      : phase === "reveal" ? `${next.name || "Course"} is up next.`
      : phase === "grid" ? "Getting everyone to the line."
      : phase === "countdown" ? "Eyes on the lights."
      : phase === "active" ? `${state.course?.name || "Race"} · live.`
      : phase === "results" ? "That's a wrap. Next heat soon."
      : "The city is your starting line.";
    $("stageTitle").textContent = title;
    $("stageLabel").textContent = state.onFoot && phase === "grid" ? "RUNNERS TO THE LINE" : phaseNames[phase] || "THE NEXT HEAT";
    $("rosterLabel").textContent = foot ? "02 / THE RUNNERS" : "02 / THE DRIVERS";
    $("participantLabel").textContent = state.onFoot ? "RUNNER" : "DRIVER";
    $("stageHint").textContent = phase === "forming" ? "Vote, change your pick, and watch the grid come together."
      : phase === "reveal" ? automatic ? "Automatic starting line · All queued runners join this heat" : `${integer(state.nextGridCapacity)} grid slots · ${next.vehicleLabel || "Race vehicle"} · Automatic boarding next`
      : phase === "grid" ? `${(state.rows || []).filter(r => r.vehicleReady).length} / ${integer(state.participantCount)} ${state.onFoot ? "runners ready · Wait for GO" : "drivers seated · Vehicles held until GO"}`
      : phase === "countdown" ? state.onFoot ? "Starting line locked. Run at the green light." : "Grid locked. Vehicles release at the green light."
      : phase === "active" || phase === "results" ? "The next queue stays open. Join and vote while this heat finishes."
      : foot && !next.id ? "No foot courses yet. Open the course editor: capture the start and checkpoints."
      : `Join to open the vote. ${integer(state.minimumRacers, 1)} ${foot ? "runner" : "driver"}${integer(state.minimumRacers, 1) > 1 ? "s" : ""} needed to start.`;
    $("clockLabel").textContent = ({ forming: ballot.id ? "VOTING CLOSES IN" : "GRID OPENS IN", reveal: "TO THE GRID IN", grid: state.gridLoadActive ? "GRID LOADING" : state.onFoot ? "READINESS TIMEOUT" : "BOARDING TIMEOUT", countdown: "GREEN LIGHT IN", active: state.finishWindowActive ? "FINISH WINDOW" : "TIME REMAINING", results: "RESULTS CLOSE IN" })[phase] || (foot ? "WAITING FOR RUNNERS" : "WAITING FOR DRIVERS");
    $("lobbyClock").textContent = phase === "waiting" ? "—" : phase === "countdown" ? String(seconds) : raceTime(seconds * 1000, true);
    const ratio = phase === "forming" ? number(state.remainingMs) / Math.max(1, number(ballot.durationMs, 30000)) : phase === "countdown" ? number(state.remainingMs) / 3000 : 0;
    $("clockProgress").style.transform = `scaleX(${Math.max(0, Math.min(1, ratio))})`;
    $("sessionStage").classList.toggle("urgent", ["forming", "countdown"].includes(phase) && seconds <= 5);
    $("sessionStage").classList.toggle("reveal", phase === "reveal");
    $("queueLabel").textContent = state.queued ? `QUEUE POSITION ${integer(state.queuePosition)}` : state.participant ? "CURRENT HEAT" : "YOUR NEXT RACE";
    $("queueCopy").textContent = state.queued ? !automatic && state.nextCourseLocked && integer(state.queuePosition) > integer(state.nextGridCapacity)
      ? "This grid is full. Your place is kept for the following heat."
      : "You're in. Stay in Freeroam; we'll bring you to the starting line."
      : state.participant ? "You're in the current heat. Good luck out there."
      : state.canJoin ? foot ? "No course limit. Everyone lines up behind the start." : "Unlimited queue. Grid size follows the selected course." : "Return to Freeroam with a ready character to join.";
    $("joinButton").classList.toggle("hidden", state.canJoin !== true);
    $("leaveQueueButton").classList.toggle("hidden", state.canLeaveQueue !== true);
    $("leaveRaceButton").classList.toggle("hidden", state.canLeaveRace !== true);
    $("returnCheckpointButton").classList.toggle("hidden", state.canReturnCheckpoint !== true);
    $("returnCheckpointButton").disabled = state.returningToCheckpoint === true;
    $("currentHeat").classList.toggle("hidden", !state.participantCount);
    $("currentHeat").textContent = `NOW RACING / ${state.course?.name || "Current heat"} · ${integer(state.participantCount)} ${state.onFoot ? "runners" : "drivers"}. Votes on this screen are for the next heat.`;
    renderBallot(); renderRoster();
  }

  function coordinate(point) {
    const p = point && point.position;
    if (!p) return "Not captured";
    return `${number(p.x).toFixed(1)}, ${number(p.y).toFixed(1)}, ${number(p.z).toFixed(1)} · ${number(point.heading).toFixed(0)}°`;
  }

  function editorKey(editor, action, fallback) {
    const keys = editor && editor.keys && typeof editor.keys === "object" ? editor.keys : {};
    return String(keys[action] || fallback).slice(0, 12).toUpperCase();
  }

  const editorErrorCopy = {
    position_unavailable: "Server position is not available yet. Wait a moment and retry.",
    editor_world_required: "Return to the editor world before capturing this point.",
    grid_slots_overlap: "This grid slot overlaps another one. Move the car farther away.",
    too_many_grid_slots: "The course already has the maximum number of grid slots.",
    too_many_checkpoints: "The course already has the maximum number of checkpoints.",
    invalid_grid_index: "That grid slot no longer exists.",
    invalid_checkpoint_index: "That checkpoint no longer exists.",
    start_missing: "Capture a start position before saving.",
    grid_missing: "Capture at least one vehicle grid slot before saving.",
    not_enough_grid_slots: "Capture at least one vehicle grid slot before saving.",
    not_enough_checkpoints: "Capture the required checkpoint(s) before saving.",
    name_too_short: "The course name must contain at least three characters.",
    invalid_type: "Choose either Circuit or Sprint.",
    invalid_laps: "The lap count is outside the supported range.",
    invalid_vehicle: "Choose one of the race vehicles allowed by the server.",
    invalid_checkpoint_radius: "The checkpoint radius must be between 2 and 30 metres.",
    builtin_readonly: "Built-in courses are read-only. Load one to create an editable copy.",
    course_not_found: "That course no longer exists.",
    heat_in_progress: "Wait for the active heat to finish before selecting another course.",
    session_expired: "The editor session expired. Run /race.editor again.",
    unknown_action: "The server did not recognise that editor action."
  };

  function readableEditorError(error) {
    const raw = String(error || "");
    const code = raw.split(":", 1)[0];
    if (editorErrorCopy[code]) return editorErrorCopy[code];
    if (code === "vehicle_spawn_failed") return "The editor car could not be created. Retry with the CAR key.";
    if (code === "storage_write_failed" || code === "storage_delete_failed")
      return "The course JSON could not be written. Check the server storage log.";
    return raw.replaceAll("_", " ");
  }

  function editorNextStep(draft, grid, checkpoints, vehicleReady) {
    if (!vehicleReady && draft.vehicle !== "on_foot") return "Creating the editor car…";
    if (!(draft.start && draft.start.position)) return "Next: face the route at the start and press F6.";
    if (!grid.length && draft.vehicle !== "on_foot") return "Next: capture at least one exact starting position.";
    const required = draft.type === "sprint" ? 1 : 2;
    if (checkpoints.length < required)
      return `Next: capture ${required - checkpoints.length} more checkpoint${required - checkpoints.length === 1 ? "" : "s"}.`;
    return "Course geometry is ready. Open options if needed, then save.";
  }

  function emitEditor(action, extra = {}) {
    Open77.emit("race:editor", { action, ...extra });
  }

  function closeCustomDropdowns(except = null) {
    body.querySelectorAll(".custom-dropdown.open").forEach(dropdown => {
      if (dropdown === except) return;
      dropdown.classList.remove("open");
      const trigger = dropdown.querySelector(".custom-dropdown-trigger");
      if (trigger) trigger.setAttribute("aria-expanded", "false");
    });
  }

  function dropdownValue(id) {
    return String($(id).dataset.value || "");
  }

  function selectDropdownValue(dropdown, value, notify = false) {
    const options = Array.from(dropdown.querySelectorAll(".custom-dropdown-option"));
    const selected = options.find(option => option.dataset.value === String(value)) || options[0];
    if (!selected) return;
    const previous = String(dropdown.dataset.value || "");
    dropdown.dataset.value = String(selected.dataset.value || "");
    const trigger = dropdown.querySelector(".custom-dropdown-trigger");
    const label = dropdown.querySelector(".custom-dropdown-value");
    label.textContent = selected.textContent;
    trigger.title = selected.textContent;
    options.forEach(option => {
      const active = option === selected;
      option.classList.toggle("selected", active);
      option.setAttribute("aria-selected", active ? "true" : "false");
    });
    if (dropdown.id === "editType")
      $("editLaps").disabled = dropdown.dataset.value === "sprint";
    if (notify && previous !== dropdown.dataset.value) syncFields();
  }

  function setDropdownOptions(id, options, value) {
    const dropdown = $(id);
    const menu = dropdown.querySelector(".custom-dropdown-menu");
    const trigger = dropdown.querySelector(".custom-dropdown-trigger");
    menu.replaceChildren();
    dropdown.classList.remove("empty");
    trigger.disabled = options.length === 0;
    if (!options.length) {
      dropdown.classList.add("empty");
      dropdown.dataset.value = "";
      dropdown.querySelector(".custom-dropdown-value").textContent = "NO OPTIONS AVAILABLE";
      trigger.title = "No options available";
      closeCustomDropdowns();
      return;
    }
    options.forEach((entry, index) => {
      const option = document.createElement("button");
      option.type = "button";
      option.className = "custom-dropdown-option";
      option.id = `${id}Option${index}`;
      option.dataset.value = String(entry.value ?? "");
      option.setAttribute("role", "option");
      option.textContent = String(entry.label || entry.value || "OPTION").slice(0, 64);
      option.addEventListener("click", event => {
        event.stopPropagation();
        selectDropdownValue(dropdown, option.dataset.value, true);
        closeCustomDropdowns();
        dropdown.querySelector(".custom-dropdown-trigger").focus();
      });
      menu.append(option);
    });
    selectDropdownValue(dropdown, value);
  }

  function initializeCustomDropdowns() {
    body.querySelectorAll(".custom-dropdown").forEach(dropdown => {
      const trigger = dropdown.querySelector(".custom-dropdown-trigger");
      trigger.addEventListener("click", event => {
        event.stopPropagation();
        if (trigger.disabled) return;
        const opening = !dropdown.classList.contains("open");
        closeCustomDropdowns(dropdown);
        dropdown.classList.toggle("open", opening);
        trigger.setAttribute("aria-expanded", opening ? "true" : "false");
        if (opening) {
          const selected = dropdown.querySelector(".custom-dropdown-option.selected") ||
            dropdown.querySelector(".custom-dropdown-option");
          if (selected) selected.focus();
        }
      });
      dropdown.addEventListener("keydown", event => {
        const options = Array.from(dropdown.querySelectorAll(".custom-dropdown-option"));
        if (!options.length) return;
        const current = options.indexOf(document.activeElement);
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          if (!dropdown.classList.contains("open")) {
            closeCustomDropdowns(dropdown);
            dropdown.classList.add("open");
            trigger.setAttribute("aria-expanded", "true");
          }
          const direction = event.key === "ArrowDown" ? 1 : -1;
          const fallback = direction > 0 ? -1 : 0;
          options[((current < 0 ? fallback : current) + direction + options.length) % options.length].focus();
        } else if (event.key === "Home" || event.key === "End") {
          event.preventDefault();
          options[event.key === "Home" ? 0 : options.length - 1].focus();
        } else if (event.key === "Escape" && state.panelOpen) {
          event.preventDefault();
          event.stopPropagation();
          closeCustomDropdowns();
          trigger.focus();
        } else if (event.key === "Tab") {
          closeCustomDropdowns();
        }
      });
    });
    document.addEventListener("click", () => closeCustomDropdowns());
  }

  function renderEditor(editor) {
    const enabled = editor && editor.open !== false;
    $("editorTab").classList.toggle("hidden", !enabled);
    if (!enabled) {
      if (activeTab === "editor") setTab("lobby");
      editorSignature = "";
      return;
    }
    const draft = editor.draft || {};
    $("editorMode").textContent = draft.vehicle === "on_foot" ? "ON FOOT" : "DRIVE MODE";
    const checkpoints = Array.isArray(draft.checkpoints) ? draft.checkpoints : [];
    const grid = Array.isArray(draft.grid) ? draft.grid : [];
    const vehicles = Array.isArray(editor.vehicles) ? editor.vehicles : [];
    const signature = JSON.stringify([
      draft.id, draft.name, draft.description, draft.type, draft.laps,
      draft.checkpointRadius, draft.vehicle, coordinate(draft.start),
      grid.map(coordinate), checkpoints.map(coordinate), vehicles,
      editor.message, editor.error, editor.vehicleId,
      editor.keys,
      (editor.courses || []).map(course => [
        course.id, course.name, course.vehicle, course.vehicleLabel,
        course.selected, course.revision])
    ]);
    if (signature === editorSignature) return;
    editorSignature = signature;

    $("editName").value = String(draft.name || "").slice(0, 64);
    $("editDescription").value = String(draft.description || "").slice(0, 240);
    setDropdownOptions("editVehicle", vehicles.map(vehicle => ({
      value: String(vehicle.id || ""),
      label: String(vehicle.label || vehicle.id || "Vehicle")
    })), String(draft.vehicle || (vehicles[0] && vehicles[0].id) || ""));
    setDropdownOptions("editType", [
      { value: "circuit", label: "Circuit / multilap" },
      { value: "sprint", label: "Start -> finish" }
    ], draft.type === "sprint" ? "sprint" : "circuit");
    $("editLaps").value = String(integer(draft.laps, 1));
    $("editLaps").disabled = dropdownValue("editType") === "sprint";
    $("editRadius").value = String(number(draft.checkpointRadius, 7));
    $("startState").textContent = coordinate(draft.start);
    const automaticGrid = draft.vehicle === "on_foot";
    $("vehicleField").classList.toggle("hidden", automaticGrid);
    $("undoGrid").classList.toggle("hidden", automaticGrid);
    $("respawnEditorVehicle").classList.toggle("hidden", automaticGrid);
    $("exitEditor").textContent = automaticGrid ? "EXIT EDITOR" : "EXIT DRIVE MODE";
    $("captureHint").textContent = automaticGrid
      ? "Stand at the start and face the route, then capture it once. Everyone lines up behind you. Move to each landing and add a checkpoint."
      : "Drive onto the exact mark and face the desired direction before each capture.";
    $("gridCount").textContent = automaticGrid ? "AUTO · NO COURSE LIMIT" : `${grid.length} SLOT${grid.length === 1 ? "" : "S"}`;
    $("captureGrid").hidden = automaticGrid;
    $("checkpointCount").textContent = String(checkpoints.length);
    const status = $("editorStatus");
    status.classList.toggle("error", Boolean(editor.error));
    const nextStep = editorNextStep(draft, grid, checkpoints, Boolean(editor.vehicleId));
    const editorStatusCopy = editor.error ? readableEditorError(editor.error) :
      [editor.message, nextStep].filter(Boolean).join(" · ");
    status.textContent = String(editorStatusCopy ||
      (editor.storage && editor.storage.ready
        ? `JSON storage ready · ${String(editor.storage.directory || "data/courses")}`
        : `JSON storage unavailable · ${String(editor.storage && editor.storage.error || "unknown error")}`)).slice(0, 180);

    $("editorDriveHud").classList.toggle("error", Boolean(editor.error));
    $("driveCourseName").textContent = String(draft.name || "New Night City Race").slice(0, 48);
    $("driveStartCount").textContent = draft.start && draft.start.position ? "1 / 1" : "0 / 1";
    $("driveGridCount").textContent = automaticGrid ? "AUTO" : String(grid.length);
    $("driveCheckpointCount").textContent = String(checkpoints.length);
    $("driveStatus").textContent = String(editorStatusCopy || nextStep).slice(0, 150);
    $("keyVehicle").textContent = editorKey(editor, "spawnVehicle", "F4");
    $("keyReturnCheckpoint").textContent = editorKey(editor, "returnCheckpoint", "F3");
    $("keyReturnCheckpoint").parentElement.hidden = !automaticGrid;
    $("editorReturnCheckpoint").classList.toggle("hidden", !automaticGrid);
    $("editorReturnCheckpoint").disabled = !checkpoints.length && !draft.start?.position;
    $("keyVehicle").parentElement.hidden = draft.vehicle === "on_foot";
    $("keyMenu").textContent = editorKey(editor, "menu", "F5");
    $("keyCaptureStart").textContent = editorKey(editor, "captureStart", "F6");
    $("keyCaptureGrid").textContent = editorKey(editor, "captureGrid", "F7");
    $("keyCaptureGrid").parentElement.hidden = automaticGrid;
    $("keyCaptureCheckpoint").textContent = editorKey(editor, "addCheckpoint", "F8");
    $("keyUndoCheckpoint").textContent = editorKey(editor, "undo", "F9");
    $("keyUndoGrid").textContent = editorKey(editor, "undoGrid", "F10");
    $("keyUndoGrid").parentElement.hidden = automaticGrid;
    $("keySave").textContent = editorKey(editor, "save", "F11");
    $("keyExit").textContent = editorKey(editor, "close", "END");

    const gridList = $("gridList");
    gridList.replaceChildren();
    if (automaticGrid) gridList.textContent = "One line behind the start, facing your captured direction. Leave level ground clear behind it. No individual spawns needed.";
    (automaticGrid ? [] : grid).forEach((slot, index) => {
      const row = document.createElement("div");
      row.className = "checkpoint-item grid-item";
      const numberCell = document.createElement("span");
      numberCell.textContent = `P${String(index + 1).padStart(2, "0")}`;
      const positionCell = document.createElement("span");
      positionCell.textContent = coordinate(slot);
      const remove = document.createElement("button");
      remove.textContent = "REMOVE";
      remove.addEventListener("click", () => emitEditor("removeGridSlot", { index: index + 1 }));
      row.append(numberCell, positionCell, remove);
      gridList.append(row);
    });

    const list = $("checkpointList");
    list.replaceChildren();
    checkpoints.forEach((checkpoint, index) => {
      const row = document.createElement("div");
      row.className = "checkpoint-item";
      const numberCell = document.createElement("span");
      numberCell.textContent = String(index + 1).padStart(2, "0");
      const positionCell = document.createElement("span");
      positionCell.textContent = coordinate(checkpoint);
      const remove = document.createElement("button");
      remove.textContent = "REMOVE";
      remove.addEventListener("click", () => emitEditor("removeCheckpoint", { index: index + 1 }));
      row.append(numberCell, positionCell, remove);
      list.append(row);
    });

    const catalog = $("editorCatalog");
    catalog.replaceChildren();
    for (const course of editor.courses || []) {
      if ((course.vehicle === "on_foot") !== automaticGrid) continue;
      const row = document.createElement("div");
      row.className = "editor-course";
      const name = document.createElement("b");
      name.textContent = `${course.selected ? "● " : ""}${String(course.name || course.id).slice(0, 34)} · ${course.automaticGrid ? "AUTO" : `${integer(course.gridCapacity)}G`} · ${String(course.vehicleLabel || "CAR").slice(0, 24)}`;
      const load = document.createElement("button");
      load.textContent = course.builtin ? "COPY" : "EDIT";
      load.addEventListener("click", () => emitEditor("load", { id: course.id }));
      const select = document.createElement("button");
      select.textContent = "SELECT";
      select.addEventListener("click", () => emitEditor("select", { id: course.id }));
      row.append(name, load, select);
      if (!course.builtin) {
        const remove = document.createElement("button");
        remove.className = "delete";
        remove.textContent = "DELETE";
        let armed = false;
        let disarmTimer = 0;
        remove.addEventListener("click", () => {
          if (!armed) {
            armed = true;
            remove.classList.add("armed");
            remove.textContent = "CONFIRM";
            clearTimeout(disarmTimer);
            disarmTimer = setTimeout(() => {
              armed = false;
              remove.classList.remove("armed");
              remove.textContent = "DELETE";
            }, 3000);
            return;
          }
          clearTimeout(disarmTimer);
          emitEditor("delete", { id: course.id });
        });
        row.append(remove);
      }
      catalog.append(row);
    }
  }

  function renderGuidance(guidance, inRace, phase) {
    const element = $("checkpointGuide");
    const visible = inRace && phase === "active" && guidance && guidance.visible === true;
    element.classList.toggle("visible", visible);
    if (!visible) {
      guideAngleReady = false;
      return;
    }

    let rawAngle = number(guidance.angle);
    rawAngle = ((rawAngle + 180) % 360 + 360) % 360 - 180;
    if (!guideAngleReady) {
      guideAngle = rawAngle;
      guideAngleReady = true;
    } else {
      const delta = ((rawAngle - guideAngle + 540) % 360) - 180;
      guideAngle += delta;
    }

    const lateral = Math.sin(rawAngle * Math.PI / 180) * 62;
    element.style.setProperty("--guide-angle", `${guideAngle.toFixed(2)}deg`);
    element.style.setProperty("--guide-shift", `${lateral.toFixed(1)}px`);

    const distance = Math.max(0, number(guidance.distance));
    $("guideDistance").textContent = distance >= 1000
      ? `${(distance / 1000).toFixed(1)} KM`
      : `${Math.round(distance)} M`;
    const elevation = number(guidance.elevation);
    const vertical = elevation > 14 ? " · UP" : elevation < -14 ? " · DOWN" : "";
    const near = distance <= Math.max(18, number(guidance.radius, 7) * 2);
    $("guideDirection").textContent = near && !vertical && guidance.direction !== "BEHIND"
      ? "CROSS THE ZONE" : `${String(guidance.direction || "AHEAD").slice(0, 12)}${vertical}`;
    element.classList.toggle("finish-target", guidance.finish === true);
    $("guideCheckpoint").textContent = guidance.finish === true ? "FINISH LINE" :
      `CHECKPOINT ${integer(guidance.checkpoint, 1)} / ${integer(guidance.total, 1)}`;
  }

  function animateCountdown(kind, token) {
    const element = $("countdown");
    if (token === countdownVisualToken) return;
    countdownVisualToken = token;
    element.classList.remove("tick", "ready", "go");
    // Restart the keyframe for each authoritative 3/2/1 edge.
    void element.offsetWidth;
    element.classList.add(kind);
  }

  function render(payload) {
    state = payload && typeof payload === "object" ? payload : state;
    for (const key of ["rows", "roster", "courses"]) {
      if (typeof state[key] !== "string") continue;
      const encoded = state[key], cached = collectionCache.get(key);
      if (cached?.encoded === encoded) state[key] = cached.value;
      else {
        let value = [];
        try { const decoded = JSON.parse(encoded); if (Array.isArray(decoded)) value = decoded; } catch { /* malformed collections stay empty */ }
        collectionCache.set(key, { encoded, value }); state[key] = value;
      }
    }
    const phase = String(state.phase || "waiting");
    const participant = state.participant === true;
    $("recoveryHint").classList.toggle("hidden", state.canReturnCheckpoint !== true);
    $("returnKey").textContent = String(state.returnCheckpointKey || "F3").toUpperCase();
    const inRace = participant && ["grid", "countdown", "active"].includes(phase);
    const panelOpen = state.panelOpen === true;
    const boardOpen = state.boardHeld === true || (participant && phase === "results");
    const course = state.course || {};
    const row = selfRow() || {};
    const next = state.nextCheckpoint || {};
    const position = integer(row.rank, 0);

    body.dataset.phase = participant ? phase : "waiting";
    $("activityTitle").textContent = state.mode === "foot" ? "parkour." : "racing.";
    $("activityDescription").textContent = state.mode === "foot"
      ? "Athlete double jump · Advanced ground / air dash · Build your route through Night City."
      : "Queue from the city. Race together. Return to your session.";
    body.classList.toggle("has-activity", participant || state.queued === true);
    body.classList.toggle("in-race", inRace);
    body.classList.toggle("editor-active", Boolean(state.editor && state.editor.open !== false));
    body.classList.toggle("panel-open", panelOpen);
    body.classList.toggle("board-open", boardOpen);
    body.classList.toggle("chat-open", state.chatOpen === true);
    body.classList.toggle("notice-open", state.noticeOpen === true);

    $("hudCourse").textContent = String(course.name || "RACE").slice(0, 40);
    $("hudPosition").textContent = position ? `P${position}` : "--";
    $("hudLapLabel").textContent = course.type === "sprint" ? "FORMAT" : "LAP";
    $("hudLap").textContent = course.type === "sprint" ? "SPRINT" : `${integer(state.lap, 1)} / ${integer(state.laps, 1)}`;
    $("hudCheckpoint").textContent = `${Math.min(integer(state.checkpointIndex, 1), integer(state.totalCheckpoints, 1))} / ${integer(state.totalCheckpoints, 1)}`;
    const finishWindowActive = state.finishWindowActive === true && phase === "active";
    $("raceBar").classList.toggle("finish-window", finishWindowActive);
    $("hudTimeLabel").textContent = finishWindowActive ? "FINISH WINDOW" : "RACE TIME";
    $("hudTime").textContent = finishWindowActive
      ? raceTime(state.remainingMs, true) : raceTime(state.elapsedMs);
    $("nextIndex").textContent = `${integer(next.index, integer(state.checkpointIndex, 1))} / ${integer(state.totalCheckpoints, 1)}`;
    $("nextLap").textContent = course.type === "sprint" ? "POINT TO POINT" : `LAP ${integer(state.lap, 1)}/${integer(state.laps, 1)}`;
    $("bestLap").textContent = `BEST ${state.bestLapMs != null ? raceTime(state.bestLapMs) : "--:--.---"}`;
    renderGuidance(state.guidance, inRace, phase);

    const phaseName = phaseNames[phase] || phase.toUpperCase();
    $("boardPhase").textContent = finishWindowActive ? "FINISH WINDOW" : phaseName;
    $("boardTime").textContent = finishWindowActive
      ? raceTime(state.remainingMs, true)
      : phase === "grid" || phase === "countdown" || phase === "forming"
      ? raceTime(state.remainingMs, true) : raceTime(state.elapsedMs);
    $("boardCourse").textContent = String(course.name || "RACE CLASSIFICATION").slice(0, 64);
    $("boardMeta").textContent = `${String(course.type || "circuit").toUpperCase()} · ${integer(course.laps, 1)} LAP${integer(course.laps, 1) === 1 ? "" : "S"} · ${integer(course.checkpointCount, state.totalCheckpoints)} CHECKPOINTS`;

    const onGrid = participant && phase === "grid";
    const countdownVisible = participant && (onGrid || phase === "countdown" || goActive);
    $("countdown").classList.toggle("visible", countdownVisible);
    if (goActive) {
      animateCountdown("go", "go");
      $("countdownValue").textContent = "GO!";
      $("countdownLabel").textContent = "GREEN LIGHT";
      $("countdownCourse").textContent = String(course.name || "RACE STARTED").toUpperCase().slice(0, 64);
    } else if (onGrid) {
      const vehicle = state.vehicle || {};
      if (state.gridLoadActive === true) {
        const loadSeconds = Math.max(1, Math.ceil(number(state.remainingMs) / 1000));
        animateCountdown("ready", `grid-load:${loadSeconds}`);
        $("countdownValue").textContent = String(loadSeconds);
        $("countdownLabel").textContent = "GRID LOADING";
        $("countdownCourse").textContent = vehicle.ready === true
          ? "DRIVER LOCKED · WAITING FOR ALL PLAYERS"
          : `${String(vehicle.label || "RACE VEHICLE")} · AUTOMATIC BOARDING`.toUpperCase().slice(0, 64);
      } else {
        animateCountdown("ready", `grid:${vehicle.ready === true ? "ready" : "enter"}`);
        $("countdownValue").textContent = vehicle.ready === true ? "✓" : "SYNC";
        $("countdownLabel").textContent = vehicle.ready === true ? "DRIVER LOCKED" : "BOARDING VEHICLE";
        $("countdownCourse").textContent = vehicle.ready === true
          ? "WAITING FOR THE GRID"
          : `${String(vehicle.label || "RACE VEHICLE")} · AUTOMATIC DRIVER ASSIGNMENT`.toUpperCase().slice(0, 64);
      }
    } else {
      const count = Math.min(3, Math.max(1, Math.ceil(number(state.remainingMs) / 1000)));
      animateCountdown("tick", `countdown:${count}`);
      $("countdownValue").textContent = String(count);
      $("countdownLabel").textContent = "START SEQUENCE";
      $("countdownCourse").textContent = String(course.name || "PREPARE TO RACE").toUpperCase().slice(0, 64);
    }

    const result = state.result || {};
    const showResult = participant && phase === "results";
    $("resultBanner").classList.toggle("visible", showResult);
    if (showResult) {
      const won = String(result.winnerId) === String(state.playerId);
      $("resultTitle").textContent = won ? "VICTORY" : position ? `P${position} FINISH` : "RACE OVER";
      $("resultText").textContent = result.winnerName
        ? `${String(result.winnerName).slice(0, 48)} wins · ${integer(result.finishers)} classified finisher(s).`
        : "No classified finisher.";
    }

    if (state.onFoot && participant && phase === "grid") {
      $("countdownLabel").textContent = "RUNNERS TO START";
      $("countdownCourse").textContent = "DOUBLE JUMP + ADVANCED DASH · WAIT FOR GO";
    }
    if (panelOpen) renderLounge();

    renderLiveRows();
    renderBoard(boardOpen);
    renderCourses(Array.isArray(state.courses) ? state.courses : []);
    renderEditor(state.editor);
  }

  function toast(payload) {
    const item = document.createElement("div");
    item.className = `toast ${String(payload.kind || "info")}`;
    const title = document.createElement("strong");
    title.textContent = String(payload.title || "RACE").slice(0, 64);
    const message = document.createElement("span");
    message.textContent = String(payload.message || "").slice(0, 180);
    item.append(title, message);
    $("toasts").prepend(item);
    setTimeout(() => item.classList.add("leaving"), 4100);
    setTimeout(() => item.remove(), 4550);
  }

  function pulse(payload) {
    if (String(payload.kind || "") === "go") {
      clearTimeout(goTimer);
      goActive = true;
      countdownVisualToken = "";
      render(state);
      goTimer = setTimeout(() => {
        goActive = false;
        countdownVisualToken = "";
        render(state);
      }, 1250);
      return;
    }
    clearTimeout(pulseTimer);
    const element = $("pulse");
    element.className = `pulse visible ${String(payload.kind || "")}`;
    $("pulseText").textContent = String(payload.text || "CHECKPOINT").slice(0, 64);
    pulseTimer = setTimeout(() => element.classList.remove("visible"), payload.kind === "finish" ? 3200 : 1350);
  }

  function emitAction(action) {
    Open77.emit("race:action", { action });
  }

  function syncFields() {
    emitEditor("fields", {
      name: $("editName").value,
      description: $("editDescription").value,
      vehicle: dropdownValue("editVehicle"),
      type: dropdownValue("editType"),
      laps: integer($("editLaps").value, 1),
      checkpointRadius: number($("editRadius").value, 7)
    });
  }

  function closeFocusedPanel() {
    // Hiding a CEF page does not guarantee the focused input receives a normal
    // browser blur/change edge first. Publish the current metadata explicitly
    // so closing options and saving later from drive mode cannot restore stale
    // text or format values.
    if (state.editor && state.editor.open !== false) syncFields();
    emitAction("close");
  }

  body.querySelectorAll(".tab").forEach(button =>
    button.addEventListener("click", () => setTab(button.dataset.tab)));
  $("joinButton").addEventListener("click", () => emitAction("join"));
  $("backFreeroam").addEventListener("click", () => emitAction("freeroam"));
  $("openEditor").addEventListener("click", () => emitAction("editor"));
  $("leaveQueueButton").addEventListener("click", () => emitAction("leaveQueue"));
  $("leaveRaceButton").addEventListener("click", () => emitAction("leaveRace"));
  $("returnCheckpointButton").addEventListener("click", () => emitAction("returnCheckpoint"));
  $("editorReturnCheckpoint").addEventListener("click", () => emitEditor("returnCheckpoint"));
  $("closePanel").addEventListener("click", closeFocusedPanel);
  $("scrim").addEventListener("click", closeFocusedPanel);
  $("editName").addEventListener("change", syncFields);
  $("editDescription").addEventListener("change", syncFields);
  $("editLaps").addEventListener("change", syncFields);
  $("editRadius").addEventListener("change", syncFields);
  $("captureStart").addEventListener("click", () => { syncFields(); emitEditor("captureStart"); });
  $("captureGrid").addEventListener("click", () => { syncFields(); emitEditor("captureGrid"); });
  $("addCheckpoint").addEventListener("click", () => { syncFields(); emitEditor("addCheckpoint"); });
  $("undoGrid").addEventListener("click", () => emitEditor("undoGrid"));
  $("undoCheckpoint").addEventListener("click", () => emitEditor("undo"));
  $("newCourse").addEventListener("click", () => emitEditor("new"));
  $("saveCourse").addEventListener("click", () => { syncFields(); emitEditor("save"); });
  $("respawnEditorVehicle").addEventListener("click", () => emitEditor("spawnVehicle"));
  $("exitEditor").addEventListener("click", () => emitEditor("close"));
  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && body.classList.contains("panel-open")) {
      const dropdown = body.querySelector(".custom-dropdown.open");
      if (dropdown) {
        closeCustomDropdowns();
        dropdown.querySelector(".custom-dropdown-trigger").focus();
      } else closeFocusedPanel();
    }
  });

  initializeCustomDropdowns();

  Open77.on("race:render", render);
  Open77.on("race:notice", toast);
  Open77.on("race:pulse", pulse);
  Open77.on("race:editorOpen", () => setTab("editor"));
  Open77.on("race:panel", payload => body.classList.toggle("panel-open", payload && payload.open === true));
  Open77.on("race:initialize", () => Open77.emit("race:ready", {}));
  Open77.emit("race:ready", {});
})();
/* Freeroam / Race — same offline kit, one surface, activity-scoped chrome.
 * Racing layout: left classification, top-centre navigation, bottom-right timing.
 * Text-bearing gameplay panels deliberately raise HUD opacity to .96.
 */
.race-ui {
  --race-hud: rgba(11, 14, 20, .96);
  --race-inset: clamp(20px, 2.2vw, 40px);
  position: absolute; inset: 0; pointer-events: none; user-select: none;
  color: var(--text-primary); font-family: var(--font-body); color-scheme: dark;
}
.race-ui *, .race-ui *::before, .race-ui *::after { box-sizing: border-box;
  scrollbar-color: var(--o-ink-300) var(--surface-panel); scrollbar-width: thin; }
.race-ui .hidden { display: none !important; }
.race-ui button, .race-ui input, .race-ui textarea { font: inherit; }
.race-ui button { cursor: pointer; transition: var(--t-hover), transform var(--dur-1); }
.race-ui button:active { transform: translateY(1px); }
.race-ui button:disabled { opacity: .4; cursor: not-allowed; transform: none; }
.race-ui button:focus-visible, .race-ui input:focus-visible, .race-ui textarea:focus-visible {
  outline: 2px solid var(--o-cyan-500); outline-offset: -3px; box-shadow: none;
}
.race-ui .eyebrow, .race-ui label, .race-ui .editor-field > span,
.race-ui .metric > span, .race-ui .timer > span, .race-ui .board-meta {
  font: 600 11px/1.4 var(--font-ui); letter-spacing: var(--ls-label); text-transform: uppercase;
}
.race-ui .eyebrow { color: var(--text-eyebrow); }
.race-ui .eyebrow b { color: var(--o-cyan-500); margin-right: 8px; }
.race-ui kbd { font: 600 11px/1.3 var(--font-ui); color: var(--text-primary); padding: 3px 6px;
  border: 1px solid var(--line-strong); background: var(--surface-panel-hover); border-radius: 2px; }
.race-ui .scrim { display: none; position: absolute; inset: 0;
  background: var(--surface-scrim); backdrop-filter: blur(3px); }
.race-ui.panel-open .scrim { display: block; pointer-events: auto; }
.race-ui .control-panel { display: none; position: absolute; inset: 0 auto 0 0; z-index: 10;
  width: min(700px, 56vw); padding: 28px 32px; overflow-y: auto; overscroll-behavior: contain;
  background: var(--surface-app); border-right: 1px solid var(--line-strong);
  box-shadow: var(--shadow-overlay); clip-path: var(--cut-lg); pointer-events: auto;
  animation: race-panel-in var(--dur-3) var(--ease-out); scrollbar-color: var(--o-ink-300) transparent; }
.race-ui.panel-open .control-panel { display: block; }
.race-ui .panel-stripe { display: none; }
.race-ui .control-panel > .eyebrow { display: block; margin-top: 26px; }
.race-ui .control-panel h2 { display: flex; align-items: baseline; gap: 9px; margin: 8px 0 16px;
  font: 800 44px/.94 var(--font-display); letter-spacing: var(--ls-display); }
.race-ui .terminator { width: 10px; height: 10px; background: var(--o-cyan-500); }
.race-ui .close { position: absolute; top: 28px; right: 28px; width: 36px; height: 36px;
  border: 1px solid var(--line-strong); color: var(--text-secondary); background: transparent; font-size: 23px; }
.race-ui .close:hover { background: var(--surface-panel-hover); color: var(--text-primary); }
.race-ui .back-link { padding: 8px 0; color: var(--text-secondary); background: none; border: 0;
  font: 600 11px var(--font-ui); letter-spacing: var(--ls-label); }
.race-ui .back-link:hover { color: var(--o-cyan-500); }
.race-ui .tabs { display: flex; gap: 24px; margin: 26px 0 24px; border-bottom: 1px solid var(--line-strong); }
.race-ui .tab { padding: 14px 0; border: 0; border-bottom: 2px solid transparent; background: none;
  font: 600 12px var(--font-ui); letter-spacing: var(--ls-label); color: var(--text-secondary); }
.race-ui .tab.active { border-bottom-color: var(--o-cyan-500); color: var(--o-cyan-500); }
.race-ui .tab:hover { color: var(--text-primary); }
.race-ui .tab-page { display: none; }
.race-ui .tab-page.active { display: block; animation: race-fade var(--dur-2) var(--ease-out); }
.race-ui .section-copy, .race-ui .queue-copy { color: var(--text-secondary); font-size: 15px; line-height: 1.55; }
.race-ui .selected-course { padding: 24px; border: 1px solid var(--line-hairline);
  background: var(--surface-panel); clip-path: var(--cut-md); }
.race-ui .selected-course > span { color: var(--text-secondary); font: 600 10px var(--font-ui); letter-spacing: var(--ls-label); }
.race-ui .selected-course > strong { display: block; margin: 14px 0 10px;
  font: 700 28px/1.1 var(--font-display); text-transform: uppercase; overflow-wrap: anywhere; }
.race-ui .selected-course p { color: var(--text-secondary); font-size: 15px; line-height: 1.5; }
.race-ui .course-specs { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 24px; border-top: 1px solid var(--line-hairline); }
.race-ui .course-specs > div { padding: 16px 8px 0; border-right: 1px solid var(--line-hairline); }
.race-ui .course-specs > div:first-child { padding-left: 0; }
.race-ui .course-specs > div:last-child { border: 0; }
.race-ui .course-specs span { display: block; color: var(--text-secondary); font: 600 10px var(--font-ui); letter-spacing: .1em; }
.race-ui .course-specs b { display: block; margin-top: 8px; font: 600 14px var(--font-mono); }
.race-ui .queue-progress { height: 3px; margin: 24px 0 16px; background: var(--surface-panel-hover); }
.race-ui .queue-progress i { display: block; height: 100%; background: var(--o-cyan-500); transition: width var(--dur-4) var(--ease-out); }
.race-ui .panel-actions { display: grid; gap: 10px; margin-top: 24px; }
.race-ui .primary, .race-ui .secondary, .race-ui .danger, .race-ui .editor-launch,
.race-ui .inline-undo { min-height: 44px; padding: 12px 16px; border: 1px solid var(--line-strong);
  background: var(--surface-panel); color: var(--text-primary); font: 600 11px/1.4 var(--font-ui);
  letter-spacing: .1em; clip-path: var(--cut-sm); }
.race-ui .primary { color: var(--text-on-accent); border-color: var(--o-cyan-500); background: var(--o-cyan-500); }
.race-ui .primary:hover { background: var(--o-cyan-400); }
.race-ui .secondary:hover, .race-ui .editor-launch:hover { background: var(--surface-panel-hover); }
.race-ui .danger { color: var(--o-red-500); }
.race-ui .danger:hover { background: var(--o-red-700); color: var(--text-primary); }
.race-ui .editor-launch { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-top: 32px; }
.race-ui .editor-launch span { color: var(--text-secondary); font-size: 9px; }
.race-ui .course-list, .race-ui .editor-catalog { display: grid; gap: 10px; margin-top: 18px; }
.race-ui .course-card { padding: 20px; background: var(--surface-panel); border: 1px solid var(--line-hairline); clip-path: var(--cut-sm); }
.race-ui .course-card b { display: block; font: 700 19px var(--font-display); text-transform: uppercase; }
.race-ui .course-card em { display: block; margin-top: 9px; color: var(--text-secondary); font: normal 11px var(--font-mono); }
.race-ui .course-card p { color: var(--text-secondary); margin-bottom: 0; line-height: 1.5; }
.race-ui .editor-status, .race-ui .drive-status { padding: 12px 16px; margin: 0 0 18px; color: var(--text-secondary);
  border: 1px solid var(--line-hairline); background: var(--surface-panel-raised); font-size: 14px; line-height: 1.4; }
.race-ui .editor-status.error, .race-ui .error .drive-status { color: var(--o-red-500); }
.race-ui label, .race-ui .editor-field { display: block; margin-bottom: 16px; color: var(--text-secondary); }
.race-ui input, .race-ui textarea, .race-ui .custom-dropdown-trigger { width: 100%; min-width: 0; margin-top: 8px;
  padding: 12px; color: var(--text-primary); background: var(--surface-inset); border: 1px solid var(--line-strong);
  border-radius: 2px; font: 400 15px/1.4 var(--font-body); }
.race-ui textarea { min-height: 76px; resize: vertical; }
.race-ui .form-row { display: grid; grid-template-columns: 1.5fr .6fr .9fr; gap: 12px; }
.race-ui .custom-dropdown { position: relative; }
.race-ui .custom-dropdown-trigger { display: flex; align-items: center; justify-content: space-between; text-align: left; }
.race-ui .custom-dropdown-trigger i { border: 4px solid transparent; border-top-color: var(--text-secondary); transform: translateY(2px); }
.race-ui .custom-dropdown-menu { display: none; position: absolute; left: 0; right: 0; top: 100%; max-height: 220px;
  overflow-y: auto; z-index: 20; background: var(--surface-panel-raised); border: 1px solid var(--line-strong); }
.race-ui .custom-dropdown.open .custom-dropdown-menu { display: grid; }
.race-ui .custom-dropdown-option { text-align: left; padding: 12px; background: none; border: 0; color: var(--text-secondary); font-size: 14px; }
.race-ui .custom-dropdown-option:hover, .race-ui .custom-dropdown-option.selected { color: var(--o-cyan-500); background: var(--surface-panel-hover); }
.race-ui .editor-hint { color: var(--text-secondary); font-size: 13px; line-height: 1.55; }
.race-ui .capture-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 20px 0; }
.race-ui .capture { display: grid; grid-template-columns: 32px 1fr; gap: 5px 8px; padding: 16px 12px; text-align: left;
  color: var(--text-primary); background: var(--surface-panel); border: 1px solid var(--line-strong); clip-path: var(--cut-sm); }
.race-ui .capture:hover { background: var(--surface-panel-hover); }
.race-ui .capture span { grid-row: span 2; align-self: center; font: 700 22px var(--font-mono); color: var(--text-secondary); }
.race-ui .capture b { font: 600 11px var(--font-ui); letter-spacing: .08em; }
.race-ui .capture small { color: var(--text-secondary); font-size: 12px; }
.race-ui .capture.grid-slot { grid-column: 1/-1; }
.race-ui .checkpoint-head { display: flex; justify-content: space-between; padding: 16px 0 10px; font: 600 11px var(--font-ui); letter-spacing: .1em; }
.race-ui .checkpoint-head b { font-family: var(--font-mono); }
.race-ui .checkpoint-list { max-height: 210px; overflow-y: auto; }
.race-ui .checkpoint-item, .race-ui .grid-item, .race-ui .editor-course { display: grid; grid-template-columns: 32px 1fr auto; align-items: center;
  gap: 10px; padding: 10px 8px; border-bottom: 1px solid var(--line-hairline); font: 11px var(--font-mono); }
.race-ui .checkpoint-item button, .race-ui .grid-item button, .race-ui .editor-course button { padding: 8px; background: var(--surface-panel-hover);
  border: 1px solid var(--line-hairline); color: var(--text-secondary); font: 600 10px var(--font-ui); }
.race-ui .inline-undo { width: 100%; margin: 10px 0; }
.race-ui .editor-actions { display: grid; grid-template-columns: 1fr 1fr 1.4fr; gap: 8px; margin: 18px 0; }
.race-ui .editor-session-actions { grid-template-columns: 1fr 1fr; }
.race-ui .editor-course { grid-template-columns: 1fr auto auto auto; }
.race-ui .editor-course b { overflow-wrap: anywhere; }
.race-ui .editor-course .delete { color: var(--o-red-500); }
.race-ui .editor-course .delete.armed { color: var(--text-primary); background: var(--o-red-700); }
.race-ui .race-bar { display: none; position: absolute; right: 32px; bottom: 96px;
  width: clamp(270px, 23vw, 340px); grid-template-columns: repeat(3, minmax(0, 1fr));
  background: var(--race-hud); border: 1px solid var(--line-strong); clip-path: var(--cut-md); }
.race-ui.in-race .race-bar { display: grid; }
.race-ui .mode-lockup { grid-column: 1 / -1; min-width: 0; padding: 16px 18px 14px;
  display: flex; flex-direction: column; gap: 6px; border-bottom: 1px solid var(--line-hairline); }
.race-ui .mode-lockup strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 700 17px var(--font-display); text-transform: uppercase; }
.race-ui .mode-lockup .eyebrow { font-size: 9px; letter-spacing: .06em; }
.race-ui .metric, .race-ui .timer { min-width: 0; padding: 16px 10px; border-left: 1px solid var(--line-hairline);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; }
.race-ui .metric > span, .race-ui .timer > span { font-size: 9px; letter-spacing: .08em; color: var(--text-secondary); }
.race-ui .metric strong, .race-ui .timer time { font: 600 clamp(17px, 1.4vw, 21px) var(--font-mono);
  font-variant-numeric: tabular-nums; white-space: nowrap; }
.race-ui .metric.position { border-left: 0; }
.race-ui .timer { grid-column: 1 / -1; flex-direction: row; justify-content: space-between;
  padding: 14px 18px; border-left: 0; border-top: 1px solid var(--line-hairline); }
.race-ui .timer time { font-size: 22px; }
.race-ui .metric.position strong { color: var(--o-cyan-500); }
.race-ui .finish-window .timer time { color: var(--o-amber-500); }
.race-ui .next-card { display: none; }
.race-ui .checkpoint-guide { display: none; position: absolute; top: max(64px, 8vh); left: 50%; transform: translateX(-50%);
  text-align: center; width: 200px; text-shadow: 0 2px 5px var(--o-black); }
.race-ui .checkpoint-guide.visible { display: block; }
.race-ui .guide-kicker { display: inline-block; padding: 5px 9px; background: var(--race-hud);
  font: 600 10px var(--font-ui); letter-spacing: .12em; color: var(--text-primary); clip-path: var(--cut-sm); }
.race-ui .guide-stage { height: 96px; display: grid; place-items: center; }
.race-ui .guide-arrow { width: 90px; height: 104px; overflow: visible;
  transform: perspective(520px) rotateX(48deg) rotateZ(var(--guide-angle)); transform-origin: 50% 48%;
  transition: transform var(--dur-1) linear; }
.race-ui .guide-arrow-face { fill: url(#race-guideFace); stroke: var(--o-cyan-400); stroke-width: 2; }
.race-ui .finish-target .guide-arrow-face { fill: var(--o-chrome-100); stroke: var(--o-chrome-000); }
.race-ui .finish-target .guide-kicker { color: var(--o-chrome-100); border-bottom: 2px solid var(--o-chrome-100); }
.race-ui .guide-arrow-depth { fill: url(#race-guideEdge); stroke: var(--o-cyan-900); stroke-width: 2; }
.race-ui .guide-arrow-shadow { fill: rgba(0, 0, 0, .7); transform: translateY(15px); filter: blur(4px); }
.race-ui .guide-arrow-shine { fill: rgba(255, 255, 255, .18); }
.race-ui .guide-readout { display: inline-flex; align-items: center; gap: 10px; padding: 7px 12px;
  background: var(--race-hud); clip-path: var(--cut-sm); }
.race-ui .guide-readout strong { font: 600 19px var(--font-mono); }
.race-ui .guide-readout span { color: var(--text-secondary); font: 600 10px var(--font-ui); letter-spacing: .1em; }
.race-ui .live-order { display: none; position: absolute; left: var(--race-inset); top: 40vh;
  width: clamp(245px, 22vw, 310px); background: var(--race-hud); border: 1px solid var(--line-hairline); clip-path: var(--cut-sm); }
.race-ui.in-race .live-order { display: block; }
.race-ui.in-race.chat-open .live-order,
.race-ui.in-race.notice-open .live-order { display: none; }
.race-ui .live-order header { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px;
  font: 600 10px var(--font-ui); letter-spacing: .1em; color: var(--text-secondary); }
.race-ui .live-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: center;
  gap: 8px; min-height: 36px; padding: 9px 14px; border-top: 1px solid var(--line-hairline); font-size: 13px; }
.race-ui .live-row b { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.race-ui .live-row em { font: normal 10px var(--font-mono); }
.race-ui .live-row.self { color: var(--o-cyan-500); background: rgba(34, 216, 226, .08); }
.race-ui .countdown, .race-ui .pulse, .race-ui .result-banner { display: none; position: absolute; top: 34vh; left: 50%; transform: translateX(-50%);
  text-align: center; padding: 24px; background: var(--race-hud); border: 1px solid var(--line-strong); clip-path: var(--cut-lg); }
.race-ui .countdown.visible, .race-ui .pulse.visible, .race-ui .result-banner.visible { display: block; }
.race-ui .countdown span, .race-ui .countdown small { display: block; color: var(--text-secondary); font: 600 11px var(--font-ui); letter-spacing: .1em; }
.race-ui .countdown strong { display: block; margin: 12px; font: 800 80px/1 var(--font-display); font-variant-numeric: tabular-nums; }
.race-ui .countdown.go strong { color: var(--o-mint-500); }
.race-ui .countdown.tick strong, .race-ui .countdown.go strong { animation: race-impact var(--dur-3) var(--ease-out); }
.race-ui .pulse { top: calc(max(64px, 8vh) + 166px); padding: 8px 16px; font: 700 16px var(--font-display); }
.race-ui .result-banner { top: 19vh; width: min(540px, 48vw); }
.race-ui .result-banner strong { display: block; margin: 12px 0; font: 800 40px var(--font-display); }
.race-ui .result-banner p { color: var(--text-secondary); }
.race-ui .scoreboard { display: none; position: absolute; top: 20vh; left: 50%; transform: translateX(-50%); z-index: 7;
  width: min(1140px, 82vw); max-height: 69vh; overflow: auto; padding: 24px; background: var(--race-hud);
  border: 1px solid var(--line-strong); clip-path: var(--cut-lg); }
.race-ui.board-open .scoreboard { display: block; }
.race-ui.board-open .live-order, .race-ui.board-open .checkpoint-guide,
.race-ui.board-open .race-bar, .race-ui.board-open .pulse { display: none; }
.race-ui[data-phase="results"] .scoreboard { top: 43vh; max-height: 43vh; }
.race-ui .scoreboard header { display: flex; justify-content: space-between; gap: 24px; margin-bottom: 16px; }
.race-ui .scoreboard h1 { font: 700 26px var(--font-display); margin: 8px 0; }
.race-ui .board-clock { display: grid; gap: 8px; text-align: right; font: 12px var(--font-mono); }
.race-ui .board-meta { color: var(--text-secondary); padding-bottom: 20px; }
.race-ui .board-columns, .race-ui .board-row { display: grid; grid-template-columns: 40px 1.8fr 1fr .6fr 1fr 1fr 1fr; gap: 12px; padding: 12px 0;
  border-bottom: 1px solid var(--line-hairline); font: 12px var(--font-mono); }
.race-ui .board-columns { color: var(--text-secondary); font: 600 10px var(--font-ui); letter-spacing: .08em; }
.race-ui .board-row.self { color: var(--o-cyan-500); background: var(--surface-panel-raised); }
.race-ui .board-row span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.race-ui .board-empty { padding: 32px 0; color: var(--text-secondary); }
.race-ui .scoreboard footer { display: flex; justify-content: space-between; padding-top: 20px; color: var(--text-secondary); font: 10px var(--font-ui); letter-spacing: .1em; }
.race-ui .editor-drive-hud { display: none; position: absolute; top: 63vh; left: 50%; transform: translateX(-50%); width: min(650px, 50vw);
  padding: 16px; background: var(--race-hud); border: 1px solid var(--line-strong); clip-path: var(--cut-md); }
.race-ui.editor-active:not(.panel-open) .editor-drive-hud { display: block; }
.race-ui .editor-drive-hud header { display: flex; justify-content: space-between; gap: 12px; }
.race-ui .editor-drive-hud header strong { display: block; margin-top: 6px; font: 700 17px var(--font-display); }
.race-ui .drive-live { font: 10px var(--font-ui); color: var(--o-mint-500); white-space: nowrap; }
.race-ui .drive-counts { display: flex; gap: 24px; margin: 14px 0; font: 10px var(--font-ui); color: var(--text-secondary); }
.race-ui .drive-counts b { margin-left: 6px; color: var(--text-primary); font-family: var(--font-mono); }
.race-ui .drive-primary-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.race-ui .drive-primary-actions > div { display: flex; align-items: center; gap: 8px; padding: 8px; background: var(--surface-panel-raised); font: 10px var(--font-ui); }
.race-ui .drive-secondary-actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 14px 0; color: var(--text-secondary); font: 10px var(--font-ui); }
.race-ui .drive-status { margin: 0; padding: 8px; font-size: 12px; }
.race-ui .editor-drive-hud footer { margin-top: 10px; text-align: right; color: var(--text-secondary); font: 9px var(--font-ui); letter-spacing: .1em; }
/* Native notifications own toasts; never draw a second stack through chat. */
.race-ui .toasts { display: none; }
.race-ui.panel-open .race-bar, .race-ui.panel-open .checkpoint-guide, .race-ui.panel-open .live-order,
.race-ui.panel-open .countdown, .race-ui.panel-open .result-banner, .race-ui.panel-open .scoreboard { display: none; }
@keyframes race-panel-in { from { opacity: 0; transform: translateX(-16px); } }
@keyframes race-fade { from { opacity: 0; } }
@keyframes race-impact { from { opacity: .4; transform: translateY(8px); } }
@media (max-width: 1000px) {
  .race-ui .control-panel { width: min(700px, 94vw); padding: 22px; }
  .race-ui .race-bar { width: 250px; }
  .race-ui .metric strong { font-size: 19px; }
  .race-ui .live-order { width: 235px; }
  .race-ui .editor-drive-hud { width: 60vw; }
  .race-ui .drive-primary-actions { grid-template-columns: 1fr; }
  .race-ui .scoreboard { width: 94vw; }
}
@media (max-height: 800px) {
  .race-ui .mode-lockup { padding: 12px 14px; }
  .race-ui .metric { padding: 11px 8px; }
  .race-ui .timer { padding: 12px 14px; }
  .race-ui .live-row { min-height: 32px; padding: 7px 12px; }
  .race-ui .result-banner { padding: 16px; }
  .race-ui .result-banner strong { margin: 6px 0; font-size: 32px; }
}
@media (max-height: 800px) { .race-ui .editor-drive-hud { top: 56vh; } }
/* Race lounge: a spacious, self-contained overlay. No viewport-sized sidebar. */
.race-ui .scrim { background: rgba(3, 9, 13, .66); backdrop-filter: blur(12px); }
.race-ui .control-panel {
  inset: 50% auto auto 50%; translate: -50% -50%; width: min(1400px, 92vw);
  height: min(960px, 92vh); max-height: 92vh; padding: clamp(22px, 2.2vw, 34px); overflow: hidden;
  border: 1px solid #283b45; border-radius: 18px; clip-path: none;
  background: radial-gradient(ellipse at 95% 0, #102a32 0, transparent 48%), #0b131a;
  box-shadow: 0 35px 100px #0009; animation: race-lounge-in .3s ease-out;
}
.race-ui.panel-open .control-panel { display: flex; flex-direction: column; }
.race-ui .lounge-header, .race-ui .tabs, .race-ui .session-stage, .race-ui .lounge-footer, .race-ui .lounge-bottom { flex-shrink: 0; }
.race-ui .control-panel > .tab-page { min-height: 0; overflow-y: auto; flex: 1; padding-right: 3px; }
.race-ui .control-panel > .tab-page.active[data-page=lobby] { display: flex; flex-direction: column; overflow: hidden; }
.race-ui .lounge-grid { flex: 1; min-height: 0; overflow-y: auto; padding: 3px 3px 0 0; }
.race-ui .lounge-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-right: 64px; }
.race-ui .lounge-header h2 { margin: 8px 0; display: block; font-size: clamp(32px, 2.8vw, 43px); font-weight: 700; letter-spacing: -.035em; }
.race-ui .lounge-header h2 span { color: #27dae0; }
.race-ui .lounge-header p { margin: 0; color: #9badb9; font-size: 14px; line-height: 1.4; }
.race-ui .close { top: 30px; right: 30px; border-radius: 50%; width: 38px; height: 38px; }
.race-ui .lounge-live { display: flex; gap: 8px; align-items: center; flex-shrink: 0; font: 10px var(--font-mono); letter-spacing: .12em; color: #aac3cb; }
.race-ui .lounge-live i { width: 6px; height: 6px; border-radius: 100%; background: #28d9b1; box-shadow: 0 0 12px #28d9b15c; }
.race-ui .tabs { margin: 18px 0; gap: 30px; }
.race-ui .tab { text-transform: none; letter-spacing: .02em; padding: 12px 0 15px; font-size: 13px; }
.race-ui .session-stage { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 17px 24px; border: 1px solid #23424b; border-radius: 12px; background: linear-gradient(115deg, #123139 0%, #111f28 65%); }
.race-ui .stage-copy { min-width: 0; }
.race-ui .stage-copy .eyebrow { color: #6fd1d5; font-size: 10px; }
.race-ui .stage-copy h3 { margin: 8px 0; font: 600 clamp(20px, 1.9vw, 29px)/1.15 var(--font-display); letter-spacing: -.015em; overflow-wrap: anywhere; }
.race-ui .stage-copy p { margin: 0; font-size: 13px; color: #a2b7c2; line-height: 1.45; }
.race-ui .stage-clock { flex: 0 0 155px; text-align: right; }
.race-ui .stage-clock > span { display: block; color: #9dbbc6; font: 9px var(--font-mono); letter-spacing: .08em; }
.race-ui .stage-clock time { display: block; margin: 5px 0; color: #f3fdff; font: 500 44px/1.1 var(--font-mono); font-variant-numeric: tabular-nums; }
.race-ui .clock-track { height: 3px; background: #29434c; border-radius: 2px; overflow: hidden; }
.race-ui .clock-track i { display: block; height: 100%; background: #26dbe2; transform-origin: left; transition: transform .1s linear; }
.race-ui .session-stage.urgent .stage-clock time { color: #ffd68b; }
.race-ui .session-stage.urgent .clock-track i { background: #ffd68b; }
.race-ui .session-stage.reveal { border-color: #3c9791; }
.race-ui .lounge-grid { display: grid; grid-template-columns: minmax(0, 2.3fr) minmax(260px, 1fr); gap: 32px; margin: 27px 0; }
.race-ui .lounge-section-title { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 17px; }
.race-ui .lounge-section-title h3 { margin: 6px 0 0; font: 600 23px var(--font-display); letter-spacing: -.02em; }
.race-ui .lounge-section-title .eyebrow { font-size: 9px; color: #8299a8; }
.race-ui .lounge-section-title > span { font: 11px var(--font-mono); color: #a6bdc8; text-align: right; }
.race-ui .vote-courses { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
.race-ui .route-card { --route-color: #48dadd; position: relative; display: flex; flex-direction: column; text-align: left; width: 100%; min-width: 0; padding: 0;
  border: 1px solid #2b3c47; border-radius: 10px; background: #121e28; color: #eaf3f6; overflow: hidden;
  transition: border-color .2s, background .2s, transform .2s, box-shadow .2s; }
.race-ui .route-card:nth-child(3n+2) { --route-color: #e2be7b; }
.race-ui .route-card:nth-child(3n+3) { --route-color: #af9de7; }
.race-ui .route-card:hover { border-color: #6b8796; background: #182a36; transform: translateY(-3px); }
.race-ui .route-card[aria-disabled=true] { cursor: default; }
.race-ui .route-card.selected { border-color: #28dae1; box-shadow: 0 0 0 1px #28dae12b, 0 8px 25px #0003; }
.race-ui .route-card.winner { border-color: #6de1b9; background: #132b2a; }
.race-ui .route-art { position: relative; height: 115px; padding: 20px 16px 8px; background: radial-gradient(ellipse at center, #1d3941aa, transparent 75%), linear-gradient(#ffffff04 1px, transparent 1px), linear-gradient(90deg, #ffffff04 1px, transparent 1px); background-size: auto, 22px 22px, 22px 22px; }
.race-ui .route-art svg { width: 100%; height: 100%; overflow: visible; color: var(--route-color); filter: drop-shadow(0 3px 6px #0007); }
.race-ui .route-number { position: absolute; top: 12px; left: 14px; font: 9px var(--font-mono); color: #7f98a9; }
.race-ui .route-pick { position: absolute; top: 10px; right: 10px; border-radius: 4px; padding: 4px 7px; font: 9px var(--font-mono); color: #c0d0d8; background: #091219b3; }
.race-ui .selected .route-pick { background: #27dae0; color: #052127; }
.race-ui .winner .route-pick { background: #6de1b9; color: #052127; }
.race-ui .route-info { display: flex; flex-direction: column; flex: 1; padding: 12px 14px; }
.race-ui .route-type { font: 9px var(--font-mono); letter-spacing: .09em; color: var(--route-color); text-transform: uppercase; }
.race-ui .route-info h4 { font: 600 21px/1.15 var(--font-display); margin: 6px 0 8px; overflow-wrap: anywhere; }
.race-ui .route-specs { color: #afc0ca; font-size: 12px; line-height: 1.5; }
.race-ui .route-vehicle { color: #8198a9; font-size: 11px; margin-top: 4px; line-height: 1.4; }
.race-ui .route-votes { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #ffffff0c; padding: 9px 14px; font: 11px var(--font-mono); color: #a1b5c3; }
.race-ui .route-votes b { font: 500 19px var(--font-mono); color: #e9f3f6; }
.race-ui .vote-help { font-size: 12px; line-height: 1.6; color: #8fa6b5; margin: 14px 0 0; }
.race-ui .heat-summary { margin-top: 14px; padding: 12px 16px; border-left: 2px solid #c7a66d; background: #f4c87308; color: #cbbd9e; font-size: 12px; line-height: 1.6; }
.race-ui .drivers-section { border-left: 1px solid #273540; padding-left: 26px; min-width: 0; }
.race-ui .lounge-section-title .driver-count { font: 400 30px var(--font-mono); color: #eef8ff; }
.race-ui .roster-list { max-height: 330px; overflow-y: auto; padding-right: 4px; }
.race-ui .roster-heading { color: #7e96a6; font: 9px var(--font-mono); letter-spacing: .08em; padding: 10px 0; }
.race-ui .driver-row { display: flex; align-items: center; gap: 11px; padding: 12px 0; border-bottom: 1px solid #ffffff09; animation: race-driver-in .25s ease-out; }
.race-ui .driver-avatar { width: 34px; height: 34px; border-radius: 9px; background: #21333f; color: #bfd0dc; display: grid; place-items: center; font: 11px var(--font-mono); flex-shrink: 0; }
.race-ui .driver-row.self .driver-avatar { background: #134449; color: #53e0e4; }
.race-ui .driver-details { flex: 1; min-width: 0; }
.race-ui .driver-details b { display: block; font-size: 13px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.race-ui .driver-details small { display: block; font-size: 10px; color: #8da6b6; margin-top: 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.race-ui .driver-place { color: #8299a9; font: 10px var(--font-mono); }
.race-ui .driver-row.voted .driver-place { color: #58d7cc; }
.race-ui .roster-empty { display: grid; align-content: center; min-height: 200px; border: 1px dashed #2b3e49; border-radius: 10px; padding: 24px; text-align: center; }
.race-ui .roster-empty b { font: 500 20px var(--font-display); color: #b8ccd8; }
.race-ui .roster-empty p { color: #8099a9; font-size: 12px; line-height: 1.6; }
.race-ui .roster-foot { font-size: 10px; color: #78919f; line-height: 1.6; margin: 15px 0 0; }
.race-ui .lounge-footer { display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 20px 0 0; border-top: 1px solid #2b3a43; }
.race-ui .queue-status .eyebrow { font-size: 9px; color: #94b9c7; }
.race-ui .queue-status p { margin: 6px 0 0; color: #bfced7; font-size: 13px; line-height: 1.5; }
.race-ui .panel-actions { display: flex; margin: 0; flex-shrink: 0; }
.race-ui .panel-actions button { min-width: 185px; min-height: 48px; border-radius: 8px; clip-path: none; font-size: 12px; }
.race-ui .panel-actions .primary { display: flex; align-items: center; justify-content: space-between; gap: 35px; }
.race-ui .lounge-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 18px; color: #607988; font: 9px var(--font-mono); letter-spacing: .1em; }
.race-ui .lounge-bottom .back-link { font-size: 9px; }
.race-ui .course-list { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
.race-ui .course-card { clip-path: none; border-radius: 10px; }
@keyframes race-lounge-in { from { opacity: 0; transform: translateY(12px) scale(.99); } }
@keyframes race-driver-in { from { opacity: 0; transform: translateX(6px); } }
@keyframes race-vote-tick { 50% { color: #36e2e4; transform: scale(1.25); } }
.race-ui .route-votes b.changed { animation: race-vote-tick .3s ease; }
@media (max-width: 1050px) {
  .race-ui .control-panel { width: 94vw; padding: 24px; }
  .race-ui .lounge-grid { gap: 20px; grid-template-columns: minmax(0, 2fr) minmax(220px, 1fr); }
  .race-ui .drivers-section { padding-left: 18px; }
  .race-ui .vote-courses { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .race-ui .route-info { padding: 13px; }
  .race-ui .route-info h4 { font-size: 18px; }
  .race-ui .lounge-live { display: none; }
}
@media (max-width: 720px) {
  .race-ui .lounge-grid { grid-template-columns: 1fr; }
  .race-ui .drivers-section { border-left: 0; padding-left: 0; }
  .race-ui .roster-list { max-height: 200px; }
  .race-ui .stage-clock { flex-basis: 110px; }
  .race-ui .stage-clock time { font-size: 32px; }
  .race-ui .session-stage { padding: 16px; }
  .race-ui .lounge-footer { flex-direction: column; align-items: stretch; }
  .race-ui .panel-actions button { flex: 1; }
}
@media (max-height: 820px) {
  .race-ui .control-panel { max-height: 92vh; padding: 22px 28px; }
  .race-ui .lounge-header h2 { margin: 6px 0; font-size: 34px; }
  .race-ui .tabs { margin: 12px 0 16px; }
  .race-ui .session-stage { padding: 15px 22px; }
  .race-ui .lounge-grid { margin: 20px 0; }
  .race-ui .route-art { height: 105px; }
  .race-ui .lounge-section-title { margin-bottom: 12px; }
  .race-ui .lounge-footer { padding-top: 14px; }
  .race-ui .lounge-bottom { margin-top: 10px; }
}
@media (prefers-reduced-motion: reduce) {
  .race-ui *, .race-ui *::before, .race-ui *::after { animation: none !important; transition: none !important; }
}
/* Keyboard recovery stays available without opening the focused race menu. */
.race-ui .recovery-hint { grid-column: 1 / -1; padding: 10px 14px; color: var(--text-secondary); font-size: 10px; border-top: 1px solid var(--line-hairline); }
.race-ui .recovery-hint kbd { color: var(--o-cyan-500); margin-right: 6px; }
