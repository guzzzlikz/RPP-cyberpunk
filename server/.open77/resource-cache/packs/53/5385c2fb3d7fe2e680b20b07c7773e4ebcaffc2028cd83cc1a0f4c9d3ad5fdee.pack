x;font-size:8px}.m3-blip.in-fan{z-index:5}.m3-blip.fan-in>*{animation:m3-fan-in .24s cubic-bezier(.2,.9,.3,1.15) both}.m3-blip.fan-out>*{animation:m3-fan-out .2s ease-in both}@keyframes m3-fan-in{0%{translate:0 var(--fan-y);opacity:0}to{translate:0 0;opacity:1}}@keyframes m3-fan-out{0%{translate:0 0;opacity:1}to{translate:0 var(--fan-y);opacity:0}}.m3-blip.in-fan .m3-blip__pin{box-shadow:0 0 0 3px #050506d9,0 0 14px #000000e6}.m3-blip.is-pulse .m3-blip__pin:after{content:"";position:absolute;inset:-6px;border:1.5px solid var(--blip-color);animation:m3-pulse 1.6s ease-out infinite}.m3-districts{position:absolute;inset:0;overflow:hidden}.m3-district{position:absolute;left:0;top:0}.m3-district span{display:block;transform:translate(-50%,-50%);font:400 15px var(--m3-display);letter-spacing:.3em;color:#f2f3f58c;text-shadow:0 0 10px #000,0 0 3px #000;white-space:nowrap}.m3-toast{position:absolute;left:50%;bottom:120px;transform:translate(-50%);padding:10px 18px;background:var(--m3-panel);border:1px solid var(--m3-accent);font:700 13px var(--m3-core);letter-spacing:.24em;opacity:0}.m3-toast.is-danger{border-color:var(--m3-danger);color:var(--m3-danger)}.m3.is-mini-role .m3-toast{left:auto;bottom:auto;top:calc(26px + var(--m3-mini-size) + 30px);right:32px;transform:none;padding:6px 12px;font-size:11px;max-width:var(--m3-mini-size);box-sizing:border-box}.m3.is-mini-role[data-anchor$=left] .m3-toast{right:auto;left:32px}.m3.is-mini-role[data-anchor^=bottom] .m3-toast{top:auto;bottom:calc(26px + var(--m3-mini-size) + 8px)}.m3.is-mini-role .m3-toast.is-on{animation:m3-toast-mini 2.8s ease-out both}.m3-toast.is-on{animation:m3-toast 2.8s ease-out both}.m3-loading{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:none;flex-direction:column;gap:8px;align-items:center;padding:18px 26px;background:var(--m3-panel);border:1px solid var(--m3-line)}.m3.is-open .m3-loading:not(.is-done){display:flex}.m3-loading b{font:400 16px var(--m3-display);letter-spacing:.2em}.m3-loading span{font:600 11px var(--m3-core);letter-spacing:.3em;color:var(--m3-accent)}.m3-loading i{display:block;width:220px;height:3px;background:#ffffff14}.m3-loading em{display:block;height:100%;width:0;background:var(--m3-accent);transition:width .2s}@keyframes m3-in{0%{opacity:0;transform:translate(-8px)}}@keyframes m3-pulse{0%{transform:scale(.8);opacity:.9}to{transform:scale(1.8);opacity:0}}@keyframes m3-toast-mini{0%{opacity:0}10%,80%{opacity:1}to{opacity:0}}@keyframes m3-toast{0%{opacity:0;transform:translate(-50%,8px)}10%,80%{opacity:1;transform:translate(-50%)}to{opacity:0}}.m3.is-holo-role>:not(.m3-holo){display:none!important}.m3-holo{position:absolute;left:50%;bottom:0;width:760px;height:310px;transform:translate(-50%,104%);opacity:0;transition:transform .5s cubic-bezier(.2,.9,.25,1),opacity .35s ease-out;pointer-events:none}.m3-holo.is-on{transform:translate(-50%);opacity:1;animation:m3-holo-in .6s steps(6,end) both}.m3-holo__view{position:absolute;inset:0;width:100%;height:100%;-webkit-mask-image:radial-gradient(ellipse 62% 125% at 50% 100%,#000 62%,transparent 100%);mask-image:radial-gradient(ellipse 62% 125% at 50% 100%,#000 62%,transparent 100%)}@keyframes m3-holo-in{0%{filter:brightness(2.2) saturate(.4)}30%{filter:brightness(.6)}55%{filter:brightness(1.6)}to{filter:none}}.m3-jam{position:absolute;inset:0;display:none;overflow:hidden;pointer-events:none;z-index:4;background:rgba(8,9,12,calc(var(--m3-jam, 0) * .94))}.m3.is-jamming .m3-jam{display:block}.m3-mini .m3-jam{z-index:6}.m3-full>.m3-jam{z-index:auto}.m3-full>.m3-jam .m3-jam__label{padding:12px 22px;gap:12px;font-size:18px;letter-spacing:.34em}.m3-full>.m3-jam .m3-jam__label svg{width:26px;height:26px}.m3[data-shape=chamfer] .m3-mini .m3-jam{clip-path:polygon(var(--m3-chamfer) 0,100% 0,100% calc(100% - var(--m3-chamfer)),calc(100% - var(--m3-chamfer)) 100%,0 100%,0 var(--m3-chamfer))}.m3[data-shape=circle] .m3-mini .m3-jam{border-radius:50%}.m3-jam__noise{position:absolute;inset:-128px;background:var(--m3-noise) repeat;opacity:calc(.18 + var(--m3-jam, 0) * .5);mix-blend-mode:screen;animation:m3-noise .4s steps(1) infinite}.m3-jam__noise:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(to bottom,rgba(0,0,0,.45) 0 1px,transparent 1px 3px)}.m3-jam__band{position:absolute;left:0;right:0;height:18%;top:-20%;background:linear-gradient(to bottom,transparent,rgba(255,255,255,.09) 40%,var(--m3-accent-soft) 50%,rgba(255,255,255,.06) 60%,transparent);animation:m3-band 2.6s linear infinite;opacity:var(--m3-jam, 0)}.m3-jam__label{position:absolute;left:50%;top:50%;translate:-50% -50%;display:none;align-items:center;gap:8px;padding:6px 12px;white-space:nowrap;background:#08090cd1;border:1px solid var(--m3-accent);color:var(--m3-accent);font:700 12px var(--m3-core);letter-spacing:.3em;animation:m3-flicker 2.2s steps(1) infinite}.m3-mini .m3-jam__label{padding:4px 8px;font-size:10px;letter-spacing:.24em}.m3.has-jam-label .m3-jam__label{display:flex}.m3.is-jamming:not(.is-jammed) .m3-canvas{animation:m3-shake .3s steps(2) infinite}.m3.is-jammed .m3-markers,.m3.is-jammed .m3-nav,.m3.is-jammed .m3-mini__north,.m3.is-jammed .m3-mini__info,.m3.is-jammed .m3-routebar,.m3.is-jammed .m3-districts,.m3.is-jammed .m3-readout{visibility:hidden}@keyframes m3-noise{0%{translate:0 0}20%{translate:-37px 21px}40%{translate:18px -44px}60%{translate:-61px -9px}80%{translate:42px 33px}}@keyframes m3-band{0%{top:-20%}to{top:110%}}@keyframes m3-shake{0%{translate:0 0}50%{translate:calc(var(--m3-jam, 0) * 3px) calc(var(--m3-jam, 0) * -2px)}}@keyframes m3-flicker{0%,to{opacity:1}7%{opacity:.35}9%{opacity:1}52%{opacity:.6}54%{opacity:1}}
