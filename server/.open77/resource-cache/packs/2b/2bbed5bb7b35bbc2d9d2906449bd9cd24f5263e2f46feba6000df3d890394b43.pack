        },
    },

    -- -------------------------------------------------------------------------
    -- Bare television screens: the display with no cabinet
    -- -------------------------------------------------------------------------
    -- These are the same quads as the sets above, on the screen mesh alone. They
    -- are what to put on a wall, inside a shelving unit, or behind a bar.
    {
        id = "tv.screen.16x9",
