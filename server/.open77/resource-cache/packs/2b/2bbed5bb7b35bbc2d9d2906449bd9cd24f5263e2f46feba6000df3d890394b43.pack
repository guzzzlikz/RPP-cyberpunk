            right = { 1.0, 0.0, 0.0 },
            up = { 0.0, 0.0, 1.0 },
            width = 1.58,
            height = 0.66,
            -- Same cabinet as the 16:9 set (body Y -0.0514..+0.1255), same
            -- screen plane, same side: the picture faces +Y.
            faces = { 0.0, 1.0, 0.0 },
        },
    },
    {
        id = "tv.neokitsch.16x9",
