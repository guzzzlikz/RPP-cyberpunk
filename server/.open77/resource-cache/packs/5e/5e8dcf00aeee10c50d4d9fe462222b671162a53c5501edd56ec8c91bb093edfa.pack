-- Compact Open Stress Test watermark, top-centre inside CHROME_STRIP.
--
-- The page is a passive hud-layer surface: it is never focused, so it can
-- never swallow input, and the CSS disables pointer events entirely. Local
-- facts (runtime version, Lua version, resource generation) are read here;
-- the session identity is only ever what the server answered, so the overlay
-- shows the authoritative identity or OFFLINE â€” never a client-made value.

local page
local identity          -- last server-provided identity, nil while offline
local identityFresh = false

local function publish()
    if page == nil then return end
    page:send("watermark:state", {
        version = Open77.runtime.version(),
        luaVersion = Open77.runtime.luaVersion(),
        generation = Open77.resource.generation(),
        online = identity ~= nil,
        playerId = identity ~= nil and identity.playerId or nil,
        name = identity ~= nil and identity.name or nil,
        identifier = identity ~= nil and identity.identifier or nil,
    })
end

RegisterNetEvent("watermark:state", function(payload)
    if type(payload) ~= "table" then return end
    identity = payload
    identityFresh = true
    publish()
end)

AddEventHandler("onClientResourceStart", function(name)
    if name ~= GetCurrentResourceName() then return end

    local errorMessage
    page, errorMessage = WebUI.create({
        entry = "web/index.html",
        layer = "hud",
        width = 1920,
        height = 1080,
        fps = 10,
        zIndex = 900,
        transparent = true,
        visible = true,
    })
    if page == nil then
        print("[open77_watermark] WebUI failed: " .. tostring(errorMessage))
        return
    end

    page:on("watermark:ready", publish)

    -- Ask the server for the session identity: quickly until the first answer
    -- arrives, then slowly to follow reconnects. A send failure just means the
    -- session is not active yet â€” the overlay stays in OFFLINE mode.
    CreateThread(function()
        while true do
            identityFresh = false
            local accepted = TriggerServerEvent("watermark:ready")
            if not accepted then
                identity = nil
                publish()
            end
            Wait(identity ~= nil and 60000 or 5000)
            -- A session drop leaves the last identity on screen otherwise:
            -- when a slow-cycle refresh got no answer, fall back to OFFLINE.
            if identity ~= nil and not identityFresh then
                identity = nil
                publish()
            end
        end
    end)
end)

AddEventHandler("onClientResourceStop", function(name)
    if name ~= GetCurrentResourceName() then return end
    page = nil
    identity = nil
end)
resource "open77_watermark"
version "0.2.0"
open77_version ">=0.0.1"
auto_start true
reload_policy "local"

client_script "client/main.lua"
server_script "server/main.lua"

web_ui_page "web/index.html"
web_ui_auto_create false
web_files { "web/**" }

permissions {
    "local.events",
    "network.events"
}
/* Passive session signature. Keep the entire surface inside CHROME_STRIP
 * (the top 7%); MATCH_BAND belongs to the active gamemode. No continuous
 * animation, blur or full-width backing on this permanent 10-fps surface. */
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: transparent; pointer-events: none; user-select: none;
}
.watermark {
  --watermark-top: clamp(3px, .65vh, 8px);
  position: absolute; top: var(--watermark-top); left: 50%;
  transform: translateX(-50%);
  width: max-content; max-width: min(520px, calc(100vw - 24px));
  max-height: calc(7vh - var(--watermark-top)); overflow: hidden;
  padding: 5px 14px 6px;
  border: 1px solid rgba(211, 234, 242, .09); border-radius: 2px;
  background: linear-gradient(110deg, rgba(9, 17, 22, .88), rgba(9, 17, 22, .72));
  color: #c2cdd3;
  font: 10px / 14px var(--op77-font-mono, monospace);
  -webkit-font-smoothing: antialiased;
  animation: arrive 350ms ease-out both;
}
.brandline {
  display: flex; align-items: center; justify-content: center; gap: 13px;
  height: 19px; white-space: nowrap;
}
.logo-crop { display: block; flex: none; width: 108px; height: 17px; overflow: hidden; }
.logo-crop img { display: block; width: 108px; height: auto; transform: translateY(-9px); }
.release {
  display: inline-flex; align-items: center; gap: 7px;
  padding-left: 13px; border-left: 1px solid rgba(211, 234, 242, .18);
  color: #dce9ed;
  font: 600 10px / 15px var(--op77-font-body, sans-serif);
  letter-spacing: .095em; text-transform: uppercase;
}
.release i {
  width: 4px; height: 4px; flex: none; border-radius: 50%;
  background: #78868e; transition: background-color 250ms ease;
}
.watermark[data-online="true"] .release i { background: var(--op77-accent, #22d8e2); }
.telemetry {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  margin-top: 2px; min-width: 0; white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.player { display: flex; align-items: baseline; gap: 5px; min-width: 0; }
#player-name { max-width: 18ch; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.player-id { color: #8e9ea7; flex: none; }
.build, .session { display: flex; align-items: baseline; gap: 5px; }
.build { min-width: 0; }
.build::before, .session::before {
  content: ""; flex: none; width: 2px; height: 2px; border-radius: 50%;
  align-self: center; margin-right: 5px; background: #63727c;
}
#build-value { max-width: 15ch; overflow: hidden; text-overflow: ellipsis; }
.label { color: #8e9ea7; font-size: 9px; }
.session { flex: none; }
#session-value { color: #a6b7c0; }
.watermark[data-online="false"] #session-value { color: #8e9ea7; }
@keyframes arrive {
  from { opacity: 0; transform: translate(-50%, -3px); }
  to { opacity: 1; transform: translate(-50%, 0); }
}
@media (max-width: 600px) {
  .watermark { padding-inline: 10px; }
  .telemetry { gap: 7px; font-size: 9px; }
  .label { display: none; }
  #player-name { max-width: 12ch; }
  #build-value { max-width: 10ch; }
  .build::before, .session::before { margin-right: 2px; }
}
/* A short viewport needs a single row, not clipped session information. */
@media (max-height: 650px) {
  .watermark { display: flex; align-items: center; gap: 14px; max-width: calc(100vw - 24px); padding-block: 4px; }
  .telemetry { margin-top: 0; }
  .build { display: none; }
}
@media (max-height: 650px) and (max-width: 760px) {
  .logo-crop { display: none; }
  .release { padding-left: 0; border-left: 0; font-size: 9px; letter-spacing: .04em; }
  .brandline { flex: none; }
  .session .label { display: none; }
  #player-name { max-width: 8ch; }
}
@media (prefers-reduced-motion: reduce) {
  .watermark { animation: none; }
  .release i { transition: none; }
}
(() => {
  "use strict";

  const watermark = document.getElementById("watermark");
  const build = document.getElementById("build-value");
  const playerName = document.getElementById("player-name");
  const playerId = document.getElementById("player-id");
  const sessionValue = document.getElementById("session-value");

  const text = value => String(value == null ? "" : value);

  // Keep screenshot correlation, without exposing the complete identifier.
  const shortId = value => {
    const id = text(value);
    return id.length > 12 ? id.slice(0, 8) + "â€¦" + id.slice(-4) : id;
  };

  function render(payload) {
    if (!payload || typeof payload !== "object") return;

    build.textContent = text(payload.version) || "â€”";
    watermark.dataset.online = payload.online === true ? "true" : "false";

    if (payload.online === true) {
      const name = text(payload.name) || "unknown";
      const id = text(payload.playerId) || "?";
      playerName.textContent = name;
      playerId.textContent = `#${id}`;
      sessionValue.textContent = shortId(payload.identifier) || "pending";
    } else {
      playerName.textContent = "Not connected";
      playerId.textContent = "";
      sessionValue.textContent = "OFFLINE";
    }
  }

  Open77.on("watermark:state", render);
  Open77.ready();
  Open77.emit("watermark:ready", {});
})();
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Open//77 â€” Watermark</title>
  <link rel="stylesheet" href="open77-ui.css">
  <link rel="stylesheet" href="app.css">
</head>
<body>
  <section class="watermark" id="watermark" aria-label="Open77 session" data-online="false">
    <div class="brandline">
      <span class="logo-crop"><img src="open77.png" alt="Open//77"></span>
      <span class="release"><i aria-hidden="true"></i> Open Stress Test</span>
    </div>
    <div class="telemetry">
      <span class="player"><span id="player-name">Not connected</span><span class="player-id" id="player-id"></span></span>
      <span class="build"><span class="label">Build</span> <span id="build-value">â€”</span></span>
      <span class="session"><span class="label">Session</span> <span id="session-value">OFFLINE</span></span>
    </div>
  </section>
  <script src="app.js"></script>
</body>
</html>
