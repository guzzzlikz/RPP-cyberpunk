local page
local pageReady = false
local visible = true
local visibilityRevision = 0
local configured = false
local cycleKey = "F11"
local modes = {}
local modeByName = {}
local current = { mode = "normal", label = "NORMAL", distance = 20.0, color = "#22D8E2" }
local errorText = ""
local errorUntil = 0
local lastPayload = ""

local function acceptModes(payload)
    if type(payload.modes) ~= "table" or #payload.modes < 1 or #payload.modes > 8 then
        return false
    end
    local parsed, byName = {}, {}
    for index, candidate in ipairs(payload.modes) do
        if type(candidate) ~= "table" then return false end
        local name = tostring(candidate.name or "")
        local distance = tonumber(candidate.distance)
        if #name < 1 or #name > 24 or not distance or distance < 0.5 or distance > 1000 then
            return false
        end
        parsed[index] = {
            name = name,
            label = tostring(candidate.label or name):sub(1, 32),
            distance = distance,
            color = tostring(candidate.color or "#22D8E2"),
        }
        byName[name] = parsed[index]
    end
    modes, modeByName = parsed, byName
    cycleKey = tostring(payload.cycleKey or "F11"):upper()
    configured = true
    return true
end

local function publish(status)
    if not page or not pageReady then return end
    status = status or {}
    local now = Open77.time.monotonic()
    if errorText ~= "" and now >= errorUntil then errorText = "" end
    local mode = modeByName[current.mode] or current
    local modeIndex = 1
    for index, candidate in ipairs(modes) do
        if candidate.name == current.mode then
            modeIndex = index
            break
        end
    end
    local modeCount = math.max(1, #modes)
    local inputLevel = tonumber(status.inputLevel or status.microphoneActivity) or 0
    inputLevel = math.max(0, math.min(1, inputLevel))
    -- Two decimals are enough for a twelve-segment HUD meter and avoid
    -- updating the document for inaudible native capture noise.
    inputLevel = math.floor(inputLevel * 100 + 0.5) / 100
    local available = status.available == true
    local captureEnabled = status.captureEnabled == true
    local transmitting = status.transmitting == true
    local microphoneDetected = status.localTalking == true
    local state = "idle"
    if not configured or not available then
        state = "offline"
    elseif not captureEnabled then
        state = "muted"
    elseif transmitting then
        state = "talking"
    elseif microphoneDetected or inputLevel > 0.025 then
        state = "detected"
    end
    -- Send the level the twelve-segment meter can actually display. Keep the
    -- state decision above at its original threshold (voice activity is not
    -- quantized); sub-segment capture noise needs no document update.
    inputLevel = math.floor(inputLevel * 12 + 0.5) / 12
    local payload = {
        visible = visible,
        configured = configured,
        mode = tostring(mode.label or mode.name or "VOICE"),
        modeName = tostring(mode.name or current.mode or "normal"),
        distance = tonumber(current.distance or mode.distance) or 0,
        color = tostring(current.color or mode.color or "#22D8E2"),
        key = cycleKey,
        modeIndex = modeIndex,
        modeCount = modeCount,
        modes = modes,
        reachPercent = math.floor((modeIndex / modeCount) * 100 + 0.5),
        state = state,
        available = available,
        microphoneDetected = microphoneDetected,
        transmitting = transmitting,
        captureEnabled = captureEnabled,
        inputLevel = inputLevel,
        activation = status.voiceActivation == true and "vad" or "ptt",
        activeTalkers = math.max(0, tonumber(status.activeTalkers) or 0),
        captureState = tostring(status.captureState or "unavailable"),
        error = errorText,
    }
    local encoded = Open77.json.encode(payload) or ""
    if encoded == lastPayload then return end
    lastPayload = encoded
    page:send("open-voice:update", payload)
end

RegisterNetEvent("open-voice:state", function(payload)
    if type(payload) ~= "table" then return end
    if payload.modes and not acceptModes(payload) then
        errorText = "INVALID SERVER VOICE CONFIG"
        errorUntil = Open77.time.monotonic() + 5.0
        return
    end
    local mode = modeByName[tostring(payload.mode or "")]
    if mode then
        current = {
            mode = mode.name,
            label = tostring(payload.label or mode.label),
            distance = tonumber(payload.distance) or mode.distance,
            color = tostring(payload.color or mode.color),
        }
        TriggerEvent("open-voice:modeChanged", current.mode, current.distance,
            current.label, current.color)
    end
    publish(Open77.voice.status() or {})
end)

local function setHudVisible(value)
    visibilityRevision = visibilityRevision + 1
    local revision = visibilityRevision
    visible = value == true
    if page and visible then page:show() end
    lastPayload = ""
    publish(Open77.voice.status() or {})
    if not visible and page then
        local target = page
        CreateThread(function()
            Wait(260) -- Let the 250 ms fade finish before hiding the document.
            if page == target and not visible and revision == visibilityRevision then target:hide() end
        end)
    end
end
AddEventHandler("open-voice:setHudVisible", setHudVisible)

RegisterNetEvent("open-voice:error", function(reason)
    errorText = tostring(reason or "VOICE REQUEST REJECTED"):upper():sub(1, 80)
    errorUntil = Open77.time.monotonic() + 3.5
    publish(Open77.voice.status() or {})
end)

local function requestCycle()
    if not configured then return false, "voice_modes_not_ready" end
    local sent, reason = TriggerServerEvent("open-voice:cycle")
    if sent ~= true then
        errorText = tostring(reason or "cycle_request_failed"):upper():sub(1, 80)
        errorUntil = Open77.time.monotonic() + 3.5
        publish(Open77.voice.status() or {})
        return false, reason
    end
    return true
end

AddEventHandler("open-voice:cycle", function()
    requestCycle()
end)

AddEventHandler("onClientResourceStart", function(name)
    if name ~= GetCurrentResourceName() then return end
    local reason
    -- The HUD is a NativeUI document (client/ui.lua, ui/voice.rml) drawn by the
    -- game's renderer; it speaks the same page API the WebUI page did.
    page, reason = OpenVoiceHud.create()
    if not page then
        print("[open-voice] HUD unavailable: " .. tostring(reason))
    else
        page:on("open-voice:ready", function()
            pageReady = true
            lastPayload = ""
            publish(Open77.voice.status() or {})
        end)
    end

    CreateThread(function()
        while true do
            local sent, sendReason = TriggerServerEvent("open-voice:ready")
            if sent ~= true then
                errorText = tostring(sendReason or "VOICE SERVER NOT READY"):upper():sub(1, 80)
                errorUntil = Open77.time.monotonic() + 2.5
            end
            if configured then return end
            Wait(2000)
        end
    end)

    CreateThread(function()
        local wasDown = false
        while true do
            local down = false
            if configured and not Open77.input.isCaptured() then
                down = Open77.input.isDown(cycleKey) == true
            end
            if down and not wasDown then requestCycle() end
            wasDown = down
            Wait(10)
        end
    end)

    CreateThread(function()
        while true do
            if visible then
                local status = Open77.voice.status()
                if status then publish(status) end
            end
            Wait(50)
        end
    end)
end)

AddEventHandler("onClientResourceStop", function(name)
    if name ~= GetCurrentResourceName() then return end
    if page then page:destroy() end
    page, pageReady = nil, false
end)

exports("getState", function()
    return {
        configured = configured,
        mode = current.mode,
        label = current.label,
        distance = current.distance,
        color = current.color,
        cycleKey = cycleKey,
        visible = visible,
    }
end)
exports("getModes", function()
    local result = {}
    for index, mode in ipairs(modes) do
        result[index] = {
            name = mode.name, label = mode.label,
            distance = mode.distance, color = mode.color,
        }
    end
    return result
end)
exports("requestCycle", requestCycle)
exports("setHudVisible", function(value)
    setHudVisible(value)
    return true
end)
-- The voice HUD on NativeUI (ui/voice.rml): one compact line in the bottom-right
-- corner. client/main.lua builds the payload and talks to this module as it
-- talked to the old WebUI page: page:on("open-voice:ready", fn),
-- page:send("open-voice:update", payload), page:show(), page:hide().
-- Presentation only: every decision (state, reach, errors) stays in main.lua and
-- on the server. Only the values that changed reach the document.
OpenVoiceHud = {}
local V = OpenVoiceHud

local STATES = { idle = true, detected = true, talking = true, muted = true, offline = true }
local STATE_LABELS = {
    idle = "Listening",
    detected = "Signal detected",
    talking = "Transmitting",
    muted = "Mic disabled",
    offline = "Voice offline",
}
local SEGMENTS = 12
local PIPS = 8 -- the server allows up to 8 presets; the document keeps 8 slots (no row is ever removed)

local function clamp(v, a, b) return v < a and a or (v > b and b or v) end
local function bounded(v, max) return tostring(v == nil and "" or v):sub(1, max) end

function V.safeColor(value)
    local text = tostring(value or "")
    return text:match("^#%x%x%x%x%x%x$") and text or "#22D8E2"
end

function V.formatDistance(value)
    local metres = math.max(0, tonumber(value) or 0)
    if metres > 0 and metres < 10 and metres ~= math.floor(metres) then
        return ("%.1f"):format(metres)
    end
    return tostring(math.floor(metres + 0.5))
end

function V.resolveState(p, level)
    local supplied = bounded(p.state, 16):lower()
    if STATES[supplied] then return supplied end
    if p.configured ~= true or p.available == false then return "offline" end
    if p.captureEnabled ~= true then return "muted" end
    if p.transmitting == true then return "talking" end
    if p.microphoneDetected == true or level > 0.025 then return "detected" end
    return "idle"
end

--- The document's model from the payload client/main.lua publishes.
function V.model(p)
    p = type(p) == "table" and p or {}
    local level = clamp(tonumber(p.inputLevel) or 0, 0, 1)
    local state = V.resolveState(p, level)
    local heard = math.max(0, math.floor((tonumber(p.activeTalkers) or 0) + 0.5))
    local count = clamp(math.floor(tonumber(p.modeCount) or 1), 1, PIPS)
    local index = clamp(math.floor(tonumber(p.modeIndex) or 1), 1, count)
    local pips = {}
    for i = 1, PIPS do pips[i] = { used = i <= count, on = i <= index } end
    local err = bounded(p.error, 80)
    local enabled = state ~= "muted" and state ~= "offline"
    return {
        ready = true,
        visible = p.visible ~= false,
        state = state,
        stateLabel = STATE_LABELS[state],
        activation = p.activation == "vad" and "VAD" or "PTT",
        lit = enabled and math.floor(level * SEGMENTS + 0.5) or 0,
        label = bounded(p.mode or p.modeName or "Voice", 24):upper(),
        modeName = bounded(p.modeName or p.mode or "normal", 24):lower(),
        distance = V.formatDistance(p.distance),
        color = V.safeColor(p.color),
        key = bounded(p.key or "F11", 12):upper(),
        pips = pips,
        heard = heard,
        error = err,
        hasError = #err > 0,
    }
end

local function same(a, b)
    if type(a) ~= type(b) then return false end
    if type(a) ~= "table" then return a == b end
    for k, x in pairs(a) do if not same(x, b[k]) then return false end end
    for k in pairs(b) do if a[k] == nil then return false end end
    return true
end
V.same = same

local function defaults()
    local pips = {}
    for i = 1, PIPS do pips[i] = { used = i <= 3, on = i <= 2 } end
    return {
        ready = false, shown = false, visible = true, state = "offline", stateLabel = STATE_LABELS.offline,
        activation = "PTT", lit = 0, label = "NORMAL", modeName = "normal", distance = "20", color = "#22D8E2",
        key = "F11", pips = pips, heard = 0, error = "", hasError = false,
    }
end

-- The line drifts a little against the camera's turns, like the HUD wings above it.
local FLOAT = { stiffness = 7, trail = 0.08, trailMax = 18, turn = 0.02, turnMax = 3, breath = { 0.8, 1.6 } }
V.FLOAT = FLOAT

local function cameraYawPitch()
    if type(Open77.camera) ~= "table" or type(Open77.camera.view) ~= "function" then return nil end
    local ok, v = pcall(Open77.camera.view)
    local f = ok and type(v) == "table" and v.forward
    if type(f) ~= "table" or (math.abs(f.x or 0) + math.abs(f.y or 0)) < 1e-4 then return nil end
    return math.deg(math.atan(-f.x, f.y)), math.deg(math.asin(clamp(f.z or 0, -1, 1)))
end

--- A surface with the page API client/main.lua uses: on, send, show, hide, destroy.
function V.create()
    if type(Open77.ui) ~= "table" or type(Open77.ui.create) ~= "function" then return nil, "nativeui_unavailable" end
    local ui, why = Open77.ui.create({
        document = "ui/voice.rml", layer = "hud", zIndex = 12, visible = true,
        models = { voice = defaults() },
    })
    if not ui then return nil, why end

    local page = { handlers = {} }
    local shown = nil      -- the model the document holds
    local wanted = true    -- show()/hide() from main.lua
    local covered = false  -- another interface holds the cursor
    local alive = true

    local function setShown()
        local value = wanted and not covered and (shown == nil or shown.visible ~= false)
        ui:set("voice", "shown", value)
    end

    local function ready()
        shown = nil
        local fn = page.handlers["open-voice:ready"]
        if fn then fn() end
    end
    ui:onEvent("loaded", ready)
    ui:onEvent("reloaded", ready)
    ui:onEvent("error", function(name, detail)
        print("[open-voice] HUD " .. tostring(name) .. ": " .. tostring(detail and detail.message))
    end)

    function page.on(_, name, fn) page.handlers[name] = fn end
    function page.show() wanted = true; ui:show(); setShown() end
    function page.hide() wanted = false; setShown(); ui:hide() end

    function page.send(_, name, payload)
        if name ~= "open-voice:update" then return end
        local m = V.model(payload)
        local changed = {}
        for k, v in pairs(m) do
            if not shown or not same(shown[k], v) then changed[k] = v end
        end
        if not next(changed) then return end
        local modeChanged = shown and shown.modeName ~= m.modeName
        local errorRaised = m.hasError and (not shown or shown.error ~= m.error)
        ui:merge("voice", changed)
        shown = m
        if changed.visible ~= nil then setShown() end
        -- a new range: the label and the distance drop in, the rule flashes, the pips pop
        if modeChanged then
            ui:animate("#range-label, #range-reach", { from = { opacity = 0, y = -9 }, to = { opacity = 1, y = 0 },
                spring = { duration = 0.42, bounce = 0.32 }, stagger = 0.05 })
            ui:animate("#rule", { from = { scaleY = 1.7 }, to = { scaleY = 1 }, spring = { duration = 0.45, bounce = 0.4 } })
            ui:animate("#pips", { from = { scale = 1.35 }, to = { scale = 1 }, spring = { duration = 0.4, bounce = 0.45 } })
        end
        if errorRaised then
            ui:animate("#error", { from = { x = 18 }, to = { x = 0 }, spring = { duration = 0.35, bounce = 0.35 } })
        end
    end

    -- another interface holds the cursor (pause menu, inventory, phone): step aside
    CreateThread(function()
        while alive do
            Wait(150)
            local busy = false
            if type(Open77.input) == "table" and type(Open77.input.isCaptured) == "function" then
                local ok, _, cursor = pcall(Open77.input.isCaptured)
                busy = ok and cursor == true
            end
            if busy ~= covered then
                covered = busy
                setShown()
            end
        end
    end)

    -- the float: one projection per frame at most, only when it moved
    CreateThread(function()
        local cfg = FLOAT
        local yaw0, pitch0, at0 = nil, nil, GetGameTimer()
        local sx, sy, ry = 0, 0, 0
        local sent = nil
        local phase = math.random() * 6.28
        while alive do
            Wait(0)
            local at = GetGameTimer()
            local dt = math.max(0.001, math.min(0.1, (at - at0) / 1000))
            at0 = at
            if wanted and not covered then
                local yaw, pitch = cameraYawPitch()
                local yawVel, pitchVel = 0, 0
                if yaw and yaw0 then
                    yawVel = ((yaw - yaw0 + 540) % 360 - 180) / dt
                    pitchVel = (pitch - pitch0) / dt
                end
                yaw0, pitch0 = yaw, pitch
                local k = 1 - math.exp(-dt * cfg.stiffness)
                sx = sx + (clamp(yawVel * cfg.trail, -cfg.trailMax, cfg.trailMax) - sx) * k
                sy = sy + (clamp(-pitchVel * cfg.trail * 0.7, -cfg.trailMax * 0.7, cfg.trailMax * 0.7) - sy) * k
                ry = ry + (clamp(-yawVel * cfg.turn, -cfg.turnMax, cfg.turnMax) - ry) * k
                local fy = math.sin(at / 1000 * cfg.breath[1] * 6.2832 / 6 + phase) * cfg.breath[2]
                local spec = {
                    rotateY = math.floor(ry * 100 + 0.5) / 100,
                    offset = { math.floor(sx * 10 + 0.5) / 10, math.floor((sy + fy) * 10 + 0.5) / 10, 0 },
                    perspective = 1600, origin = { 0.9, 0.9 },
                }
                local key = ("%.2f %.1f %.1f"):format(spec.rotateY, spec.offset[1], spec.offset[2])
                if key ~= sent then
                    sent = key
                    ui:projection(spec)
                end
            else
                yaw0 = nil
            end
        end
    end)

    function page.destroy()
        alive = false
        pcall(ui.destroy, ui)
    end
    return page
end
resource "open-voice"
version "0.3.0"
open77_version ">=0.0.1"
auto_start true
reload_policy "reconnect"

dependency "open77_voice >=0.2.0"

server_scripts {
    "server/config.lua",
    "server/main.lua",
}
client_script "client/ui.lua"
client_script "client/main.lua"

-- the HUD is a NativeUI document
files { "ui/voice.rml", "ui/voice.rcss" }

-- open77_voice remains the sole PTT/VAD/audio driver. This companion owns
-- only server-authoritative reach presets, its F11 request edge, and HUD.
permissions { "voice.manage", "voice.client", "input.actions", "network.events" }
/* Open//77 voice HUD on NativeUI: one compact line in the bottom-right corner, no
   panel, legible on any scene through text shadows and dark segment wells.
   State colours: idle grey, detected cyan, talking mint, muted red, offline dim.
   The range colour comes from the server (data-style bindings).
   1 dp = 1 px of the 1080p reference. */

body { pointer-events: none; font-family: "Chakra Petch"; font-weight: bold; color: #e6eaec; }
.grow { flex: 1 1 auto; }

/* one eye at the centre of the screen: the line is turned toward it, like the HUD wings */
#stage { position: absolute; left: 0; top: 0; right: 0; bottom: 0; perspective: 1500dp; perspective-origin: 50% 88%; }

#voice
{
    position: absolute; right: 34dp; bottom: 30dp;
    display: flex; flex-direction: column; align-items: flex-end;
    opacity: 0;
    transform: rotateY(-72deg);
    transform-origin: 100% 100%;
    transition: transform 0.7s back-out, opacity 0.25s cubic-out;
}
/* ready = the first payload arrived; shown = visible and no menu holds the cursor */
#voice.ready { transform: rotateY(-18deg); }
#voice.ready.shown { opacity: 1; }
#voice.offline { color: #8a94a2; }

/* ---- error: a red strip above the line ---------------------------------------- */
#error
{
    display: flex; flex-direction: row; align-items: center;
    height: 20dp; margin-bottom: 6dp;
    opacity: 0; transform: translateX(16dp);
    transition: opacity 0.18s cubic-out, transform 0.3s back-out;
}
#error.on { opacity: 1; transform: translateX(0dp); }
.err-tag { height: 16dp; padding: 0 6dp; margin-right: 8dp; background-color: #ff3b4e; transform: skewX(-14deg); filter: glow(6dp #ff3b4e 0.9); }
.err-tag span { font-size: 11dp; line-height: 16dp; color: #1a0306; }
.err-text { font-size: 11dp; letter-spacing: 0.12em; color: #ff8a96; white-space: nowrap; font-effect: shadow(0dp 1dp #000000); }

/* ---- status row ----------------------------------------------------------------- */
/* content-sized rows only: a percentage width inside the absolute, shrink-to-fit #voice resolves against the screen */
#status { display: flex; flex-direction: row; align-items: center; align-self: flex-start; height: 14dp; margin-bottom: 5dp; }
.st-dot { width: 5dp; height: 5dp; margin-right: 7dp; background-color: #8a94a2; transform: rotate(45deg); flex-shrink: 0; transition: background-color 0.12s linear-in-out; }
.st-label { font-size: 10dp; letter-spacing: 0.22em; text-transform: uppercase; color: #a3adb9; white-space: nowrap; font-effect: shadow(0dp 1dp #000000); transition: color 0.12s linear-in-out; }
.st-mode { margin-left: 8dp; font-family: "Roboto Mono"; font-size: 10dp; color: #5a6472; white-space: nowrap; font-effect: shadow(0dp 1dp #000000); }
#voice.detected .st-dot { background-color: #22d8e2; }
#voice.detected .st-label { color: #4ee6ee; }
#voice.talking .st-dot { background-color: #2be58b; filter: glow(5dp #2be58b 1); }
#voice.talking .st-label { color: #2be58b; }
#voice.muted .st-dot { background-color: #ff3b4e; }
#voice.muted .st-label { color: #ff6b7a; }
#voice.offline .st-dot { background-color: #4c5563; }
#voice.offline .st-label { color: #5a6472; }

/* heard: a beating dot and a count, only while someone is heard */
#heard { display: flex; flex-direction: row; align-items: center; margin-left: 12dp; opacity: 0; transform: translateX(10dp); transition: opacity 0.2s cubic-out, transform 0.35s back-out; }
#heard.on { opacity: 1; transform: translateX(0dp); }
.hd-dot { width: 6dp; height: 6dp; margin-right: 6dp; border-radius: 3dp; background-color: #2be58b; filter: glow(5dp #2be58b 1); flex-shrink: 0; }
#heard.on .hd-dot { animation: 1.1s sine-in-out infinite vo-beat; }
@keyframes vo-beat { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.7); } 100% { opacity: 1; transform: scale(1); } }
.hd-count { font-size: 12dp; color: #f7f9fb; font-effect: shadow(0dp 1dp #000000); }
.hd-label { margin-left: 5dp; font-size: 10dp; letter-spacing: 0.22em; color: #8a94a2; white-space: nowrap; font-effect: shadow(0dp 1dp #000000); }

/* ---- the line -------------------------------------------------------------------- */
#line { display: flex; flex-direction: row; align-items: center; height: 34dp; }

/* mic: a skewed badge tinted by the state; talking fills it and sends rings out */
#mic { position: relative; width: 34dp; height: 30dp; margin-right: 10dp; flex-shrink: 0; }
.mic-badge
{
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    display: flex; flex-direction: row; align-items: center; justify-content: center;
    background-color: #0b0e1499;
    border-width: 1dp; border-color: #8a94a266;
    transform: skewX(-14deg);
    transition: background-color 0.12s linear-in-out, border-color 0.12s linear-in-out;
}
.mic-glyph, .mic-slash
{
    position: absolute; left: 7dp; top: 3dp; width: 22dp; height: 22dp;
    transform: skewX(14deg);
    stroke: #a3adb9; stroke-width: 1.8dp; stroke-linecap: round; stroke-linejoin: round; fill: transparent;
    transition: stroke 0.12s linear-in-out;
}
.mic-slash { stroke: #ff3b4e; stroke-width: 2.2dp; visibility: hidden; }
.mic-ring
{
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    border-width: 1dp; border-color: #2be58b;
    transform: skewX(-14deg);
    opacity: 0;
}
#voice.detected .mic-badge { border-color: #22d8e2aa; background-color: #22d8e21f; }
#voice.detected .mic-glyph { stroke: #4ee6ee; }
#voice.talking .mic-badge { border-color: #2be58b; background-color: #2be58b; filter: glow(9dp #2be58b 0.9); }
#voice.talking .mic-glyph { stroke: #04261a; }
#voice.talking .mic-ring { animation: 1.2s cubic-out infinite vo-ring; }
@keyframes vo-ring { 0% { opacity: 0.85; transform: skewX(-14deg) scale(1); } 100% { opacity: 0; transform: skewX(-14deg) scale(1.55); } }
#voice.muted .mic-badge { border-color: #ff3b4eaa; background-color: #ff3b4e1f; }
#voice.muted .mic-glyph { stroke: #ff6b7a; }
#voice.muted .mic-slash, #voice.offline .mic-slash { visibility: visible; }
#voice.offline .mic-badge { border-color: #4c556366; background-color: #0b0e1466; }
#voice.offline .mic-glyph { stroke: #4c5563; }
#voice.offline .mic-slash { stroke: #4c5563; }

/* input meter: twelve skewed segments in dark wells, the last two hot, the very last red */
#meter { display: flex; flex-direction: row; align-items: flex-end; height: 18dp; margin-right: 12dp; flex-shrink: 0; transform: skewX(-14deg); }
.seg { display: block; width: 5dp; height: 18dp; margin-right: 2dp; background-color: #0b0e1480; border-bottom-width: 1dp; border-bottom-color: #e6eaec33; flex-shrink: 0; }
.seg.lit { background-color: #4ee6ee; border-bottom-color: #4ee6ee; }
.seg.hot.lit { background-color: #ffb020; border-bottom-color: #ffb020; }
.seg.peak.lit { background-color: #ff3b4e; border-bottom-color: #ff3b4e; }
#voice.talking .seg.lit { background-color: #2be58b; border-bottom-color: #2be58b; }
#voice.talking .seg.hot.lit { background-color: #ffb020; border-bottom-color: #ffb020; }
#voice.talking .seg.peak.lit { background-color: #ff3b4e; border-bottom-color: #ff3b4e; }
#voice.muted #meter, #voice.offline #meter { opacity: 0.4; }

/* the range: label in its colour, distance, and one pip per preset up to the active one */
#rule { width: 2dp; height: 26dp; margin-right: 10dp; flex-shrink: 0; transform: skewX(-14deg); background-color: #22d8e2; }
#range { display: flex; flex-direction: column; justify-content: center; margin-right: 12dp; }
#range-label { font-size: 12dp; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap; color: #22d8e2; font-effect: shadow(0dp 1dp #000000); }
#range-reach { display: flex; flex-direction: row; align-items: flex-end; height: 18dp; }
#range-dist { font-size: 18dp; line-height: 18dp; color: #f7f9fb; white-space: nowrap; font-effect: shadow(0dp 1dp #000000); }
.range-unit { margin-left: 2dp; margin-right: 9dp; font-size: 10dp; line-height: 15dp; color: #8a94a2; font-effect: shadow(0dp 1dp #000000); }
#pips { display: flex; flex-direction: row; align-items: center; height: 15dp; transform: skewX(-14deg); }
.pip { display: none; width: 9dp; height: 4dp; margin-right: 3dp; flex-shrink: 0; }
.pip.used { display: block; }
#voice.offline #rule, #voice.offline #pips, #voice.offline #range-label { opacity: 0.45; }

/* the key that cycles the range, as a keycap */
#key
{
    height: 20dp; padding: 0 6dp; flex-shrink: 0;
    background-color: #0b0e1499;
    border-width: 1dp; border-color: #e6eaec40; border-bottom-width: 2dp;
}
#key span { font-family: "Roboto Mono"; font-size: 10dp; line-height: 17dp; color: #c4ccd6; white-space: nowrap; }

#base { position: absolute; left: 0; right: 0; bottom: -6dp; height: 1dp; opacity: 0.35; background-color: #22d8e2; }
#voice.offline #base { opacity: 0.12; }
<rml>
<head>
    <title>Open//77 Voice</title>
    <link type="text/rcss" href="nui://open77/open77.rcss"/>
    <link type="text/rcss" href="voice.rcss"/>
</head>
<!-- The voice line, bottom-right, straight on the game (no panel). Everything is
     bound to one data model, "voice", that client/ui.lua fills from the payload
     client/main.lua builds; nothing is decided here. -->
<body data-model="voice">
<div id="stage">
<div id="voice" data-class-ready="ready" data-class-shown="shown"
     data-class-idle="state == 'idle'" data-class-detected="state == 'detected'"
     data-class-talking="state == 'talking'" data-class-muted="state == 'muted'"
     data-class-offline="state == 'offline'">

    <!-- a rejected request, for a few seconds -->
    <div id="error" data-class-on="hasError">
        <div class="err-tag"><span>!</span></div>
        <span class="err-text">{{error}}</span>
    </div>

    <!-- status: what the microphone is doing, and who is heard -->
    <div id="status">
        <span class="st-dot"></span>
        <span class="st-label">{{stateLabel}}</span>
        <span class="st-mode">{{activation}}</span>
        <div id="heard" data-class-on="heard > 0">
            <span class="hd-dot"></span>
            <span class="hd-count">{{heard}}</span>
            <span class="hd-label">HEARD</span>
        </div>
    </div>

    <!-- the line: mic, input meter, range, cycle key -->
    <div id="line">
        <div id="mic">
            <div class="mic-ring"></div>
            <div class="mic-badge">
                <path class="mic-glyph" view-box="0 0 24 24"
                      d="M12 15.25a3.75 3.75 0 0 0 3.75-3.75V6.25a3.75 3.75 0 1 0-7.5 0v5.25A3.75 3.75 0 0 0 12 15.25Z M5.75 10.75v.75a6.25 6.25 0 0 0 12.5 0v-.75 M12 17.75v3.5 M8.75 21.25h6.5"/>
                <path class="mic-slash" view-box="0 0 24 24" d="M4 3.5L20 20.5"/>
            </div>
        </div>

        <div id="meter">
            <span class="seg" data-class-lit="lit > 0"></span>
            <span class="seg" data-class-lit="lit > 1"></span>
            <span class="seg" data-class-lit="lit > 2"></span>
            <span class="seg" data-class-lit="lit > 3"></span>
            <span class="seg" data-class-lit="lit > 4"></span>
            <span class="seg" data-class-lit="lit > 5"></span>
            <span class="seg" data-class-lit="lit > 6"></span>
            <span class="seg" data-class-lit="lit > 7"></span>
            <span class="seg" data-class-lit="lit > 8"></span>
            <span class="seg" data-class-lit="lit > 9"></span>
            <span class="seg hot" data-class-lit="lit > 10"></span>
            <span class="seg hot peak" data-class-lit="lit > 11"></span>
        </div>

        <div id="rule" data-style-background-color="color"></div>

        <div id="range">
            <span id="range-label" data-style-color="color">{{label}}</span>
            <div id="range-reach">
                <span id="range-dist">{{distance}}</span>
                <span class="range-unit">M</span>
                <div id="pips">
                    <span class="pip" data-for="p : pips" data-class-used="p.used" data-class-on="p.on"
                          data-style-background-color="p.on ? color : '#e6eaec26'"></span>
                </div>
            </div>
        </div>

        <div id="key"><span>{{key}}</span></div>
    </div>

    <!-- a hairline in the range colour under the whole line -->
    <div id="base" data-style-background-color="color"></div>
</div>
</div>
</body>
</rml>
