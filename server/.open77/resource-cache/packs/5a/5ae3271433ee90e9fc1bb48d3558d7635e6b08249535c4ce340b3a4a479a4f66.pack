            "kitchen.counter", "kitchen.fridge", "kitchen.fridge.poor", "kitchen.stove",
            "kitchen.coffee_machine",
            "bathroom.toilet", "bathroom.shower", "bathroom.mirror",
            "crate.small", "crate.valuable", "crate.delivery", "crate.delivery.tall",
