* { box-sizing: border-box; }
html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: transparent; }
.noclip-hud { position: fixed; bottom: 32px; left: 50%; transform: translateX(-50%); width: min(370px, calc(100vw - 32px)); box-sizing: border-box; padding: 12px 16px; background: var(--op77-panel); border: 1px solid var(--op77-line-hud); border-top: 2px solid var(--op77-accent); animation: noclip-enter 160ms ease-out; }
.noclip-hud[hidden] { display: none; }
.noclip-hud header { display: flex; justify-content: space-between; color: var(--op77-accent); font: 600 10px var(--op77-font-mono); letter-spacing: .1em; }
.noclip-speed { display: flex; align-items: baseline; gap: 8px; padding: 5px 0; font-variant-numeric: tabular-nums; }
.noclip-speed strong { font: 700 30px var(--op77-font-display); color: var(--op77-text); }
.noclip-speed span, .noclip-speed small { color: var(--op77-text-dim); font: 11px var(--op77-font-mono); }
.noclip-speed small { margin-left: auto; }
.noclip-controls { display: flex; justify-content: space-between; gap: 8px; color: var(--op77-text-dim); font-size: 10px; line-height: 1.9; }
.noclip-controls b { color: var(--op77-text); font: 500 9px var(--op77-font-mono); }
.noclip-hud.paused { border-top-color: var(--op77-text-dim); }
.noclip-hud.paused header { color: var(--op77-text-dim); }
@keyframes noclip-enter { from { opacity: 0; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .noclip-hud { animation: none; } }
body { color: var(--admin-text); font-family: var(--op77-font-body); pointer-events: none; user-select: none; }
[hidden] { display: none !important; }
.strip, .input-panel { position: fixed; right: 32px; top: 32vh; width: min(380px, calc(100vw - 64px)); background: var(--admin-panel); border: 1px solid var(--admin-line); clip-path: polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px)); }
.strip { max-height: calc(68vh - 128px); display: flex; flex-direction: column; opacity: 0; transform: translateX(12px); overflow: hidden; transition: opacity 140ms var(--admin-ease), transform 220ms var(--admin-ease); }
body.open .strip { opacity: 1; transform: none; }
body.typing .strip { opacity: 0; }
.head { height: 54px; flex: none; display: flex; align-items: center; gap: 16px; padding: 12px 16px; border-bottom: 2px solid var(--admin-accent); }
.mark { width: 108px; height: 25px; object-fit: contain; flex: none; }
.title { min-width: 0; flex: 1; font: 800 19px/1.1 var(--op77-font-display); text-transform: uppercase; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.session { height: 25px; padding: 7px 16px 0; display: flex; justify-content: space-between; gap: 8px; flex: none; font: 500 9px/1.3 var(--op77-font-mono); letter-spacing: .12em; color: #3d7f85; }
#roles { color: var(--admin-muted); max-width: 58%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-transform: uppercase; }
.trail { margin: 0; height: 25px; padding: 5px 16px; flex: none; color: var(--admin-muted); font: 500 10px/1.4 var(--op77-font-mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-transform: uppercase; }
.list { list-style: none; margin: 0; padding: 0; flex: none; }
.row { height: 30px; display: flex; align-items: center; gap: 8px; padding: 0 16px; border-bottom: 1px solid var(--admin-line); color: #bcc4ce; font-size: 13px; }
.row .label { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.row .value { max-width: 57%; flex: 0 1 auto; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--admin-muted); font: 500 10px/1.2 var(--op77-font-mono); }
.row .arrow { width: 8px; flex: none; font: 600 12px/1 var(--op77-font-mono); }
.row.on { background: rgba(34,216,226,.13); color: var(--admin-accent); box-shadow: inset 0 -1px var(--admin-accent); }
.row.on .value { color: var(--admin-accent); }
.row.disabled { opacity: .4; }
.more { height: 20px; margin: 0; padding: 3px 16px; flex: none; text-align: right; font: 400 10px/1.4 var(--op77-font-mono); color: var(--admin-muted); }
.detail { height: 34px; margin: 0; padding: 2px 16px; flex: none; color: var(--admin-muted); font-size: 11px; line-height: 15px; overflow: hidden; overflow-wrap: anywhere; }
.status { height: 22px; margin: 0; padding: 3px 16px; flex: none; font: 400 10px/1.4 var(--op77-font-mono); color: #41dba3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.status.bad { color: var(--admin-danger); }
.foot { height: 28px; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; border-top: 1px solid var(--admin-line); flex: none; font: 400 9px/1.2 var(--op77-font-mono); text-transform: uppercase; color: var(--admin-muted); }
.foot b { color: var(--admin-accent); margin-right: 3px; }
.input-panel { padding: 22px; pointer-events: auto; animation: admin-enter 220ms var(--admin-ease); max-height: calc(68vh - 32px); overflow-y: auto; }
.eyebrow { color: var(--admin-accent); font: 600 10px/1.4 var(--op77-font-mono); letter-spacing: .14em; }
.input-panel h1 { margin: 12px 0 20px; font: 800 23px/1.1 var(--op77-font-display); text-transform: uppercase; overflow-wrap: anywhere; }
.input-panel label { display: block; margin-bottom: 8px; font: 600 10px/1.4 var(--op77-font-mono); letter-spacing: .14em; text-transform: uppercase; }
.input-panel textarea { width: 100%; resize: none; border: 1px solid var(--admin-line); border-radius: 0; background: #080b10; color: var(--admin-text); padding: 10px; font: 400 15px/1.4 var(--op77-font-body); user-select: text; }
.input-panel p { font-size: 12px; line-height: 1.4; color: var(--admin-muted); margin: 8px 0; }
#input-error { color: var(--admin-danger); }
.input-actions { display: flex; gap: 8px; margin-top: 18px; }
.input-actions button { flex: 1; min-width: 0; padding: 10px 4px; background: transparent; border: 1px solid var(--admin-line); color: var(--admin-text); border-radius: 0; font: 600 10px/1.4 var(--op77-font-mono); text-transform: uppercase; cursor: pointer; transition: background 90ms var(--admin-ease); }
.input-actions button[type=submit] { background: var(--admin-accent); border-color: var(--admin-accent); color: #0b0e14; }
.input-actions button:hover { background: rgba(34,216,226,.18); color: var(--admin-text); }
.input-actions button:active { transform: translateY(1px); }
:focus-visible { outline: 2px solid var(--admin-accent); outline-offset: 2px; }
.announcement { position: fixed; top: 90px; left: 50%; transform: translateX(-50%); width: min(550px,calc(100vw - 64px)); padding: 18px 24px; background: var(--admin-panel); border: 1px solid var(--admin-line); border-bottom: 2px solid var(--admin-accent); clip-path: polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px)); }
.announcement p { margin: 10px 0 0; font-size: 18px; line-height: 1.4; overflow-wrap: anywhere; }
@keyframes admin-enter { from { opacity: 0; margin-top: 12px; } to { opacity: 1; margin-top: 0; } }
@media (max-height: 600px) { .strip, .input-panel { top: 16px; } .strip { max-height: calc(100vh - 144px); } .input-panel { max-height: calc(100vh - 32px); } }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Open77 Admin Menu</title>
<!-- The token file first, always. Never edit the copy in this folder: it is
     mirrored byte-for-byte into every resource that owns a WebUI surface, and
     `Get-FileHash resources\*\web\open77-ui.css` returning one unique hash is
     the whole verification. -->
<link rel="stylesheet" href="open77-ui.css">
<link rel="stylesheet" href="menu.css">
</head>
<body>

<!-- Lua owns navigation. Only the explicit text form captures input. -->
<div class="strip" id="strip">

  <header class="head">
    <img class="mark" src="logo.png" alt="Open77">
    <span class="title" id="title">ADMIN</span>
  </header>

  <div class="session"><span>// SERVER ADMIN</span><span id="roles"></span></div>
  <p class="trail" id="trail"></p>

  <ul class="list" id="list" role="listbox" aria-label="Admin actions"></ul>

  <p class="more" id="more"></p>
  <p class="detail" id="detail"></p>

  <p class="status" id="status"></p>

  <footer class="foot">
    <span><b>&#8593;&#8595;</b> move</span>
    <span><b>&#9166;</b> select</span>
    <span><b>&#8592;&#8594;</b> value</span>
    <span><b>&#9003;</b> back</span>
  </footer>

</div>

<section class="input-panel" id="input-panel" role="dialog" aria-modal="true" aria-labelledby="input-title" hidden>
  <span class="eyebrow">// CONFIRM DETAILS</span>
  <h1 id="input-title"></h1>
  <form id="input-form">
    <label for="input-value" id="input-label">Reason</label>
    <textarea id="input-value" rows="3" maxlength="256" required aria-describedby="input-hint input-error" spellcheck="false"></textarea>
    <p id="input-hint"></p><p id="input-error" role="alert"></p>
    <div class="input-actions"><button type="button" id="input-cancel">Cancel Â· Esc</button><button type="submit">Continue Â· Enter</button></div>
  </form>
</section>
<aside id="announcement" class="announcement" role="status" hidden>
  <span class="eyebrow" id="announcement-title">// SERVER ANNOUNCEMENT</span><p id="announcement-text"></p>
</aside>
<aside id="noclip-hud" class="noclip-hud" hidden aria-label="Noclip controls">
  <header><span>// ADMIN FLIGHT</span><span id="noclip-mode">NOCLIP</span></header>
  <div class="noclip-speed"><strong id="noclip-speed">60</strong><span>m/s</span><small id="noclip-base"></small></div>
  <div class="noclip-controls"><span><b>WHEEL</b> speed</span><span><b>SHIFT</b> boost</span><span><b>ALT</b> precision</span></div>
  <div class="noclip-controls"><span><b>SPACE / CTRL</b> up / down</span><span>Move with your usual keys</span></div>
</aside>
<script src="menu.js"></script>
</body>
</html>
/* Compact menu renderer. Lua owns navigation, action targets and confirmations.
 * This page emits readiness, viewport size, diagnostics and nonce-bound text only.
 * Free-text forms capture input temporarily; the ordinary list remains a HUD.
 */
(function () {
  "use strict";

  /* ----------------------------------------------------- failure reporting */
  //
  // Same reasoning as web/app.js, and it applies more here, not less: CEF
  // console output is forwarded through the webhost's `Trace`, which does not
  // reach `red4ext/logs/open77-*.log`, and the WebUI bridge swallows every
  // exception thrown inside an `Open77.on` handler. Without this, a page that
  // dies half way through renders nothing and says nothing, while Lua sees a
  // healthy surface with its handlers registered and its messages accepted.
  var reportCount = 0;
  var reporting = false;

  function describe(value) {
    try {
      if (value instanceof Error) {
        return (value.name || "Error") + ": " + value.message;
      }
      if (value === null || value === undefined) return String(value);
      if (typeof value === "object") return Object.prototype.toString.call(value);
      return String(value);
    } catch (ignored) { return "<undescribable>"; }
  }

  function report(text) {
    if (reporting || reportCount >= 20) return;
    reporting = true;
    reportCount += 1;
    try {
      window.Open77.emit("menu:diag", { text: String(text).slice(0, 400) });
    } catch (ignored) { /* nowhere left to complain to */ }
    reporting = false;
  }

  window.addEventListener("error", function (event) {
    report("uncaught " + (event.message || "?") + " at line " + (event.lineno || 0));
  });
  (function (original) {
    console.error = function () {
      report(Array.prototype.map.call(arguments, describe).join(" "));
      try { original.apply(console, arguments); } catch (ignored) { /* no console */ }
    };
  })(console.error);

  // Lua cannot tell an empty array from an empty map, so a resource that sends
  // a list with nothing in it arrives here as `{}`, not `[]`. `{}` is truthy,
  // so the usual `value || []` guard KEEPS the object: `.length` then reads
  // `undefined` and `.forEach` throws, aborting the whole render. Every list
  // crossing the bridge goes through here. (`web/app.js` carries the same
  // helper for the same reason; this page cannot share it, each surface loads
  // only its own files.)
  function list(value) { return Array.isArray(value) ? value : []; }

  function text(value) { return value === null || value === undefined ? "" : String(value); }

  var elements = {
    title: document.getElementById("title"),
    trail: document.getElementById("trail"),
    list: document.getElementById("list"),
    more: document.getElementById("more"),
    status: document.getElementById("status"),
    roles: document.getElementById("roles"),
    detail: document.getElementById("detail")
  };

  /* Rows are rebuilt rather than diffed. Nine <li> elements at a keypress is
     nothing, and a diff would need a stable key per row that Lua does not
     send -- the same label can appear in two frames meaning two things. */
  function render(payload) {
    payload = payload || {};
    var rows = list(payload.rows);

    elements.title.textContent = text(payload.title) || "ADMIN";
    elements.roles.textContent = text(payload.roles) || "Direct grants";
    elements.detail.textContent = text(payload.detail);
    elements.trail.textContent = text(payload.trail).toUpperCase().split("/").join(" / ");

    var fragment = document.createDocumentFragment();
    for (var index = 0; index < rows.length; index += 1) {
      var row = rows[index] || {};
      var item = document.createElement("li");
      item.className = row.on ? "row on" : "row";
      if (row.disabled) item.classList.add("disabled");
      item.setAttribute("role", "option");
      item.setAttribute("aria-selected", String(!!row.on));
      item.setAttribute("aria-disabled", String(!!row.disabled));

      var label = document.createElement("span");
      label.className = "label";
      label.textContent = text(row.label);
      item.appendChild(label);

      if (row.value !== undefined && row.value !== null && text(row.value) !== "") {
        var value = document.createElement("span");
        value.className = "value";
        value.textContent = text(row.value);
        item.appendChild(value);
      }

      var arrow = document.createElement("span");
      arrow.className = "arrow";
      // The `>` affordance appears on submenu rows and on nothing else, but the
      // element is always present so every label starts at the same x. A menu
      // whose text shifts sideways as the selection moves is unreadable while
      // the player is also moving.
      arrow.textContent = row.arrow ? ">" : "";
      item.appendChild(arrow);

      fragment.appendChild(item);
    }
    elements.list.textContent = "";
    elements.list.appendChild(fragment);

    var total = Number(payload.total) || 0;
    var first = Number(payload.first) || 1;
    var index2 = Number(payload.index) || 0;
    // Only when the window is actually hiding something. On a five-item menu
    // the counter is noise.
    // Escapes, not literal glyphs. The page is served from the resource's own
    // virtual origin and `<script src>` inherits the document charset, but a
    // stray non-UTF-8 read of this file would turn an arrow into mojibake in
    // the one place the operator looks to know the list continues.
    elements.more.textContent = total > rows.length
      ? index2 + " / " + total + (first > 1 ? "  \u2191" : "")
        + (first + rows.length - 1 < total ? "  \u2193" : "")
      : "";

    elements.status.textContent = text(payload.status);
    elements.status.className = payload.ok === false ? "status bad" : "status";

    document.body.classList.add("open");
  }

  function hide() {
    document.body.classList.remove("open");
    closeInput();
  }

  // Send a value plus a Lua-owned nonce, never a command or target.
  var inputId = null;
  var inputMaxBytes = 256;
  var inputPanel = document.getElementById("input-panel");
  var inputValue = document.getElementById("input-value");
  var inputForm = document.getElementById("input-form");
  function closeInput() {
    inputId = null;
    inputPanel.hidden = true;
    inputValue.value = "";
    document.body.classList.remove("typing");
  }
  function cancelInput() { Open77.emit("menu:input:cancel", { id: inputId }); }
  inputForm.addEventListener("submit", function (event) {
    event.preventDefault();
    if (inputId === null) return;
    var value = inputValue.value.trim();
    if (!value || new TextEncoder().encode(value).length > inputMaxBytes) {
      document.getElementById("input-error").textContent = "Enter 1â€“" + inputMaxBytes + " UTF-8 bytes.";
      return;
    }
    Open77.emit("menu:input:submit", { id: inputId, value: value });
  });
  document.getElementById("input-cancel").addEventListener("click", cancelInput);
  inputValue.addEventListener("keydown", function (event) {
    if (event.key === "Enter" && !event.isComposing) {
      event.preventDefault();
      if (!event.repeat) inputForm.requestSubmit();
    }
  });
  document.addEventListener("keydown", function (event) {
    if (inputId === null) return;
    if (event.key === "Escape") { event.preventDefault(); cancelInput(); }
    if (event.key === "Tab") {
      var controls = [inputValue, document.getElementById("input-cancel"), inputForm.querySelector("button[type=submit]")];
      var at = controls.indexOf(document.activeElement);
      event.preventDefault();
      controls[(at + (event.shiftKey ? 2 : 1)) % controls.length].focus();
    }
  });
  Open77.on("menu:input", function (payload) {
    inputId = payload.id;
    inputMaxBytes = Math.max(1, Math.min(256, Number(payload.maxBytes) || 256));
    inputValue.maxLength = inputMaxBytes;
    document.getElementById("input-title").textContent = text(payload.title);
    document.getElementById("input-label").textContent = text(payload.label);
    document.getElementById("input-hint").textContent = text(payload.hint);
    document.getElementById("input-error").textContent = "";
    inputValue.value = "";
    inputPanel.hidden = false;
    document.body.classList.add("typing");
    inputValue.focus();
  });
  Open77.on("menu:input:close", closeInput);
  Open77.on("menu:input:error", function (payload) {
    document.getElementById("input-error").textContent = text(payload.message);
  });
  Open77.on("menu:noclip", function (payload) {
    var hud = document.getElementById("noclip-hud");
    hud.hidden = !payload.active;
    if (hud.hidden) return;
    var speed = Number(payload.effective) || 0;
    document.getElementById("noclip-speed").textContent = speed.toFixed(speed < 1 ? 2 : speed < 10 ? 1 : 0);
    document.getElementById("noclip-mode").textContent = payload.paused ? "INPUT PAUSED" : payload.slow ? "PRECISION" : payload.boost ? "BOOST" : "NOCLIP";
    document.getElementById("noclip-base").textContent = payload.boost || payload.slow ? "BASE " + Number(payload.speed).toFixed(1) : "";
    hud.classList.toggle("paused", !!payload.paused);
  });
  var announcementTimer;
  Open77.on("menu:announcement", function (payload) {
    clearTimeout(announcementTimer);
    document.getElementById("announcement-title").textContent = "// " + (text(payload.title) || "SERVER ANNOUNCEMENT");
    document.getElementById("announcement-text").textContent = text(payload.text);
    document.getElementById("announcement").hidden = false;
    announcementTimer = setTimeout(function () { document.getElementById("announcement").hidden = true; }, 10000);
  });
  function viewport() {
    var available = innerHeight - (innerHeight <= 600 ? 16 : innerHeight * .32) - 128;
    Open77.emit("menu:viewport", { rows: Math.max(3, Math.min(12, Math.floor((available - 210) / 30))) });
  }
  window.addEventListener("resize", viewport);

  Open77.on("menu:frame", function (payload) {
    try { render(payload); } catch (error) { report("render: " + describe(error)); }
  });

  Open77.on("menu:hide", function () {
    try { hide(); } catch (error) { report("hide: " + describe(error)); }
  });

  // `menu:ready` MUST be emitted whatever happened above: Lua drops every
  // message until the page has reported ready, so a throw before this point
  // would cost the menu every frame it is ever sent.
  try { Open77.ready(); } catch (error) { report("ready: " + describe(error)); }
  Open77.emit("menu:ready", {});
  viewport();
})();
/* =============================================================================
   OPEN//77 - in-game UI design tokens
   =============================================================================

   MIRRORED FILE. Every in-game WebUI resource ships a byte-identical copy at
   `<resource>/web/open77-ui.css`. Do not edit one copy: edit them all, then
   verify they still match (the one-line check is in `docs/ui-design-system.md`).

   Why a copy and not a shared file: each resource's WebUI runs under its own
   isolated virtual origin and can only load files declared in its own manifest,
   so `resources/A/web/index.html` cannot reference a stylesheet that lives in
   `resources/B/web/`. There is no shared origin to put one file on. The same
   reasoning is already recorded in the token blocks of `open77_pause` and
   `open77_debug`; this file replaces those twelve divergent blocks with twelve
   identical ones.

   Source of truth: the OPEN//77 website design system -
   `app/references/design-system.md` (the "OPEN SIGNAL" addendum, which the
   document itself marks as superseding its section 1) and
   `app/src/styles/legacy/01-tokens.css`. Values below are those values.
   Deviations are marked `IN-GAME:` and each carries its reason.
   ========================================================================== */

:root {
  /* --- FIELD ---------------------------------------------------------------
     The night. Never pure black: on the site because black reads as a void,
     in-game because a black panel over a night street disappears. */
  --op77-void:       #060a12;
  --op77-bg:         #080e19;
  --op77-bg-elev:    #0d1624;
  --op77-surface:    #101b2b;
  --op77-surface-2:  #132032;

  /* IN-GAME: panel fills drawn over live gameplay.
     The site can use flat opaque surfaces because nothing moves behind them.
     A HUD panel sits over a scene that swings from a blown-out white plaza to a
     black alley, so its backing must stay opaque enough to hold text at either
     extreme. 0.94 is the floor for anything carrying words; use --op77-panel
     for read-me-now surfaces and --op77-panel-quiet only for decoration. */
  --op77-panel:        rgba(10, 18, 32, 0.94);
  --op77-panel-raised: rgba(16, 27, 43, 0.96);
  --op77-panel-quiet:  rgba(10, 18, 32, 0.78);
  --op77-scrim:        rgba(3, 7, 13, 0.72);

  /* --- LINES ---------------------------------------------------------------
     Blue-gray hairlines, never cyan. Depth comes from borders, not shadows. */
  --op77-line:        rgba(174, 211, 224, 0.10);
  --op77-line-strong: rgba(174, 211, 224, 0.19);
  /* IN-GAME: a 10%-alpha hairline vanishes against a bright frame. Panel
     outlines that must survive any backdrop use --op77-line-hud. */
  --op77-line-hud:    rgba(174, 211, 224, 0.30);

  /* --- INK -----------------------------------------------------------------
     Contrast measured against --op77-surface #101b2b:
       text       16.2:1   body and headings, any size
       text-dim    6.2:1   secondary copy, passes AA at any size
       text-faint  3.6:1   decoration and disabled only - never body copy */
  --op77-text:       #f2f6f8;
  --op77-text-dim:   #8d99a8;
  --op77-text-faint: rgba(141, 153, 168, 0.72);
  --op77-ink:        #071013;  /* text ON an accent fill - never white */

  /* --- SIGNAL --------------------------------------------------------------
     One chromatic family with depth. Cyan = platform / active / connected.
     Coral = live / full / featured / new - semantic only, never a CTA.
     Budget: if a viewport shows more than ~3 cyan elements, remove some. */
  --op77-accent:       #22d8e2;   /* OPEN Electric - CTAs, links, active state */
  --op77-accent-ice:   #70f3f5;   /* OPEN Ice - brand mark and hover peaks     */
  --op77-accent-deep:  #18c8d4;   /* OPEN Deep - second signal channel         */
  --op77-accent-soft:  rgba(34, 216, 226, 0.12);
  --op77-accent-line:  rgba(34, 216, 226, 0.45);
  --op77-signal:       #ff5964;   /* coral - live / full / featured / new      */
  --op77-danger:       #ff5c5c;   /* errors, destructive, offline              */

  /* IN-GAME: the site has no success or warning role because a marketing page
     never has to say "spawned" or "connection degraded". A HUD does. These two
     are the only colours here with no website counterpart; they are tuned to
     sit in the same cold family rather than borrowing the game's own palette. */
  --op77-ok:   #4fe3a9;
  --op77-warn: #f5c95c;

  /* Reserved for live things only - status dots, a running counter, an active
     nav state. Never on static decoration. */
  --op77-glow: 0 0 24px rgba(34, 216, 226, 0.25);

  /* --- TYPE ----------------------------------------------------------------
     The website self-hosts Rajdhani / Saira / IBM Plex Mono through next/font.
     In-game there is no network and no font is bundled with any resource, so
     those three names NEVER resolve and every surface silently fell back to
     whatever came next in its stack - which is why the twelve surfaces do not
     look related today. They are kept first in each stack so that bundling a
     webfont later takes over with no edit here.

     What actually renders is the second name in each stack, chosen to carry the
     same voice from fonts Windows ships:
       display  Bahnschrift Condensed  - DIN-derived, squared terminals, the
                                         closest shipping face to Rajdhani
       body     Bahnschrift            - same family, normal width
       mono     Cascadia Mono          - the micro-label and data voice */
  --op77-font-display: "Rajdhani", "Bahnschrift Condensed", "Bahnschrift SemiCondensed", "Arial Narrow", "Segoe UI", sans-serif;
  --op77-font-body:    "Saira", "Bahnschrift", "Segoe UI", system-ui, sans-serif;
  --op77-font-mono:    "IBM Plex Mono", "Cascadia Mono", "Consolas", ui-monospace, monospace;

  /* HUD type scale. Larger than the website's page scale on purpose: this text
     is read at arm's length over a moving image, not on a document. */
  --op77-fs-micro:  9px;    /* mono eyebrow, letter-spacing .18em, UPPERCASE  */
  --op77-fs-label:  10px;   /* mono labels, keycaps                          */
  --op77-fs-meta:   11px;   /* mono data, secondary lines                    */
  --op77-fs-body:   14px;   /* the default                                   */
  --op77-fs-lead:   16px;   /* the one line that must be read first          */
  --op77-fs-title:  18px;   /* card and toast titles                         */
  --op77-fs-head:   26px;   /* panel headings                                */
  --op77-fs-hero:   40px;   /* countdowns, verdicts                          */

  --op77-track-micro: 0.18em;  /* mono eyebrows */
  --op77-track-label: 0.12em;  /* mono labels   */
  --op77-track-head:  0.02em;  /* display heads */

  /* --- SPACE ---------------------------------------------------------------
     Base-4. Density lives inside panels, not between them. */
  --op77-space-1: 4px;
  --op77-space-2: 8px;
  --op77-space-3: 12px;
  --op77-space-4: 16px;
  --op77-space-5: 24px;
  --op77-space-6: 32px;
  --op77-space-7: 48px;
  --op77-space-8: 64px;

  /* IN-GAME: distance from the viewport edge for every HUD surface, so the
     twelve of them line up instead of each picking its own vh/vw. */
  --op77-inset-x: 32px;
  --op77-inset-y: 28px;

  /* --- SHAPE ---------------------------------------------------------------
     Square-leaning. 6px is the maximum radius anywhere in the system. */
  --op77-radius-sm: 2px;
  --op77-radius-md: 6px;
  --op77-notch: 12px;
  --op77-notch-clip: polygon(0 0, calc(100% - var(--op77-notch)) 0, 100% var(--op77-notch), 100% 100%, 0 100%);
  /* Accent rule down the leading edge of a panel - the house marker for
     "this belongs to Open77". 3px; 2px on small items. */
  --op77-rule: 3px;

  /* IN-GAME: the site forbids shadows for elevation and it is right - on a flat
     page a border is enough. Over gameplay a border alone does not separate a
     panel from a detailed backdrop, so one shadow is allowed, and only this
     one. It is a separation device, not a depth ramp: there are no levels. */
  --op77-shadow: 0 8px 28px rgba(0, 0, 0, 0.55);

  /* --- MOTION --------------------------------------------------------------
     Functional and fast. No glitch loops, no parallax, no idle animation. */
  --op77-ease: cubic-bezier(0.2, 0, 0, 1);
  --op77-dur-fast: 90ms;    /* colour and border changes  */
  --op77-dur:      150ms;   /* enter, leave, hover        */
  --op77-dur-slow: 220ms;   /* a whole panel sliding in   */
}

/* The `//` device. Where it appears, nothing else glows.
   Use as: <span class="op77-eyebrow">Session</span> */
.op77-eyebrow {
  font: 700 var(--op77-fs-micro) / 1 var(--op77-font-mono);
  letter-spacing: var(--op77-track-micro);
  text-transform: uppercase;
  color: var(--op77-text-dim);
}
.op77-eyebrow::before {
  content: "//";
  margin-right: 0.7em;
  color: var(--op77-accent);
  font-weight: 900;
  letter-spacing: -0.06em;
}

/* Animation enhances, it never gates: nothing here starts at opacity 0 without
   a paired end state, and all of it is off when the player asked for less. */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 1ms !important;
    animation-delay: 0ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 1ms !important;
    transition-delay: 0ms !important;
    scroll-behavior: auto !important;
  }
}
